   "name": "Anatomy",
   "body": "```tsx\nimport { Card } from \"@heroui/react\";\n\nexport default () => (\n  <Card>\n    <Card.Header>\n      <Card.Title />\n      <Card.Description />\n    </Card.Header>\n    <Card.Content />\n    <Card.Footer />\n  </Card>\n);\n```",
