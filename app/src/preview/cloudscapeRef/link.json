     [
      "variant",
      "LinkProps.Variant",
      "아니오",
      "Determines the visual style of the link as follows: - `primary` - Displays the link text with an underline for sufficient contrast with surrounding text. Use this for links adjacent to other text, such as inside a paragraph, a \"Learn more\" link, an item ID in a table, a link in a key-value pair, or a link in an alert. - `secondary` - Uses regular font weight without additional interactivity indicators (except for an underline on hover). Use this where context implies interactivity and users can identify links easily, such as in a list of links inside a container. - `info` - Use for \"info\" links that link to content in a help panel. The default is `secondary`, except inside the following components where it defaults to `primary`: - Table - Cards - Alert - Popover - Help Panel (main `content` only)",
      "src/link/interfaces.ts:36"
     ],
     [
      "fontSize",
      "LinkProps.FontSize",
      "아니오",
      "Determines the font size and line height. This property is overridden if the variant is `info`.",
      "src/link/interfaces.ts:42"
     ],
     [
      "color",
      "LinkProps.Color",
      "아니오",
      "Determines the text color of the link and its icon. - `normal`: Use in most cases where a link is required. - `inverted`: Use to style links inside Flashbars. This property is overridden if the variant is `info`.",
      "src/link/interfaces.ts:52"
     ],
     [
      "external",
      "boolean",
      "아니오",
      "Marks the link as external by adding an icon after the text. If `href` is provided, opens the link in a new tab when clicked.",
      "src/link/interfaces.ts:58"
     ],
     [
      "target",
      "string",
      "아니오",
      "Specifies where to open the linked URL. Set this to `_blank` to open the URL in a new tab. If you set this property to `_blank`, the component automatically adds `rel=\"noopener noreferrer\"` to avoid performance and security issues. For other options see the documentation for <a> tag's [target attribute](https://developer.mozilla.org/en-US/docs/Web/HTML/Element/a#target).",
      "src/link/interfaces.ts:69"
     ],
     [
      "href",
      "string",
      "아니오",
      "The URL that the link points to. If an `href` is not provided, the component will render using a \"button\" role and `target` will not be used.",
      "src/link/interfaces.ts:76"
     ],
     [
      "children",
      "React.ReactNode",
      "아니오",
      "The text to render inside the link.",
      "src/link/interfaces.ts:81"
     ],
     [
      "ariaLabel",
      "string",
      "아니오",
      "Adds an aria-label to the HTML element.",
      "src/link/interfaces.ts:86"
     ],
     [
      "externalIconAriaLabel",
      "string",
      "아니오",
      "Adds an aria-label to the external icon. @i18n",
      "src/link/interfaces.ts:92"
     ],
     [
      "onFollow",
      "CancelableEventHandler<LinkProps.FollowDetail>",
      "아니오",
      "Called when a link is clicked without any modifier keys. If the link has no `href` provided, it will be called on all clicks. If you want to implement client-side routing yourself, use this event and prevent default browser navigation (by calling `preventDefault`).",
      "src/link/interfaces.ts:101"
     ],
     [
      "onClick",
      "NonCancelableEventHandler<LinkProps.ClickDetail>",
      "아니오",
      "Called when the user clicks on the link. Do not use this handler for navigation, use the `onFollow` event instead.",
      "src/link/interfaces.ts:106"
     ],
     [
      "rel",
      "string",
      "아니오",
      "Adds a `rel` attribute to the link. If the `rel` property is provided, it overrides the default behaviour. By default, the component sets the `rel` attribute to \"noopener noreferrer\" when `external` is `true` or `target` is `\"_blank\"`.",
      "src/link/interfaces.ts:112"
     ],
