  "prose": [
    {
      "title": "Example",
      "text": "Place one add-on or button on either side of an input. You may also\nplace one on both sides of an input. Remember to place\n`<label>`s outside the input group.",
      "format": "md"
    },
    {
      "title": "Sizing",
      "text": "Add the relative form sizing classes to the `InputGroup` and\ncontents within will automatically resize—no need for repeating the form\ncontrol size classes on each element.",
      "format": "md"
    },
    {
      "title": "Checkboxes and radios",
      "text": "Use the `InputGroup.Radio` or\n`InputGroup.Checkbox` to add options to an input group.",
      "format": "md"
    },
    {
      "title": "Multiple inputs",
      "text": "While multiple inputs are supported visually, validation styles are only\navailable for input groups with a single input.",
      "format": "md"
    },
    {
      "title": "Multiple addons",
      "text": "Multiple add-ons are supported and can be mixed with checkbox and radio\ninput versions.",
      "format": "md"
    }
  ],
