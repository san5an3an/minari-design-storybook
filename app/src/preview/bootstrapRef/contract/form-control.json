  "prose": [
    {
      "title": "Example",
      "text": "For textual form controls—like `input`s and `textarea`s—use the `FormControl` component.\nFormControl adds some additional styles for general appearance, focus\nstate, sizing, and more.",
      "format": "md"
    },
    {
      "title": "Sizing",
      "text": "Use `size` on `<FormControl>` to change the size of the input.",
      "format": "md"
    },
    {
      "title": "Disabled",
      "text": "Add the `disabled` prop on an input to give it a grayed out appearance and remove pointer events.",
      "format": "md"
    },
    {
      "title": "Readonly",
      "text": "Add the `readOnly` prop on an input to prevent modification\nof the input's value. Read-only inputs appear lighter (just like\ndisabled inputs), but retain the standard cursor.",
      "format": "md"
    },
    {
      "title": "Readonly plain text",
      "text": "If you want to have readonly elements in your form styled as plain text,\nuse the `plaintext` prop on FormControls to remove the\ndefault form field styling and preserve the correct margin and padding.",
      "format": "md"
    }
  ],
