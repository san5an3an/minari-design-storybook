  "prose": [
    {
      "title": "Example",
      "text": "Use the `striped`, `bordered` and `hover` props to customise the table.",
      "format": "md"
    },
    {
      "title": "Small Table",
      "text": "Use `size=\"sm\"` to make tables compact by cutting cell padding in half.",
      "format": "md"
    },
    {
      "title": "Dark Table",
      "text": "Use `variant=\"dark\"` to invert the colors of the table and get light text\non a dark background.",
      "format": "md"
    },
    {
      "title": "Striped rows",
      "text": "Use `striped` to add zebra-striping to any table row within the table.",
      "format": "md"
    },
    {
      "title": "Striped columns",
      "text": "Use `striped=\"columns\"` to add zebra-striping to any table column.",
      "format": "md"
    },
    {
      "title": "Responsive",
      "text": "Responsive tables allow tables to be scrolled horizontally with ease.\n\nAcross every breakpoint, use `responsive` for horizontally scrolling tables.\nResponsive tables are wrapped automatically in a `div`. The following example\nhas 12 columns that are scrollable horizontally.\n\nUse `responsive=\"sm\"`, `responsive=\"md\"`, `responsive=\"lg\"`, or `responsive=\"xl\"`\nas needed to create responsive tables up to a particular breakpoint. From that\nbreakpoint and up, the table will behave normally and not scroll horizontally.",
      "format": "md"
    }
  ],
