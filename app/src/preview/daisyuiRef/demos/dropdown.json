    "023": {
      "html": "<div class=\"d-navbar bg-base-200\">\n  <div class=\"ps-4\">\n    <a class=\"text-lg font-bold\">daisyUI</a>\n  </div>\n  <div class=\"flex grow justify-end px-2\">\n    <div class=\"flex items-stretch\">\n      <a class=\"d-btn d-btn-ghost rounded-field\">Button</a>\n      <div class=\"d-dropdown d-dropdown-end\">\n        <div tabindex=\"0\" role=\"button\" class=\"d-btn d-btn-ghost rounded-field\">Dropdown</div>\n        <ul\n          tabindex=\"-1\"\n          class=\"d-menu d-dropdown-content bg-base-200 rounded-box z-1 mt-4 w-52 p-2 shadow-sm\">\n          <li><a>Item 1</a></li>\n          <li><a>Item 2</a></li>\n        </ul>\n      </div>\n    </div>\n  </div>\n</div>"
    },
    "024": {
      "html": "<div class=\"d-dropdown d-dropdown-end\">\n  <div tabindex=\"0\" role=\"button\" class=\"d-btn d-btn-circle d-btn-ghost d-btn-xs text-info\">\n    <svg\n      tabindex=\"0\"\n      aria-label=\"More info\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      fill=\"none\"\n      viewBox=\"0 0 24 24\"\n      class=\"h-4 w-4 stroke-current\">\n      <path\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        stroke-width=\"2\"\n        d=\"M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n    </svg>\n  </div>\n  <div\n    tabindex=\"0\"\n    class=\"d-card d-card-sm d-dropdown-content bg-base-100 rounded-box z-1 w-64 shadow-sm\">\n    <div tabindex=\"0\" class=\"d-card-body\">\n      <h2 class=\"d-card-title\">You needed more info?</h2>\n      <p>Here is a description!</p>\n    </div>\n  </div>\n</div>"
