{
  "demos": {
    "001": {
      "html": "<input class=\"d-input d-validator\" type=\"email\" required placeholder=\"mail@site.com\" />"
    },
    "002": {
      "html": "<input class=\"d-input d-validator\" type=\"email\" required placeholder=\"mail@site.com\" />\n<div class=\"d-validator-hint\">Enter valid email address</div>"
    },
    "003": {
      "html": "<input type=\"password\" class=\"d-input d-validator\" required placeholder=\"Password\" minlength=\"8\" \n  pattern=\"(?=.*\\\\d)(?=.*[a-z])(?=.*[A-Z]).{8,}\" \n  title=\"Must be more than 8 characters, including number, lowercase letter, uppercase letter\" />\n<p class=\"d-validator-hint\">\n  Must be more than 8 characters, including\n  <br/>At least one number\n  <br/>At least one lowercase letter\n  <br/>At least one uppercase letter\n</p>"
    },
    "004": {
      "html": "<input type=\"text\" class=\"d-input d-validator\" required placeholder=\"Username\" \n  pattern=\"[A-Za-z][A-Za-z0-9\\\\-]*\" minlength=\"3\" maxlength=\"30\" title=\"Only letters, numbers or dash\" />\n<p class=\"d-validator-hint\">\n  Must be 3 to 30 characters\n  <br/>containing only letters, numbers or dash\n</p>"
    },
    "005": {
      "html": "<input type=\"tel\" class=\"d-input d-validator tabular-nums\" required placeholder=\"Phone\" \n  pattern=\"[0-9]*\" minlength=\"10\" maxlength=\"10\" title=\"Must be 10 digits\" />\n<p class=\"d-validator-hint\">Must be 10 digits</p>"
    },
    "006": {
      "html": "<input type=\"url\" class=\"d-input d-validator\" required placeholder=\"https://\" value=\"https://\"\n  pattern=\"^(https?://)?([a-zA-Z0-9]([a-zA-Z0-9\\-].*[a-zA-Z0-9])?\\.)+[a-zA-Z].*$\" \n  title=\"Must be valid URL\" />\n<p class=\"d-validator-hint\">Must be valid URL</p>"
    },
    "007": {
      "html": "<input type=\"date\" class=\"d-input d-validator\" required placeholder=\"Pick a date in 2025\" \nmin=\"2025-01-01\" max=\"2025-12-31\"\n  title=\"Must be valid URL\" />\n<p class=\"d-validator-hint\">Must be 2025</p>"
    },
    "008": {
      "html": "<input type=\"number\" class=\"d-input d-validator\" required placeholder=\"Type a number between 1 to 10\" \nmin=\"1\" max=\"10\"\n  title=\"Must be between be 1 to 10\" />\n<p class=\"d-validator-hint\">Must be between be 1 to 10</p>"
    },
    "009": {
      "html": "<input type=\"checkbox\" class=\"d-checkbox d-validator\" required title=\"Required\" />\n<p class=\"d-validator-hint\">Required</p>"
    },
    "010": {
      "html": "<input type=\"checkbox\" class=\"d-toggle d-validator\" required title=\"Required\" />\n<p class=\"d-validator-hint\">Required</p>"
    },
    "011": {
      "html": "<form>\n  <select class=\"d-select d-validator\" required>\n    <option disabled selected value=\"\">Choose:</option>\n    <option>Tabs</option>\n    <option>Spaces</option>\n  </select>\n  <p class=\"d-validator-hint\">Required</p>\n  <button class=\"d-btn\" type=\"submit\">Submit form</button>\n</form>"
    },
    "012": {
      "html": "<form class=\"d-fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4\">\n  <fieldset class=\"d-fieldset\">\n    <label class=\"d-label\">Email</label>\n    <input type=\"email\" class=\"d-input d-validator\" placeholder=\"Email\" required />\n    <p class=\"d-validator-hint hidden\">Required</p>\n  </fieldset>\n\n  <label class=\"d-fieldset\">\n    <span class=\"d-label\">Password</span>\n    <input type=\"password\" class=\"d-input d-validator\" placeholder=\"Password\" required />\n    <span class=\"d-validator-hint hidden\">Required</span>\n  </label>\n\n  <button class=\"d-btn d-btn-neutral mt-4\" type=\"submit\">Login</button>\n  <button class=\"d-btn d-btn-ghost mt-1\" type=\"reset\">Reset</button>\n</form>"
    }
  },
