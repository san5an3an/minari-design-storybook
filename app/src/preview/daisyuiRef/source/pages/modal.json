      "title": "Dialog modal",
      "line": 67,
      "axis": "Method 1. HTML dialog element `recommended`",
      "description": "opens on click using ID.showModal() method. can be closed using ID.close() method",
      "descriptionLine": 68,
      "liveHtml": "<button class=\"btn\" onclick={() => my_modal_1.showModal()}>open modal</button>\n<dialog id=\"my_modal_1\" class=\"modal\">\n  <div class=\"modal-box\">\n    <h3 class=\"font-bold text-lg\">Hello!</h3>\n    <p class=\"py-4\">Press ESC key or click the button below to close</p>\n    <div class=\"modal-action\">\n      <form method=\"dialog\">\n        <!-- if there is a button in form, it will close the modal -->\n        <button class=\"btn\">Close</button>\n      </form>\n    </div>\n  </div>\n</dialog>",
      "html": {
        "lang": "html",
