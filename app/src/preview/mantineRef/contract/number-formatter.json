  "prose": [
    {
      "title": "Usage",
      "text": "Use `NumberFormatter` to format numbers. It supports the same formatting related props\nas [NumberInput](/core/number-input/) component.",
      "format": "md"
    },
    {
      "title": "Prefix and suffix",
      "text": "Set `prefix` and `suffix` props to add given string to the start or end of the value:",
      "format": "md"
    },
    {
      "title": "Thousands separator",
      "text": "Set `thousandSeparator` prop to separate thousands with a character. You can control\ngrouping logic with `thousandsGroupStyle`, it accepts: `thousand`, `lakh`, `wan`, `none` values.",
      "format": "md"
    },
    {
      "title": "Decimal scale",
      "text": "`decimalScale` prop controls the number of allowed decimal places:",
      "format": "md"
    }
  ],
