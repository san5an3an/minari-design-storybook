  "prose": [
    {
      "title": "Usage",
      "text": "`Breadcrumbs` component accepts any number of React nodes as children\nand adds a given separator (defaults to `/`) between them:",
      "format": "md"
    }
  ],
  "parts": {
    "presence": "absent-in-official",
