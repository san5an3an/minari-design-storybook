  "prose": [
    {
      "title": "With icons",
      "text": "You can replace list bullets with icon. To do so provide following props:\n\n- `icon` on List component will be used as default icon for all list elements\n- `icon` on List.Item component will override context icon from List\n- `spacing` – spacing between list items from theme or any valid CSS value to set spacing, defaults to `0`\n- `center` – center item content with icon\n- `size` – set font size from theme",
      "format": "md"
    },
    {
      "title": "Nested lists",
      "text": "Set `withPadding` prop to offset nested lists and `listStyleType` to control bullet type:",
      "format": "md"
    }
  ],
