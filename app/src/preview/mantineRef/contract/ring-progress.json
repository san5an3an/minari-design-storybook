  "prose": [
    {
      "title": "Usage",
      "text": "Set `sections` prop to an array of:\n\n- `value` – number between 0 and 100 – amount of space filled by segment\n- `color` – segment color from theme or any other css color value",
      "format": "md"
    },
    {
      "title": "Size, thickness & rounded caps",
      "text": "Use `size`, `thickness` & `roundCaps` props to configure RingProgress, size and thickness values:",
      "format": "md"
    },
    {
      "title": "Sections tooltips",
      "text": "Add `tooltip` property to section to display floating [Tooltip](/core/tooltip/) when user hovers over it:",
      "format": "md"
    },
    {
      "title": "Root color",
      "text": "Use `rootColor` property to change the root color:",
      "format": "md"
    },
    {
      "title": "Sections props",
      "text": "You can add any additional props to sections:",
      "format": "md"
    },
    {
      "title": "Customize label",
      "text": "You can add any React node as label, e.g. [Text](/core/text/) component with some additional styles\nor [ThemeIcon](/core/theme-icon/):",
      "format": "md"
    },
    {
      "title": "Filled segment transition",
      "text": "By default, transitions are disabled, to enable them, set `transitionDuration` prop\nto a number of milliseconds:",
      "format": "md"
    }
  ],
