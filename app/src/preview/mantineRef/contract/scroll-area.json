 "prose": [
 {
 "title": "Usage",
 "text": "`ScrollArea` component supports the following props:\n\n- `type` defines scrollbars behavior:\n - `hover` – scrollbars are visible on hover\n - `scroll` – scrollbars are visible on scroll\n - `auto` – similar to `overflow: auto` – scrollbars are always visible when the content is overflowing\n - `always` – same as `auto`, but scrollbars are always visible regardless of whether the content is overflowing\n - `never` – scrollbars are always hidden\n- `offsetScrollbars` – adds padding to offset scrollbars with the following options:\n - `x` – adds padding to offset horizontal scrollbar only\n - `y` – adds padding to offset vertical scrollbar only\n - `xy` – adds padding to offset both scrollbars\n - `present` – adds padding only when scrollbars are visible\n- `scrollbarSize` – scrollbar size, controls scrollbar and thumb width/height\n- `scrollHideDelay` – delay in ms to hide scrollbars, applicable only when type is `hover` or `scroll`\n- `overscrollBehavior` – controls [overscroll-behavior](https://developer.mozilla.org/en-US/docs/Web/CSS/overscroll-behavior) of the viewport",
 "format": "md"
 },
 {
 "title": "Disable horizontal scrollbars",
 "text": "To disable horizontal scrollbars set `scrollbars=\"y\"` prop:",
 "format": "md"
 },
 {
 "title": "Subscribe to scroll position changes",
 "text": "Set `onScrollPositionChange` function to subscribe to scroll position changes,\nit will be called each time user scrolls with x and y coordinates:",
 "format": "md"
 },
 {
 "title": "Scroll to position",
 "text": "To programmatically scroll to any position,\nget viewport element ref with `viewportRef` prop and call `scrollTo` method:",
 "format": "md"
 },
 {
 "title": "ScrollArea.Autosize",
 "text": "`ScrollArea.Autosize` component allows to create scrollable containers when given max-height is reached:",
 "format": "md"
 }
 ],
