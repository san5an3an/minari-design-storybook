 "prose": [
 {
 "title": "Usage",
 "text": "`Container` centers content and limits its `max-width` to the value specified in `size` prop.\nNote that the `size` prop does not make `max-width` responsive, for example,\nwhen it set to `lg` it will always be `lg` regardless of screen size.",
 "format": "md"
 },
 {
 "title": "Fluid",
 "text": "Set `fluid` prop to make container fluid, it will take 100% of available width,\nit is the same as setting `size=\"100%\"`.",
 "format": "md"
 },
 {
 "title": "Customize sizes",
 "text": "You can customize existing `Container` sizes and add new ones with [CSS variables](/styles/styles-api)\non [theme](/theming/theme-object):",
 "format": "md"
 },
 {
 "title": "Responsive max-width",
 "text": "To make `Container` `max-width` responsive, use [Styles API](/styles/styles-api) to set\n`classNames`. For example, you can add `responsive` size that will make `Container`\n`max-width` different depending on screen size:",
 "format": "md"
 }
 ],
