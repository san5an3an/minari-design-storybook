 "prose": [
 {
 "title": "Change empty segment color",
 "text": "Use `emptySegmentColor` prop to change color of empty segment,\nit accepts key of `theme.colors` or any valid CSS color value:",
 "format": "md"
 },
 {
 "title": "Change label position",
 "text": "By default, the label is displayed at the bottom of the component,\nyou can change its position to `center` by using `labelPosition` prop:",
 "format": "md"
 },
 {
 "title": "Filled segment transition",
 "text": "By default, transitions are disabled, to enable them, set `transitionDuration` prop\nto a number of milliseconds:",
 "format": "md"
 }
 ],
