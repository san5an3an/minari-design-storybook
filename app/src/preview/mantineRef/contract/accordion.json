 "prose": [
 {
 "title": "Usage",
 "text": "Data used in Accordion examples:",
 "format": "md"
 },
 {
 "title": "Change transition",
 "text": "To change transition duration, set `transitionDuration` prop:\n\nTo disable transitions, set `transitionDuration` to 0:",
 "format": "md"
 },
 {
 "title": "Default opened items",
 "text": "When `multiple={false}`, set `defaultValue` as string:\n\nWhen `multiple={true}`, set `defaultValue` as an array of strings:",
 "format": "md"
 },
 {
 "title": "Control state",
 "text": "When `multiple={false}`, set `value` as string:\n\nWhen `multiple={true}`, set `value` as an array of strings:",
 "format": "md"
 },
 {
 "title": "Compose controls",
 "text": "You can add any additional elements that will be displayed next to `Accordion.Control`,\nfor example, you can add [ActionIcon](/core/action-icon/) or [Menu](/core/menu/):",
 "format": "md"
 },
 {
 "title": "Disabled items",
 "text": "Set `disabled` prop on `Accordion.Control` component to disable it.\nDisabled items cannot be activated with mouse or keyboard, will be skipped when user navigates with arrow keys:",
 "format": "md"
 },
 {
 "title": "Unstyled Accordion",
 "text": "Set `unstyled` prop on Accordion component to remove all non-essential library styles.\nIt can be used to style component with [Styles API](/styles/styles-api/) without overriding any styles.\n\nUse [Styles API](/styles/styles-api/) to customize Accordion styles:\n\nUse [Styles API](/styles/styles-api/) to customize Accordion styles:",
 "format": "md"
 },
 {
 "title": "TypeScript",
 "text": "`AccordionProps` type exported from `@mantine/core` is a generic, it accepts boolean type that\ndescribes `multiple` state:",
 "format": "md"
 },
 {
 "title": "Accessibility",
 "text": "Accordion component follows [WAI-ARIA recommendations](https://www.w3.org/TR/wai-aria-practices-1.1/examples/accordion/accordion.html) on accessibility.\n\nSet `order` on `Accordion` component to wrap accordion controls with h2-h6 heading.\nThe following example will wrap controls with h3 tag:\n\nKeyboard interactions:\n\n data={[\n\n key: 'Space/Enter',\n description: 'Toggles focused item opened state',\n },\n ]}\n/>",
 "format": "md"
 }
 ],
