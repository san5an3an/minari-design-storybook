 "prose": [
 {
 "title": "Inline",
 "text": "When the target element has a fixed width, set `inline` prop to add `display: inline-block;` styles to\nIndicator container. Alternatively, you can set width and height with `style` prop if you still want the root\nelement to keep `display: block`.",
 "format": "md"
 },
 {
 "title": "Offset",
 "text": "Set `offset` to change indicator position. It is useful when Indicator component is\nused with children that have border-radius:",
 "format": "md"
 },
 {
 "title": "Disabled",
 "text": "Set `disabled` to hide the indicator:",
 "format": "md"
 }
 ],
 "parts": {
 "presence": "absent-in-official",
