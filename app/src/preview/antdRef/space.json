{
 "slug": "space",
 "title": "Space",
 "description": "Set components spacing.",
 "group": "Layout",
 "whenToUse": "- Avoid components clinging together and set a unified space.\n- Use Space.Compact when child form components are compactly connected and the border is collapsed (After version `antd@4.24.0` Supported).\n\n### Difference with Flex component\n\n- Space is used to set the spacing between inline elements. It will add a wrapper element for each child element for inline alignment. Suitable for equidistant arrangement of multiple child elements in rows and columns.\n- Flex is used to set the layout of block-level elements. It does not add a wrapper element. Suitable for layout of child elements in vertical or horizontal direction, and provides more flexibility and control.",
 "examples": [
  {
   "name": "Basic Usage",
   "description": "Crowded components horizontal spacing.",
   "code": "import React from 'react';\nimport { UploadOutlined } from '@ant-design/icons';\nimport { Button, Popconfirm, Space, Upload } from 'antd';\n\nconst App: React.FC = () => (\n  <Space>\n    Space\n    <Button type=\"primary\">Button</Button>\n    <Upload>\n      <Button icon={<UploadOutlined />}>Click to Upload</Button>\n    </Upload>\n    <Popconfirm title=\"Are you sure delete this task?\" okText=\"Yes\" cancelText=\"No\">\n      <Button>Confirm</Button>\n    </Popconfirm>\n  </Space>\n);\n\nexport default App;",
   "demoId": "base"
  },
  {
   "name": "Vertical Space",
   "description": "Crowded components vertical spacing.",
   "code": "import React from 'react';\nimport { Card, Space } from 'antd';\n\nconst App: React.FC = () => (\n  <Space orientation=\"vertical\" size=\"medium\" style={{ display: 'flex' }}>\n    <Card title=\"Card\" size=\"small\">\n      <p>Card content</p>\n      <p>Card content</p>\n    </Card>\n    <Card title=\"Card\" size=\"small\">\n      <p>Card content</p>\n      <p>Card content</p>\n    </Card>\n    <Card title=\"Card\" size=\"small\">\n      <p>Card content</p>\n      <p>Card content</p>\n    </Card>\n  </Space>\n);\n\nexport default App;",
   "demoId": "vertical"
  },
  {
   "name": "Space Size",
   "description": "Use `size` to set the spacing. Three sizes are preset: `small`, `medium`, `large`. You can also customize the spacing. If `size` is not set, the spacing is `small`.",
   "code": "import React, { useState } from 'react';\nimport { Button, Radio, Slider, Space } from 'antd';\nimport type { ConfigProviderProps } from 'antd';\n\ntype SizeType = ConfigProviderProps['componentSize'];\n\nconst App: React.FC = () => {\n  const [size, setSize] = useState<SizeType | [SizeType, SizeType] | 'customize'>('small');\n  const [customSize, setCustomSize] = React.useState<number>(0);\n  return (\n    <>\n      <Radio.Group value={size} onChange={(e) => setSize(e.target.value)}>\n        {['small', 'medium', 'large', 'customize'].map((item) => (\n          <Radio key={item} value={item}>\n            {item}\n          </Radio>\n        ))}\n      </Radio.Group>\n      <br />\n      <br />\n      {size === 'customize' && (\n        <>\n          <Slider value={customSize} onChange={setCustomSize} />\n          <br />\n        </>\n      )}\n      <Space size={size !== 'customize' ? size : customSize}>\n        <Button type=\"primary\">Primary</Button>\n        <Button>Default</Button>\n        <Button type=\"dashed\">Dashed</Button>\n        <Button type=\"link\">Link</Button>\n      </Space>\n    </>\n  );\n};\n\nexport default App;",
   "demoId": "size"
  },
  {
   "name": "Align",
   "description": "Config item align.",
   "code": "import React from 'react';\nimport { Button, Flex, Space } from 'antd';\nimport { createStyles } from 'antd-style';\n\nconst useStyles = createStyles((props) => {\n  const { css, cssVar } = props;\n  return {\n    spaceAlignBox: css`\n      flex: none;\n      margin: ${cssVar.marginXXS};\n      padding: ${cssVar.paddingXXS};\n      border: ${cssVar.lineWidth} ${cssVar.lineType} ${cssVar.blue};\n    `,\n    mockBox: css`\n      display: inline-block;\n      padding: ${cssVar.paddingXL} ${cssVar.padding};\n      background-color: rgba(150, 150, 150, 0.2);\n    `,\n  };\n});\n\nconst App: React.FC = () => {\n  const { styles } = useStyles();\n  return (\n    <Flex wrap align=\"flex-start\">\n      <div className={styles.spaceAlignBox}>\n        <Space align=\"center\">\n          center\n          <Button type=\"primary\">Primary</Button>\n          <span className={styles.mockBox}>Block</span>\n        </Space>\n      </div>\n      <div className={styles.spaceAlignBox}>\n        <Space align=\"start\">\n          start\n          <Button type=\"primary\">Primary</Button>\n          <span className={styles.mockBox}>Block</span>\n        </Space>\n      </div>\n      <div className={styles.spaceAlignBox}>\n        <Space align=\"end\">\n          end\n          <Button type=\"primary\">Primary</Button>\n          <span className={styles.mockBox}>Block</span>\n        </Space>\n      </div>\n      <div className={styles.spaceAlignBox}>\n        <Space align=\"baseline\">\n          baseline\n          <Button type=\"primary\">Primary</Button>\n          <span className={styles.mockBox}>Block</span>\n        </Space>\n      </div>\n    </Flex>\n  );\n};\n\nexport default App;",
   "demoId": "align"
  },
  {
   "name": "Wrap",
   "description": "Auto wrap line.",
   "code": "import React from 'react';\nimport { Button, Space } from 'antd';\n\nconst App: React.FC = () => (\n  <Space size={[8, 16]} wrap>\n    {Array.from({ length: 20 }).map((_, index) => (\n      // eslint-disable-next-line react/no-array-index-key\n      <Button key={index}>Button</Button>\n    ))}\n  </Space>\n);\n\nexport default App;",
   "demoId": "wrap"
  },
  {
   "name": "separator",
   "description": "Crowded components separator.",
   "code": "import React from 'react';\nimport { Divider, Space, Typography } from 'antd';\n\nconst App: React.FC = () => (\n  <Space separator={<Divider vertical />}>\n    <Typography.Link>Link</Typography.Link>\n    <Typography.Link>Link</Typography.Link>\n    <Typography.Link>Link</Typography.Link>\n  </Space>\n);\n\nexport default App;",
   "demoId": "separator"
  },
  {
   "name": "Compact Mode for form component",
   "description": "Compact Mode for form component.",
   "code": "import React from 'react';\nimport { CopyOutlined } from '@ant-design/icons';\nimport {\n  AutoComplete,\n  Button,\n  Cascader,\n  ColorPicker,\n  DatePicker,\n  Input,\n  InputNumber,\n  Select,\n  Space,\n  TimePicker,\n  Tooltip,\n  TreeSelect,\n} from 'antd';\n\nconst { TreeNode } = TreeSelect;\n\nconst App: React.FC = () => (\n  <Space orientation=\"vertical\">\n    <Space.Compact block>\n      <Input style={{ width: '20%' }} defaultValue=\"0571\" />\n      <Input style={{ width: '30%' }} defaultValue=\"26888888\" />\n    </Space.Compact>\n    <Space.Compact block size=\"small\">\n      <Input style={{ width: 'calc(100% - 200px)' }} defaultValue=\"https://ant.design\" />\n      <Button type=\"primary\">Submit</Button>\n    </Space.Compact>\n    <Space.Compact block>\n      <Input style={{ width: 'calc(100% - 200px)' }} defaultValue=\"https://ant.design\" />\n      <Button type=\"primary\">Submit</Button>\n    </Space.Compact>\n    <Space.Compact block>\n      <Input\n        style={{ width: 'calc(100% - 200px)' }}\n        defaultValue=\"git@github.com:ant-design/ant-design.git\"\n      />\n      <Tooltip title=\"copy git url\">\n        <Button icon={<CopyOutlined />} />\n      </Tooltip>\n    </Space.Compact>\n    <Space.Compact block>\n      <Select\n        allowClear\n        defaultValue=\"Zhejiang\"\n        options={[\n          { label: 'Zhejiang', value: 'Zhejiang' },\n          { label: 'Jiangsu', value: 'Jiangsu' },\n        ]}\n      />\n      <Input style={{ width: '50%' }} defaultValue=\"Xihu District, Hangzhou\" />\n    </Space.Compact>\n    <Space.Compact block>\n      <Select\n        allowClear\n        mode=\"multiple\"\n        defaultValue=\"Zhejiang\"\n        style={{ width: '50%' }}\n        options={[\n          { label: 'Zhejiang', value: 'Zhejiang' },\n          { label: 'Jiangsu', value: 'Jiangsu' },\n        ]}\n      />\n      <Input style={{ width: '50%' }} defaultValue=\"Xihu District, Hangzhou\" />\n    </Space.Compact>\n    <Space.Compact block>\n      <Input.Search style={{ width: '30%' }} defaultValue=\"0571\" />\n      <Input.Search allowClear style={{ width: '50%' }} defaultValue=\"26888888\" />\n      <Input.Search style={{ width: '20%' }} defaultValue=\"+1\" />\n    </Space.Compact>\n    <Space.Compact block>\n      <Select\n        defaultValue=\"Option1\"\n        options={[\n          { label: 'Option1', value: 'Option1' },\n          { label: 'Option2', value: 'Option2' },\n        ]}\n      />\n      <Input style={{ width: '50%' }} defaultValue=\"input content\" />\n      <InputNumber defaultValue={12} />\n    </Space.Compact>\n    <Space.Compact block>\n      <Input style={{ width: '50%' }} defaultValue=\"input content\" />\n      <DatePicker style={{ width: '50%' }} />\n    </Space.Compact>\n    <Space.Compact block>\n      <DatePicker.RangePicker style={{ width: '70%' }} />\n      <Input style={{ width: '30%' }} defaultValue=\"input content\" />\n      <Button type=\"primary\">Search</Button>\n    </Space.Compact>\n    <Space.Compact block>\n      <Input style={{ width: '30%' }} defaultValue=\"input content\" />\n      <DatePicker.RangePicker style={{ width: '70%' }} />\n    </Space.Compact>\n    <Space.Compact block>\n      <Select\n        defaultValue=\"Option1-1\"\n        options={[\n          { label: 'Option1-1', value: 'Option1-1' },\n          { label: 'Option1-2', value: 'Option1-2' },\n        ]}\n      />\n      <Select\n        defaultValue=\"Option2-2\"\n        options={[\n          { label: 'Option2-1', value: 'Option2-1' },\n          { label: 'Option2-2', value: 'Option2-2' },\n        ]}\n      />\n    </Space.Compact>\n    <Space.Compact block>\n      <Select\n        defaultValue=\"1\"\n        options={[\n          { label: 'Between', value: '1' },\n          { label: 'Except', value: '2' },\n        ]}\n      />\n      <Input style={{ width: 100, textAlign: 'center' }} placeholder=\"Minimum\" />\n      <Input\n        className=\"site-input-split\"\n        style={{\n          width: 30,\n          borderInlineStart: 0,\n          borderInlineEnd: 0,\n          pointerEvents: 'none',\n        }}\n        placeholder=\"~\"\n        disabled\n      />\n      <Input\n        className=\"site-input-right\"\n        style={{\n          width: 100,\n          textAlign: 'center',\n        }}\n        placeholder=\"Maximum\"\n      />\n    </Space.Compact>\n    <Space.Compact block>\n      <Select\n        defaultValue=\"Sign Up\"\n        style={{ width: '30%' }}\n        options={[\n          { label: 'Sign Up', value: 'Sign Up' },\n          { label: 'Sign In', value: 'Sign In' },\n        ]}\n      />\n      <AutoComplete\n        style={{ width: '70%' }}\n        placeholder=\"Email\"\n        options={[{ value: 'text 1' }, { value: 'text 2' }]}\n      />\n    </Space.Compact>\n    <Space.Compact block>\n      <TimePicker style={{ width: '70%' }} />\n      <Cascader\n        style={{ width: '70%' }}\n        options={[\n          {\n            value: 'zhejiang',\n            label: 'Zhejiang',\n            children: [\n              {\n                value: 'hangzhou',\n                label: 'Hangzhou',\n                children: [\n                  {\n                    value: 'xihu',\n                    label: 'West Lake',\n                  },\n                ],\n              },\n            ],\n          },\n          {\n            value: 'jiangsu',\n            label: 'Jiangsu',\n            children: [\n              {\n                value: 'nanjing',\n                label: 'Nanjing',\n                children: [\n                  {\n                    value: 'zhonghuamen',\n                    label: 'Zhong Hua Men',\n                  },\n                ],\n              },\n            ],\n          },\n        ]}\n        placeholder=\"Select Address\"\n      />\n    </Space.Compact>\n    <Space.Compact block>\n      <TimePicker.RangePicker />\n      <TreeSelect\n        showSearch\n        style={{ width: '60%' }}\n        value=\"leaf1\"\n        styles={{\n          popup: {\n            root: { maxHeight: 400, overflow: 'auto' },\n          },\n        }}\n        placeholder=\"Please select\"\n        allowClear\n        treeDefaultExpandAll\n        onChange={() => {}}\n      >\n        <TreeNode value=\"parent 1\" title=\"parent 1\">\n          <TreeNode value=\"parent 1-0\" title=\"parent 1-0\">\n            <TreeNode value=\"leaf1\" title=\"leaf1\" />\n            <TreeNode value=\"leaf2\" title=\"leaf2\" />\n          </TreeNode>\n          <TreeNode value=\"parent 1-1\" title=\"parent 1-1\">\n            <TreeNode value=\"leaf3\" title={<b style={{ color: '#08c' }}>leaf3</b>} />\n          </TreeNode>\n        </TreeNode>\n      </TreeSelect>\n      <Button type=\"primary\">Submit</Button>\n    </Space.Compact>\n    <Space.Compact>\n      <Input placeholder=\"input here\" />\n      <Space.Addon>$</Space.Addon>\n      <InputNumber placeholder=\"another input\" style={{ width: '100%' }} />\n      <InputNumber placeholder=\"another input\" style={{ width: '100%' }} />\n      <Space.Addon>$</Space.Addon>\n    </Space.Compact>\n    <Space.Compact>\n      <Input placeholder=\"input here\" />\n      <ColorPicker />\n    </Space.Compact>\n    <Space.Compact>\n      <Button type=\"primary\">Button</Button>\n      <Input placeholder=\"input here\" />\n      <Space.Addon>$</Space.Addon>\n    </Space.Compact>\n  </Space>\n);\n\nexport default App;",
   "demoId": "compact"
  },
  {
   "name": "Button Compact Mode",
   "description": "Button component compact example.",
   "code": "import React from 'react';\nimport {\n  CommentOutlined,\n  DownloadOutlined,\n  EllipsisOutlined,\n  HeartOutlined,\n  LikeOutlined,\n  MailOutlined,\n  MobileOutlined,\n  ShareAltOutlined,\n  StarOutlined,\n  WarningOutlined,\n} from '@ant-design/icons';\nimport { Button, Dropdown, Space, Tooltip } from 'antd';\n\nconst App: React.FC = () => (\n  <div>\n    <Space.Compact block>\n      <Tooltip title=\"Like\">\n        <Button icon={<LikeOutlined />} />\n      </Tooltip>\n      <Tooltip title=\"Comment\">\n        <Button icon={<CommentOutlined />} />\n      </Tooltip>\n      <Tooltip title=\"Star\">\n        <Button icon={<StarOutlined />} />\n      </Tooltip>\n      <Tooltip title=\"Heart\">\n        <Button icon={<HeartOutlined />} />\n      </Tooltip>\n      <Tooltip title=\"Share\">\n        <Button icon={<ShareAltOutlined />} />\n      </Tooltip>\n      <Tooltip title=\"Download\">\n        <Button icon={<DownloadOutlined />} />\n      </Tooltip>\n      <Dropdown\n        placement=\"bottomRight\"\n        menu={{\n          items: [\n            {\n              key: '1',\n              label: 'Report',\n              icon: <WarningOutlined />,\n            },\n            {\n              key: '2',\n              label: 'Mail',\n              icon: <MailOutlined />,\n            },\n            {\n              key: '3',\n              label: 'Mobile',\n              icon: <MobileOutlined />,\n            },\n          ],\n        }}\n        trigger={['click']}\n      >\n        <Button icon={<EllipsisOutlined />} />\n      </Dropdown>\n    </Space.Compact>\n    <br />\n    <Space.Compact block>\n      <Button type=\"primary\">Button 1</Button>\n      <Button type=\"primary\">Button 2</Button>\n      <Button type=\"primary\">Button 3</Button>\n      <Button type=\"primary\">Button 4</Button>\n      <Tooltip title=\"Tooltip\">\n        <Button type=\"primary\" icon={<DownloadOutlined />} disabled />\n      </Tooltip>\n      <Tooltip title=\"Tooltip\">\n        <Button type=\"primary\" icon={<DownloadOutlined />} />\n      </Tooltip>\n    </Space.Compact>\n    <br />\n    <Space.Compact block>\n      <Button>Button 1</Button>\n      <Button>Button 2</Button>\n      <Button>Button 3</Button>\n      <Tooltip title=\"Tooltip\">\n        <Button icon={<DownloadOutlined />} disabled />\n      </Tooltip>\n      <Tooltip title=\"Tooltip\">\n        <Button icon={<DownloadOutlined />} />\n      </Tooltip>\n      <Button type=\"primary\">Button 4</Button>\n      <Dropdown\n        placement=\"bottomRight\"\n        menu={{\n          items: [\n            {\n              key: '1',\n              label: '1st item',\n            },\n            {\n              key: '2',\n              label: '2nd item',\n            },\n            {\n              key: '3',\n              label: '3rd item',\n            },\n          ],\n        }}\n        trigger={['click']}\n      >\n        <Button type=\"primary\" icon={<EllipsisOutlined />} />\n      </Dropdown>\n    </Space.Compact>\n  </div>\n);\n\nexport default App;",
   "demoId": "compact-buttons"
  },
  {
   "name": "Vertical Compact Mode",
   "description": "Vertical Mode for Space.Compact, support Button only.",
   "code": "import React from 'react';\nimport { Button, Space } from 'antd';\n\nconst App: React.FC = () => (\n  <Space>\n    <Space.Compact orientation=\"vertical\">\n      <Button>Button 1</Button>\n      <Button>Button 2</Button>\n      <Button>Button 3</Button>\n    </Space.Compact>\n    <Space.Compact orientation=\"vertical\">\n      <Button type=\"dashed\">Button 1</Button>\n      <Button type=\"dashed\">Button 2</Button>\n      <Button type=\"dashed\">Button 3</Button>\n    </Space.Compact>\n    <Space.Compact orientation=\"vertical\">\n      <Button type=\"primary\">Button 1</Button>\n      <Button type=\"primary\">Button 2</Button>\n      <Button type=\"primary\">Button 3</Button>\n    </Space.Compact>\n    <Space.Compact orientation=\"vertical\">\n      <Button variant=\"outlined\">Button 1</Button>\n      <Button variant=\"outlined\">Button 2</Button>\n      <Button variant=\"outlined\">Button 3</Button>\n    </Space.Compact>\n  </Space>\n);\n\nexport default App;",
   "demoId": "compact-button-vertical"
  },
  {
   "name": "Custom semantic dom styling",
   "description": "You can customize the semantic dom style of Space by passing objects/functions through `classNames` and `styles`.",
   "code": "import * as React from 'react';\nimport { Button, Space } from 'antd';\nimport type { GetProp, SpaceProps } from 'antd';\n\nconst classNamesObject: SpaceProps['classNames'] = {\n  root: 'demo-space-root',\n  item: 'demo-space-item',\n  separator: 'demo-space-separator',\n};\n\nconst classNamesFn: SpaceProps['classNames'] = (\n  info,\n): GetProp<SpaceProps, 'classNames', 'Return'> => {\n  if (info.props.orientation === 'vertical') {\n    return {\n      root: 'demo-space-root--vertical',\n    };\n  } else {\n    return {\n      root: 'demo-space-root--horizontal',\n    };\n  }\n};\n\nconst stylesObject: SpaceProps['styles'] = {\n  root: { borderWidth: 2, borderStyle: 'dashed', padding: 8, marginBottom: 10 },\n  item: { backgroundColor: '#f0f0f0', padding: 4 },\n  separator: { color: 'red', fontWeight: 'bold' },\n};\n\nconst stylesFn: SpaceProps['styles'] = (info): GetProp<SpaceProps, 'styles', 'Return'> => {\n  if (info.props.size === 'large') {\n    return {\n      root: {\n        backgroundColor: '#e6f7ff',\n        borderColor: '#1890ff',\n        padding: 8,\n      },\n    };\n  } else {\n    return {\n      root: {\n        backgroundColor: '#fff7e6',\n        borderColor: '#fa8c16',\n      },\n    };\n  }\n};\n\nconst App: React.FC = () => {\n  return (\n    <div>\n      <Space styles={stylesObject} classNames={classNamesObject} separator=\"•\">\n        <Button>Styled Button 1</Button>\n        <Button>Styled Button 2</Button>\n        <Button>Styled Button 3</Button>\n      </Space>\n      <Space size=\"large\" styles={stylesFn} classNames={classNamesFn}>\n        <Button>Large Space Button 1</Button>\n        <Button>Large Space Button 2</Button>\n        <Button>Large Space Button 3</Button>\n      </Space>\n    </div>\n  );\n};\n\nexport default App;",
   "demoId": "style-class"
  }
 ],
