"/* 본문 폭을 가독 한계 40rem으로 고정 */\n\n.ods-prose {\n  max-width: 40rem;\n  color: var(--component-prose-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-prose-font-size);\n  letter-spacing: var(--component-prose-letter-spacing);\n  line-height: var(--component-prose-line-height);\n  word-break: keep-all;\n}\n.ods-prose > * + * { margin-top: var(--component-prose-paragraph-gap); }\n.ods-prose h2 { margin-top: var(--component-prose-heading-gap);\n  font-size: var(--component-prose-h2-font-size);\n  letter-spacing: var(--component-prose-h2-letter-spacing);\n  line-height: var(--base-font-line-height-snug); }\n.ods-prose h3 { margin-top: var(--component-prose-heading-gap);\n  font-size: var(--component-prose-h3-font-size);\n  letter-spacing: var(--component-prose-h3-letter-spacing);\n  line-height: var(--base-font-line-height-snug); }\n.ods-prose a { color: var(--component-prose-link-fg); text-underline-offset: .2em; }\n.ods-prose blockquote {\n  margin-inline: 0;\n  padding-inline-start: var(--component-prose-quote-padding);\n  border-inline-start: 0.1875rem solid var(--component-prose-quote-border);\n  color: var(--component-prose-quote-fg);\n}\n.ods-prose code {\n  padding: .1em .35em; border-radius: var(--semantic-radius-control);\n  background: var(--component-prose-code-bg);\n  /* 고대비에서 배경이 구분 안 돼 안쪽 outline 으로 경계 표시. border 는 크기가 바뀌기 때문임 */\n  outline: var(--semantic-border-width-default) solid var(--component-prose-code-border);\n  outline-offset: var(--semantic-border-inset-default);\n  color: var(--component-prose-code-fg);\n  font-family: var(--base-font-family-mono);\n  font-size: .9em;\n}\n.ods-prose hr { border: 0; border-top: var(--semantic-border-width-default) solid var(--component-prose-rule-color); }\n.ods-prose figcaption { color: var(--component-prose-fg-subtle);\n  font-size: var(--semantic-text-caption); }\n"
