"/* @interop daisyUI 기반 Saffron 테마 정의 */\n:root {\n  --color-primary         : var(--semantic-bg-brand-default);\n  --color-primary-content : var(--semantic-fg-on-brand-default);\n  --color-neutral         : var(--semantic-bg-neutral-default);\n  --color-neutral-content : var(--semantic-fg-on-neutral-default);\n  --color-success         : var(--semantic-bg-success-default);\n  --color-success-content : var(--semantic-fg-on-success-default);\n  --color-warning         : var(--semantic-bg-warning-default);\n  --color-warning-content : var(--semantic-fg-on-warning-default);\n  --color-error           : var(--semantic-bg-danger-default);\n  --color-error-content   : var(--semantic-fg-on-danger-default);\n  --color-base-100        : var(--semantic-bg-neutral-surface);\n  --color-base-200        : var(--semantic-bg-neutral-subtlest);\n  --color-base-300        : var(--semantic-bg-neutral-subtle);\n  --color-base-content    : var(--semantic-fg-neutral-default);\n  --radius-box            : var(--semantic-radius-container);\n  --radius-field          : var(--semantic-radius-control);\n  --radius-selector       : var(--semantic-radius-selection);\n  --border                : var(--semantic-border-width-default);\n  --size-field            : calc((var(--component-button-md-padding-block) * 2 + var(--component-button-md-font-size)) / 10);\n  --size-selector         : calc(var(--component-checkbox-size) / 6);\n}\n"
