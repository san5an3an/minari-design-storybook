"/* 빈 상태 여백은 밀도 airy 값 사용 */\n\n.ods-empty {\n  display: flex; flex-direction: column; align-items: center;\n  gap: var(--component-empty-gap);\n  padding-block: var(--component-empty-padding-block);\n  padding-inline: var(--component-empty-padding-inline);\n  text-align: center;\n  font-family: var(--base-font-family-sans);\n}\n.ods-empty-icon {\n  width: calc(var(--component-empty-icon-size) * 1.5);\n  height: calc(var(--component-empty-icon-size) * 1.5);\n  color: var(--component-empty-icon-fg);\n}\n.ods-empty-icon svg { width: 100%; height: 100%; stroke: currentColor; fill: none;\n  stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }\n.ods-empty-title {\n  margin: 0;\n  color: var(--component-empty-title-fg);\n  font-size: var(--component-empty-title-font-size);\n  letter-spacing: var(--component-empty-title-letter-spacing);\n  /* 제목과 본문 구분은 굵기 대신 색으로 표시 */\n  font-weight: var(--base-font-weight-medium);\n}\n.ods-empty-body {\n  margin: 0;\n  max-width: var(--component-empty-max-width);\n  color: var(--component-empty-body-fg);\n  font-size: var(--component-empty-body-font-size);\n  letter-spacing: var(--component-empty-body-letter-spacing);\n  line-height: var(--base-font-line-height-relaxed);\n}\n.ods-empty-actions { display: flex; gap: var(--component-empty-actions-gap);\n  flex-wrap: wrap; justify-content: center; }\n"
