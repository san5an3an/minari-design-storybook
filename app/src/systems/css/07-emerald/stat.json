"/* Stat 값은 mono 서체로 자릿수 정렬. 증감 색은 팔레트 구성에 종속 */\n\n.ods-stat { display: flex; flex-direction: column;\n  gap: var(--component-stat-gap);\n  font-family: var(--base-font-family-sans); }\n.ods-stat-label { color: var(--component-stat-label-fg);\n  font-size: var(--component-stat-label-font-size);\n  text-transform: none; letter-spacing: .02em; }\n.ods-stat-value { color: var(--component-stat-value-fg);\n  font-family: var(--base-font-family-mono);\n  font-size: var(--component-stat-value-font-size);\n  letter-spacing: var(--component-stat-value-letter-spacing);\n  font-weight: var(--base-font-weight-bold);\n  line-height: var(--base-font-line-height-tight);\n  font-variant-numeric: tabular-nums; }\n.ods-stat-delta { display: inline-flex; align-items: center; gap: .25em;\n  font-size: var(--component-stat-delta-font-size);\n  letter-spacing: var(--component-stat-delta-letter-spacing);\n  font-weight: var(--base-font-weight-medium); }\n.ods-stat-delta--up { color: var(--component-stat-delta-up-fg); }\n.ods-stat-delta--down { color: var(--component-stat-delta-down-fg); }\n.ods-stat-delta svg { width: 1em; height: 1em; stroke: currentColor; fill: none;\n  stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n\n/* 수치가 서고 120ms 뒤에 증감 표시. both는 이후 transform 적용을 막음 */\n.ods-stat-value {\n  animation: ods-stat-value-in 420ms cubic-bezier(.22,.61,.36,1) backwards; }\n.ods-stat-delta {\n  animation: ods-stat-delta-in 460ms cubic-bezier(.22,.61,.36,1) 120ms backwards; }\n.ods-stat-delta--up { animation-name: ods-stat-delta-up-in; }\n.ods-stat-delta--down { animation-name: ods-stat-delta-down-in; }\n@keyframes ods-stat-value-in {\n  from { opacity: 0; transform: translateY(0.25em); } to { opacity: 1; transform: none; } }\n@keyframes ods-stat-delta-in {\n  from { opacity: 0; } to { opacity: 1; } }\n@keyframes ods-stat-delta-up-in {\n  from { opacity: 0; transform: translateY(0.4em); } to { opacity: 1; transform: none; } }\n@keyframes ods-stat-delta-down-in {\n  from { opacity: 0; transform: translateY(-0.4em); } to { opacity: 1; transform: none; } }\n\n/* animation 대신 페이드 적용. 지우면 갱신 사실이 드러나지 않는 문제 있음 */\n@media (prefers-reduced-motion: reduce) {\n  .ods-stat-value,\n  .ods-stat-delta,\n  .ods-stat-delta--up,\n  .ods-stat-delta--down { animation: ods-stat-fade-in 200ms linear backwards; }\n}\n@keyframes ods-stat-fade-in { from { opacity: 0; } to { opacity: 1; } }\n"
