"/* 비율 유지 위치 지정, 로드 전에도 높이 고정 */\n\n.ods-aspectratio {\n  display: block; position: relative; width: 100%;\n  overflow: hidden;\n  background: var(--component-aspectratio-bg);\n  border: var(--semantic-border-width-default) solid var(--component-aspectratio-border);\n  border-radius: var(--component-aspectratio-radius);\n}\n/* 이미지는 cover 방식으로 채우고 잘라 표시. contain 은 여백이 남아 의미 없음 */\n.ods-aspectratio > * {\n  position: absolute; inset: 0;\n  width: 100%; height: 100%;\n  object-fit: cover;\n}\n.ods-aspectratio--square { aspect-ratio: 1 / 1; }\n.ods-aspectratio--video { aspect-ratio: 16 / 9; }\n.ods-aspectratio--portrait { aspect-ratio: 9 / 16; }\n"
