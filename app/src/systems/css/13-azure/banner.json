"/* Banner 타이포 비율 1.25, solid/soft 톤 2종 */\n\n.ods-banner {\n  display: flex; flex-direction: column;\n  gap: var(--component-banner-gap);\n  padding: var(--component-banner-padding);\n  border-radius: var(--component-banner-radius);\n  background: var(--component-banner-bg);\n  color: var(--component-banner-fg);\n  font-family: var(--base-font-family-sans);\n  box-shadow: var(--component-banner-shadow);\n}\n.ods-banner--soft {\n  background: var(--component-banner-bg-soft);\n  color: var(--component-banner-fg-soft);\n  border: var(--semantic-border-width-default) solid var(--component-banner-border);\n  box-shadow: none;\n}\n.ods-banner-title { margin: 0;\n  font-size: var(--component-banner-title-font-size);\n  letter-spacing: var(--component-banner-title-letter-spacing);\n  font-weight: var(--base-font-weight-bold);\n  line-height: var(--base-font-line-height-tight); }\n.ods-banner-body { margin: 0;\n  font-size: var(--component-banner-body-font-size);\n  letter-spacing: var(--component-banner-body-letter-spacing);\n  line-height: var(--base-font-line-height-normal); }\n.ods-banner-actions { display: flex; gap: var(--semantic-space-sm); flex-wrap: wrap; }\n"
