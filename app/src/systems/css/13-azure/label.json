"/* Label 폼 컨트롤 이름 표시, for 속성으로 필드와 연결 */\n\n.ods-label {\n  display: inline-flex; align-items: baseline;\n  gap: var(--component-label-gap);\n  color: var(--component-label-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-label-font-size);\n  letter-spacing: var(--component-label-letter-spacing);\n  font-weight: var(--base-font-weight-medium);\n  line-height: var(--base-font-line-height-snug);\n  cursor: pointer;\n}\n/* 필수 표시에 읽을 텍스트 추가. 별표만으로는 스크린리더가 안 읽음 */\n.ods-label--required::after {\n  content: \"*\";\n  color: var(--component-label-required-fg);\n  margin-inline-start: .15em;\n}\n.ods-label[aria-invalid=\"true\"] { color: var(--component-label-fg-invalid); }\n.ods-label-hint {\n  color: var(--component-label-hint-fg);\n  font-size: var(--component-label-hint-font-size);\n  letter-spacing: var(--component-label-hint-letter-spacing);\n  font-weight: var(--base-font-weight-regular);\n}\n/* 잠긴 필드의 라벨도 함께 흐리게 표시 */\n.ods-label:has(+ :disabled), .ods-label--disabled {\n  color: var(--component-label-fg-disabled); cursor: not-allowed; }\n"
