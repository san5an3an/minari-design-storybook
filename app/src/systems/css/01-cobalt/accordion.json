"/* 제목 줄 전체를 클릭 영역으로 지정 */\n\n.ods-accordion {\n  border: var(--semantic-border-width-default) solid var(--component-accordion-border);\n  border-radius: var(--component-accordion-radius);\n  overflow: hidden;\n  font-family: var(--base-font-family-sans);\n}\n.ods-accordion-item + .ods-accordion-item {\n  border-top: var(--semantic-border-width-default) solid var(--component-accordion-border);\n}\n/* 제목 행 전체를 클릭 영역으로 지정 */\n.ods-accordion-head {\n  display: flex; align-items: center; width: 100%;\n  gap: var(--component-accordion-head-gap);\n  padding-inline: var(--component-accordion-head-padding-inline);\n  padding-block: var(--component-accordion-head-padding-block);\n  border: 0; background: transparent;\n  color: var(--component-accordion-head-fg);\n  font: inherit;\n  font-size: var(--component-accordion-head-font-size);\n  letter-spacing: var(--component-accordion-head-letter-spacing);\n  font-weight: var(--base-font-weight-medium);\n  text-align: left; cursor: pointer;\n}\n.ods-accordion-head:hover { background: var(--component-accordion-head-bg-hover); }\n.ods-accordion-head:focus-visible { outline: 0.125rem solid var(--semantic-border-focus-default);\n  outline-offset: -2px; }\n.ods-accordion-marker {\n  margin-left: auto; flex-shrink: 0;\n  width: var(--component-accordion-marker-size);\n  height: var(--component-accordion-marker-size);\n  color: var(--component-accordion-marker-fg);\n  transition: transform 150ms ease;\n}\n.ods-accordion-marker svg { width: 100%; height: 100%; stroke: currentColor; fill: none;\n  stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n.ods-accordion-head[aria-expanded=\"true\"] .ods-accordion-marker { transform: rotate(180deg); }\n.ods-accordion-body {\n  padding-inline: var(--component-accordion-body-padding-inline);\n  /* 위쪽 0, 아래쪽만 패딩 토큰 적용 */\n  padding-block: 0 var(--component-accordion-body-padding-block-end);\n  color: var(--component-accordion-body-fg);\n  font-size: var(--component-accordion-body-font-size);\n  letter-spacing: var(--component-accordion-body-letter-spacing);\n  line-height: var(--base-font-line-height-relaxed);\n}\n.ods-accordion-body[hidden] { display: none; }\n@media (prefers-reduced-motion: reduce) { .ods-accordion-marker { transition: none; } }\n"
