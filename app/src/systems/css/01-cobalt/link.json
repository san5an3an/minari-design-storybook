"/* 밑줄은 hover 시에만 표시. 채도 축이 balanced임 */\n\n.ods-link {\n  color: var(--component-link-fg);\n  font-family: inherit;\n  text-decoration: none;\n  text-underline-offset: var(--component-link-underline-offset);\n  cursor: pointer;\n}\n.ods-link:hover { color: var(--component-link-fg-hover); text-decoration: underline; }\n.ods-link:focus-visible {\n  outline: 0.125rem solid var(--component-link-border-focus); outline-offset: 0.125rem;\n  border-radius: 0.125rem;\n}\n.ods-link:visited { color: var(--component-link-fg-visited); }\n.ods-link-external { display: inline-flex; align-items: center;\n  gap: var(--component-link-gap); }\n.ods-link-external svg { width: .85em; height: .85em; stroke: currentColor; fill: none;\n  stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n"
