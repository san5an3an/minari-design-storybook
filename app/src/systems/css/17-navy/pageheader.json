"/* elevation 축 shadow, 하단 경계선 제외 */\n\n.ods-pageheader {\n  display: flex; align-items: flex-start; flex-wrap: wrap;\n  gap: var(--component-pageheader-row-gap);\n  padding-block: var(--component-pageheader-padding-block);\n  \n  font-family: var(--base-font-family-sans);\n}\n.ods-pageheader-main {\n  display: flex; flex-direction: column; flex: 1; min-width: 0;\n  gap: var(--component-pageheader-gap);\n}\n.ods-pageheader-title {\n  margin: 0;\n  color: var(--component-pageheader-title-fg);\n  font-size: var(--component-pageheader-title-font-size);\n  letter-spacing: var(--component-pageheader-title-letter-spacing);\n  line-height: var(--base-font-line-height-tight);\n}\n.ods-pageheader-lede {\n  margin: 0;\n  max-width: var(--component-pageheader-lede-max-width);\n  color: var(--component-pageheader-lede-fg);\n  font-size: var(--component-pageheader-lede-font-size);\n  letter-spacing: var(--component-pageheader-lede-letter-spacing);\n  line-height: var(--base-font-line-height-normal);\n}\n.ods-pageheader-meta {\n  display: flex; align-items: center; flex-wrap: wrap;\n  gap: var(--component-pageheader-meta-gap);\n  color: var(--component-pageheader-lede-fg);\n  font-size: var(--component-pageheader-lede-font-size);\n  letter-spacing: var(--component-pageheader-lede-letter-spacing);\n}\n/* 동작 버튼은 오른쪽 끝에 고정 */\n.ods-pageheader-actions {\n  display: flex; align-items: center; flex-wrap: wrap;\n  gap: var(--component-pageheader-actions-gap);\n  margin-left: auto;\n}\n"
