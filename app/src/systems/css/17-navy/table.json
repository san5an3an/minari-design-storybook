"/* Table 밀도 축 compact 지정, 행 구분선으로 위계 표시 */\n\n.ods-table { width: 100%; border-collapse: collapse;\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-table-cell-font-size);\n  letter-spacing: var(--component-table-cell-letter-spacing);\n  color: var(--component-table-cell-fg); }\n.ods-table caption { text-align: left; padding-block: var(--component-table-cell-padding-block);\n  color: var(--component-table-caption-fg);\n  font-size: var(--component-table-caption-font-size);\n  letter-spacing: var(--component-table-caption-letter-spacing); }\n.ods-table thead th {\n  background: var(--component-table-head-bg);\n  color: var(--component-table-head-fg);\n  font-size: var(--component-table-head-font-size);\n  letter-spacing: var(--component-table-head-letter-spacing);\n  font-weight: var(--base-font-weight-medium);\n  text-align: left;\n  border-bottom: var(--semantic-border-width-default) solid var(--component-table-border-strong);\n}\n.ods-table th, .ods-table td {\n  padding-inline: var(--component-table-cell-padding-inline);\n  padding-block: var(--component-table-cell-padding-block);\n  border-bottom: var(--semantic-border-width-default) solid var(--component-table-border);\n}\n/* 선택 상태는 배경색 대신 outline 굵기로 표시. 고대비에서 배경 차이가 거의 안 보임 */\n.ods-table tbody tr:hover {\n  background: var(--component-table-row-hover-bg);\n  outline: var(--semantic-border-width-default) solid var(--component-table-row-hover-border); outline-offset: var(--semantic-border-inset-default);\n}\n.ods-table tbody tr[aria-selected=\"true\"] {\n  background: var(--component-table-row-selected-bg);\n  outline: var(--semantic-border-width-default) solid var(--component-table-row-selected-border); outline-offset: var(--semantic-border-inset-default);\n}\n.ods-table td.ods-table-num { text-align: right; font-family: var(--base-font-family-mono); }\n"
