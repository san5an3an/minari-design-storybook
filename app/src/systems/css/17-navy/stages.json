"/* Stages 지남, 지금, 아직 상태 색상과 함께 표시 */\n\n.ods-stages {\n  display: flex; align-items: flex-start;\n  list-style: none; margin: 0; padding: 0;\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-stages-font-size);\n  letter-spacing: var(--component-stages-letter-spacing);\n}\n.ods-stages-item {\n  display: flex; align-items: center; flex: 1; min-width: 0;\n  gap: var(--component-stages-gap);\n}\n/* 단계 연결선, 마지막 단계 뒤에는 미표시 */\n.ods-stages-item:not(:last-child)::after {\n  content: \"\"; flex: 1; height: 0.0625rem; min-width: 1rem;\n  background: var(--component-stages-line);\n}\n.ods-stages-mark {\n  display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;\n  width: var(--component-stages-mark-size); height: var(--component-stages-mark-size);\n  border-radius: var(--component-stages-mark-radius);\n  background: var(--component-stages-todo-bg);\n  color: var(--component-stages-todo-fg);\n  /* 고대비에서 배경이 구분 안 돼 안쪽 outline 으로 경계 표시. border 는 크기가 바뀌기 때문임 */\n  outline: var(--semantic-border-width-default) solid var(--component-stages-mark-border);\n  outline-offset: var(--semantic-border-inset-default);\n  font-variant-numeric: tabular-nums;\n}\n.ods-stages-mark svg { width: .8em; height: .8em; stroke: currentColor; fill: none;\n  stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }\n.ods-stages-label { color: var(--component-stages-todo-fg); white-space: nowrap; }\n/* '아직' 상태도 별도 클래스로 지정 */\n.ods-stages-item--todo > .ods-stages-mark {\n  background: var(--component-stages-todo-bg); color: var(--component-stages-todo-fg);\n}\n.ods-stages-item--done > .ods-stages-mark {\n  background: var(--component-stages-done-bg); color: var(--component-stages-done-fg);\n}\n.ods-stages-item--done > .ods-stages-label { color: var(--component-stages-done-fg); }\n.ods-stages-item--current > .ods-stages-mark {\n  background: var(--component-stages-current-bg); color: var(--component-stages-current-fg);\n}\n.ods-stages-item--current > .ods-stages-label {\n  color: var(--component-stages-current-label);\n  font-weight: var(--base-font-weight-semibold);\n}\n"
