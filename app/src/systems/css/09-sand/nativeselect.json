"/* NativeSelect 필드 control underline 적용, 목록은 기기가 렌더링 */\n\n.ods-nativeselect-wrapper { position: relative; display: inline-flex; width: 100%; }\n.ods-nativeselect {\n  /* 네이티브 화살표 아이콘 숨김 처리. 안 지우면 커스텀 화살표와 겹쳐 두 개로 보임 */\n  appearance: none; -webkit-appearance: none;\n  width: 100%;\n  padding-inline: var(--component-nativeselect-padding-inline);\n  /* 끝쪽 여백에 화살표 공간 지정. 없으면 긴 값이 화살표와 겹쳐 보임 */\n  padding-inline-end: calc(var(--component-nativeselect-icon-inset) * 3);\n  padding-block: var(--component-nativeselect-padding-block);\n  background: var(--component-nativeselect-bg);\n  color: var(--component-nativeselect-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-nativeselect-font-size);\n  letter-spacing: var(--component-nativeselect-letter-spacing);\n  line-height: var(--base-font-line-height-normal);\n  cursor: pointer;\n  border: 0;\n  border-bottom: var(--semantic-border-width-default) solid var(--component-nativeselect-border);\n  border-radius: 0;\n}\n.ods-nativeselect:focus { outline: none; border-bottom-width: 0.125rem;\n  border-bottom-color: var(--component-nativeselect-border-focus); }\n.ods-nativeselect:disabled {\n  background: var(--component-nativeselect-disabled-bg);\n  color: var(--component-nativeselect-disabled-fg);\n  cursor: not-allowed;\n}\n.ods-nativeselect[aria-invalid=\"true\"] {\n  border-color: var(--component-nativeselect-border-invalid);\n}\n.ods-nativeselect-icon {\n  position: absolute; inset-block: 0;\n  inset-inline-end: var(--component-nativeselect-icon-inset);\n  display: flex; align-items: center;\n  color: var(--component-nativeselect-icon-fg);\n  pointer-events: none;\n}\n.ods-nativeselect-icon svg { width: 1em; height: 1em; stroke: currentColor; fill: none;\n  stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n/* 목록 내부는 기기가 렌더링, 색상 코드는 지원 기기에서만 적용 */\n.ods-nativeselect-option { color: var(--component-nativeselect-fg); }\n.ods-nativeselect-optgroup { color: var(--component-nativeselect-fg-placeholder); }\n"
