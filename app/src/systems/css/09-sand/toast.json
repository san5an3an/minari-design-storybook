"/* Toast 알림 종류 brand, danger, success, warning */\n\n.ods-toast-region {\n  display: flex; flex-direction: column;\n  gap: var(--component-toast-stack-gap);\n  /* 폭 기준 컨테이너. 알림 너비는 이 안에서 가변적으로 조정 */\n  align-items: flex-end;\n  max-width: var(--component-toast-region-max-width);\n  /* position: fixed 로 고정. 스크롤에 밀려 화면 밖으로 나가는 문제 있음 */\n  position: fixed;\n  z-index: 30;\n  /* 알림만 클릭 적용, 빈 공간은 차단 제외. 떠 있는 동안은 뒤 스택 규칙이 우선 적용 */\n  pointer-events: none;\n}\n.ods-toast-region > * { pointer-events: auto; }\n\n/* 가로는 inline-start/end 사용, 세로는 block 유지. 좌우만 뒤집음 */\n.ods-toast-region--top-start {\n  inset-block: var(--component-toast-region-inset) auto;\n  inset-inline: var(--component-toast-region-inset) auto;\n  align-items: flex-start;\n}\n.ods-toast-region--top-center {\n  inset-block: var(--component-toast-region-inset) auto;\n  inset-inline-start: 50%; translate: -50% 0;\n  align-items: center;\n}\n.ods-toast-region--top-end {\n  inset-block: var(--component-toast-region-inset) auto;\n  inset-inline: auto var(--component-toast-region-inset);\n  align-items: flex-end;\n}\n.ods-toast-region--bottom-start {\n  inset-block: auto var(--component-toast-region-inset);\n  inset-inline: var(--component-toast-region-inset) auto;\n  align-items: flex-start;\n}\n.ods-toast-region--bottom-center {\n  inset-block: auto var(--component-toast-region-inset);\n  inset-inline-start: 50%; translate: -50% 0;\n  align-items: center;\n}\n.ods-toast-region--bottom-end {\n  inset-block: auto var(--component-toast-region-inset);\n  inset-inline: auto var(--component-toast-region-inset);\n  align-items: flex-end;\n}\n.ods-toast {\n  display: flex; align-items: center;\n  gap: var(--component-toast-gap);\n  max-width: 100%;\n  padding-inline: var(--component-toast-padding-inline);\n  padding-block: var(--component-toast-padding-block);\n  background: var(--component-toast-bg);\n  color: var(--component-toast-fg);\n  /* 배경이 옅어 테두리로 경계 표시. 없으면 옅은 배경 위에서 알림 경계가 안 보임 */\n  border: var(--semantic-border-width-default) solid var(--component-toast-border);\n  border-radius: var(--component-toast-radius);\n  box-shadow: var(--component-toast-shadow);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-toast-font-size);\n  letter-spacing: var(--component-toast-letter-spacing);\n  line-height: var(--base-font-line-height-snug);\n}\n/* 알림 폭은 컨테이너가 아닌 알림 자신이 지정 */\n.ods-toast--fit { width: max-content; }\n.ods-toast--fixed { width: auto; align-self: stretch; }\n\n/* 동작 링크 글자색을 본문과 동일하게 유지. 흐린 색이면 사라지기 전에 못 찾는 문제 있음 */\n.ods-toast-action {\n  margin-left: auto; padding: 0; border: 0; background: transparent;\n  color: inherit;\n  font: inherit; font-weight: var(--base-font-weight-medium);\n  text-decoration: underline; text-underline-offset: 0.125rem;\n  white-space: nowrap; cursor: pointer;\n}\n.ods-toast-action:focus-visible { outline: 0.125rem solid currentColor; outline-offset: 0.125rem; }\n.ods-toast-icon { width: var(--component-toast-icon-size);\n  height: var(--component-toast-icon-size); flex-shrink: 0; stroke: currentColor;\n  fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n/* 버튼 안 아이콘은 별도 표시 크기 미적용, 텍스트 옆 장식으로만 처리 */\n.ods-toast-action svg { width: 1.15em; height: 1.15em; flex-shrink: 0; stroke: currentColor;\n  fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n\n/* 루트 모서리가 둥글어 overflow hidden 없으면 띠가 밖으로 새는 문제 있음 */\n.ods-toast { position: relative; overflow: hidden; }\n/* 아이콘과 닫기 버튼 첫 줄 기준 정렬. 가운데 정렬이면 제목과 어긋나는 문제 있음 */\n.ods-toast:has(.ods-toast-content) { align-items: flex-start; }\n.ods-toast-content {\n  display: flex; flex-direction: column;\n  gap: var(--component-toast-content-gap);\n  /* 긴 텍스트는 줄바꿈 처리, 상자 크기 고정 */\n  min-width: 0;\n}\n.ods-toast-title {\n  font-size: var(--component-toast-title-font-size);\n  font-weight: var(--base-font-weight-semibold);\n  line-height: var(--base-font-line-height-snug);\n  letter-spacing: var(--component-toast-title-letter-spacing);\n}\n.ods-toast-body {\n  font-size: var(--component-toast-body-font-size);\n  letter-spacing: var(--component-toast-body-letter-spacing);\n  font-weight: var(--base-font-weight-regular);\n  line-height: var(--base-font-line-height-normal);\n}\n/* 자동 소멸과 별개로 수동 닫기 버튼 추가 */\n.ods-toast-close {\n  margin-inline-start: auto; flex-shrink: 0;\n  inline-size: var(--component-toast-close-size);\n  block-size: var(--component-toast-close-size);\n  display: grid; place-items: center;\n  padding: 0; border: 0; background: none; cursor: pointer;\n  border-radius: var(--semantic-radius-pill);\n  color: var(--component-toast-close-fg);\n}\n.ods-toast-close:hover { color: var(--component-toast-close-fg-hover); }\n.ods-toast-close:focus-visible {\n  outline: 0.125rem solid currentColor; outline-offset: 0.125rem;\n}\n.ods-toast-close svg { width: 1.15em; height: 1.15em; stroke: currentColor;\n  fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n/* 동작 버튼 옆에 닫기 버튼 배치, 동작은 auto 폭 사용 */\n.ods-toast-action + .ods-toast-close { margin-inline-start: 0; }\n\n/* scaleX 축소 기준점 왼쪽 지정. 가운데면 닫히는 문처럼 보임 */\n.ods-toast-progress {\n  position: absolute; inset-inline: 0; inset-block-end: 0;\n  block-size: var(--component-toast-progress-height);\n  background: var(--component-toast-progress);\n  transform-origin: left center;\n  /* forwards 지정. 없으면 원래 폭으로 되돌아가는 문제 있음 */\n  animation: ods-toast-countdown var(--ods-toast-duration, 5000ms) linear forwards;\n}\n/* 정해진 시간 동안 한 번만 줄어드는 진행바 */\n@keyframes ods-toast-countdown {\n  from { transform: scaleX(1); }\n  to   { transform: scaleX(0); }\n}\n\n/* 알림 이동 방향은 배치 위치를 따라 지정. 값 고정이라 보간에 영향 없음 */\n.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end { --ods-toast-shift: -0.75rem; }\n.ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end { --ods-toast-shift: 0.75rem; }\n\n/* :where 사용. :is 는 특이도가 높아 leaving 규칙이 밀려 적용되지 않음 */\n:where(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end) > .ods-toast { animation: ods-toast-in 220ms cubic-bezier(0.22, 1, 0.36, 1) backwards; }\n\n/* reduced-motion 에서도 animation 유지. 제거 시 알림이 화면에 남음 */\n.ods-toast--leaving {\n  animation: ods-toast-out 180ms cubic-bezier(0.4, 0, 1, 1) both;\n  /* 사라지는 중 클릭 무시 처리. 막지 않으면 닫기가 중복 실행되는 문제가 있음 */\n  pointer-events: none;\n}\n\n/* 접힘은 음수 여백으로 축소. 높이도 줄이면 겹쳐쌓기와 이중 축소돼 문제 있음 */\n.ods-toast--leaving.ods-toast--collapsing {\n  animation: ods-toast-out 180ms cubic-bezier(0.4, 0, 1, 1) both,\n             ods-toast-collapse 180ms cubic-bezier(0.4, 0, 1, 1) both;\n}\n\n@keyframes ods-toast-in {\n  from { opacity: 0; transform: translateY(var(--ods-toast-shift, 0.75rem)) scale(0.96); }\n  to   { opacity: 1; transform: translateY(0) scale(1); }\n}\n@keyframes ods-toast-out {\n  from { opacity: 1; transform: translateY(0) scale(1); }\n  to   { opacity: 0; transform: translateY(var(--ods-toast-shift, 0.75rem)) scale(0.96); }\n}\n/* from 생략. 여백이 상태마다 달라 고정하면 틀리기 때문임 */\n@keyframes ods-toast-collapse {\n  /* 기본값 0px 지정. auto는 높이 보간이 되지 않음 */\n  to { margin-block-end: calc(-1 * (var(--ods-toast-h, 0px)\n                                     + var(--component-toast-stack-gap))); }\n}\n\n/* 모션 최소화 시 진행률 띠 숨김 처리. 줄어드는 것이 애니메이션이라 늦출 수 없기 때문임 */\n@media (prefers-reduced-motion: reduce) {\n  .ods-toast-progress { display: none; }\n  :where(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end) > .ods-toast { animation: ods-toast-fade-in 220ms cubic-bezier(0.22, 1, 0.36, 1) backwards; }\n  .ods-toast--leaving,\n  .ods-toast--leaving.ods-toast--collapsing {\n    animation: ods-toast-fade-out 180ms cubic-bezier(0.4, 0, 1, 1) both;\n  }\n}\n@keyframes ods-toast-fade-in { from { opacity: 0; } to { opacity: 1; } }\n@keyframes ods-toast-fade-out { from { opacity: 1; } to { opacity: 0; } }\n\n/* 알림 있을 때만 뒤 스택 영역에 호버 적용. 항상 적용하면 알림 사이 틈에서 호버가 끊겨 깜빡임 */\n.ods-toast-region:not(:empty) { pointer-events: auto; }\n\n:where(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end) > .ods-toast {\n  transition: margin 220ms cubic-bezier(0.22, 1, 0.36, 1), transform 220ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms cubic-bezier(0.22, 1, 0.36, 1);\n}\n/* 진입/퇴장 프레임엔 위치 전환 미적용. 레이아웃이 끝난 값을 전환이 뒤늦게 쫓아가 튀어 보임 */\n:is(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end).ods-toast-region--shifting > .ods-toast { transition-property: transform, opacity; }\n/* 축소 기준점은 앞쪽 요소가 있는 방향. 반대로 두면 뒤 요소가 다가오며 작아지는 것처럼 보임 */\n:where(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end) > .ods-toast { transform-origin: top center; }\n:where(.ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end) > .ods-toast { transform-origin: bottom center; }\n\n/* 여기는 :where 대신 일반 클래스 사용. 특이도 0 이면 밀려 반전이 풀리는 문제 있음 */\n.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end { flex-direction: column-reverse; }\n\n/* last-child 제외 높이 제거. 여백은 앞 요소를 향한 방향에서만 제거 */\n:is(.ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end):not(:hover):not(:focus-within) > .ods-toast:not(:last-child) { margin-block-end: calc(var(--component-toast-stack-peek) - var(--ods-toast-h, 0px) - var(--component-toast-stack-gap)); }\n:is(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end):not(:hover):not(:focus-within) > .ods-toast:not(:last-child) { margin-block-start: calc(var(--component-toast-stack-peek) - var(--ods-toast-h, 0px) - var(--component-toast-stack-gap)); }\n\n/* 뒤 카드일수록 크기 축소, 넷째부터 숨김 처리. 층수는 nth-last-child 로 계산 */\n:is(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end):not(:hover):not(:focus-within) > .ods-toast:nth-last-child(2) { transform: scale(0.96); }\n:is(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end):not(:hover):not(:focus-within) > .ods-toast:nth-last-child(3) { transform: scale(0.92); }\n:is(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end):not(:hover):not(:focus-within) > .ods-toast:nth-last-child(n+4) { opacity: 0; transform: scale(0.92); }\n\n/* 펼친 동안 타이머와 진행바 함께 멈추기. 어긋나면 사라지는 시점이 안 맞음 */\n:is(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end):is(:hover, :focus-within) .ods-toast-progress { animation-play-state: paused; }\n\n/* 모션 최소화해도 접기/펼치기 배치는 유지, 전환만 제거. 없애면 알림이 화면을 다 덮음 */\n@media (prefers-reduced-motion: reduce) {\n  :where(.ods-toast-region--top-start, .ods-toast-region--top-center, .ods-toast-region--top-end, .ods-toast-region--bottom-start, .ods-toast-region--bottom-center, .ods-toast-region--bottom-end) > .ods-toast { transition: none; }\n}\n.ods-toast--success {\n  background: var(--component-toast-success-bg);\n  color: var(--component-toast-success-fg);\n  border-color: var(--component-toast-success-border);\n}\n.ods-toast--success .ods-toast-progress { background: var(--component-toast-success-progress); }\n.ods-toast--danger {\n  background: var(--component-toast-danger-bg);\n  color: var(--component-toast-danger-fg);\n  border-color: var(--component-toast-danger-border);\n}\n.ods-toast--danger .ods-toast-progress { background: var(--component-toast-danger-progress); }\n.ods-toast--warning {\n  background: var(--component-toast-warning-bg);\n  color: var(--component-toast-warning-fg);\n  border-color: var(--component-toast-warning-border);\n}\n.ods-toast--warning .ods-toast-progress { background: var(--component-toast-warning-progress); }\n.ods-toast--info {\n  background: var(--component-toast-info-bg);\n  color: var(--component-toast-info-fg);\n  border-color: var(--component-toast-info-border);\n}\n.ods-toast--info .ods-toast-progress { background: var(--component-toast-info-progress); }\n"
