"/* Input control underline, 텍스트 입력과 textarea 공용 */\n\n.ods-input {\n  display: block; width: 100%;\n  background: var(--component-input-bg);\n  color: var(--component-input-fg);\n  font-family: var(--base-font-family-sans);\n  /* 한 줄 컨트롤은 snug 줄간격 사용. normal 은 둘째 줄이 없어 높이만 불필요하게 늘어나기 때문임 */\n  line-height: var(--base-font-line-height-snug);\n  border: 0;\n  border-bottom: var(--semantic-border-width-default) solid var(--component-input-border);\n  border-radius: 0;\n  transition: border-color 120ms ease, background-color 120ms ease;\n}\n.ods-input::placeholder { color: var(--component-input-fg-placeholder); }\n.ods-input:hover:not(:disabled) { border-color: var(--component-input-border-strong); }\n.ods-input:focus { outline: none; border-bottom-width: 0.125rem;\n  border-bottom-color: var(--component-input-border-focus); }\n.ods-input:disabled {\n  background: var(--component-input-disabled-bg);\n  color: var(--component-input-disabled-fg);\n  cursor: not-allowed;\n}\n.ods-input[aria-invalid=\"true\"] {\n  border-color: var(--component-input-border-invalid);\n}\ntextarea.ods-input { resize: vertical; min-height: 5em;\n  line-height: var(--base-font-line-height-normal); }\n\n.ods-input {\n  padding-inline: var(--component-input-padding-inline);\n  padding-block: var(--component-input-padding-block);\n  font-size: var(--component-input-font-size);\n  letter-spacing: var(--component-input-letter-spacing);\n}\n\n.ods-field { display: flex; flex-direction: column; gap: var(--component-input-label-gap); }\n.ods-field > label {\n  color: var(--component-input-label-fg);\n  font-size: var(--component-input-label-font-size);\n  letter-spacing: var(--component-input-label-letter-spacing);\n  font-weight: var(--base-font-weight-medium);\n}\n.ods-field > .ods-input-help {\n  color: var(--component-input-help-fg);\n  font-size: var(--component-input-help-font-size);\n  letter-spacing: var(--component-input-help-letter-spacing);\n}\n"
