"/* Progress 무한 진행바 reduced-motion 시 애니메이션 정지 처리 */\n\n.ods-progress { display: flex; flex-direction: column;\n  gap: var(--component-progress-gap);\n  font-family: var(--base-font-family-sans); }\n.ods-progress-head { display: flex; justify-content: space-between;\n  color: var(--component-progress-label-fg);\n  font-size: var(--component-progress-label-font-size);\n  letter-spacing: var(--component-progress-label-letter-spacing); }\n.ods-progress-track {\n  width: 100%; overflow: hidden;\n  height: var(--component-progress-height);\n  background: var(--component-progress-track-bg);\n  /* 고대비에서 배경이 구분 안 돼 안쪽 outline 으로 경계 표시. 높이가 값을 뜻해 두꺼워지면 안 되기 때문임 */\n  outline: var(--semantic-border-width-default) solid var(--component-progress-track-border);\n  outline-offset: var(--semantic-border-inset-default);\n  border-radius: var(--component-progress-radius);\n}\n.ods-progress--lg .ods-progress-track { height: var(--component-progress-height-lg); }\n.ods-progress-bar {\n  height: 100%;\n  background: var(--component-progress-indicator-bg);\n  border-radius: var(--component-progress-radius);\n  transition: width 240ms ease;\n}\n.ods-progress--indeterminate .ods-progress-bar {\n  width: 35%; animation: ods-progress-slide 1.4s ease-in-out infinite;\n}\n@keyframes ods-progress-slide {\n  0% { transform: translateX(-100%); }\n  100% { transform: translateX(340%); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .ods-progress--indeterminate .ods-progress-bar { animation: none; width: 100%; }\n}\n"
