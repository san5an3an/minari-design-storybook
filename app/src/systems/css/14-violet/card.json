"/* Card elevation 축: glow */\n\n.ods-card {\n  display: flex; flex-direction: column;\n  gap: var(--component-card-gap);\n  background: var(--component-card-bg);\n  border-radius: var(--component-card-radius);\n  padding: var(--component-card-padding);\n  font-family: var(--base-font-family-sans);\n  border: var(--semantic-border-width-default) solid var(--component-card-border);\n  box-shadow: var(--component-card-shadow);\n  transition: background-color 120ms ease;\n}\n.ods-card--interactive { cursor: pointer; }\n.ods-card--interactive:hover { background: var(--component-card-bg-hover); }\n.ods-card-title {\n  margin: 0;\n  color: var(--component-card-title-fg);\n  font-size: var(--component-card-title-font-size);\n  letter-spacing: var(--component-card-title-letter-spacing);\n  /* 제목과 본문 구분은 굵기 대신 색으로 표시 */\n  font-weight: var(--base-font-weight-medium);\n  line-height: var(--base-font-line-height-snug);\n}\n.ods-card-body {\n  margin: 0;\n  color: var(--component-card-body-fg);\n  font-size: var(--component-card-body-font-size);\n  letter-spacing: var(--component-card-body-letter-spacing);\n  line-height: var(--base-font-line-height-normal);\n}\n\n"
