"/* Button variant 4종 × role 7종 × size 3종 */\n\n.ods-btn {\n  display: inline-flex; align-items: center; justify-content: center;\n  gap: var(--component-button-gap);\n  border: var(--semantic-border-width-default) solid transparent;\n  border-radius: var(--component-button-radius);\n  font-family: var(--base-font-family-sans);\n  /* 제목과 본문 구분은 굵기 대신 색으로 표시 */\n  font-weight: var(--base-font-weight-medium);\n  line-height: var(--base-font-line-height-tight);\n  white-space: nowrap; cursor: pointer; user-select: none;\n  transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;\n}\n\n.ods-btn--sm {\n  padding-inline: var(--component-button-sm-padding-inline);\n  padding-block: var(--component-button-sm-padding-block);\n  font-size: var(--component-button-sm-font-size);\n  letter-spacing: var(--component-button-sm-letter-spacing);\n}\n.ods-btn--md {\n  padding-inline: var(--component-button-md-padding-inline);\n  padding-block: var(--component-button-md-padding-block);\n  font-size: var(--component-button-md-font-size);\n  letter-spacing: var(--component-button-md-letter-spacing);\n}\n.ods-btn--lg {\n  padding-inline: var(--component-button-lg-padding-inline);\n  padding-block: var(--component-button-lg-padding-block);\n  font-size: var(--component-button-lg-font-size);\n  letter-spacing: var(--component-button-lg-letter-spacing);\n}\n\n/* variant: solid */\n.ods-btn--solid.ods-btn--neutral { background: var(--component-button-solid-neutral-bg); color: var(--component-button-solid-neutral-fg); }\n.ods-btn--solid.ods-btn--neutral:hover { background: var(--component-button-solid-neutral-bg-hover); }\n.ods-btn--solid.ods-btn--brand { background: var(--component-button-solid-brand-bg); color: var(--component-button-solid-brand-fg); }\n.ods-btn--solid.ods-btn--brand:hover { background: var(--component-button-solid-brand-bg-hover); }\n.ods-btn--solid.ods-btn--danger { background: var(--component-button-solid-danger-bg); color: var(--component-button-solid-danger-fg); }\n.ods-btn--solid.ods-btn--danger:hover { background: var(--component-button-solid-danger-bg-hover); }\n.ods-btn--solid.ods-btn--success { background: var(--component-button-solid-success-bg); color: var(--component-button-solid-success-fg); }\n.ods-btn--solid.ods-btn--success:hover { background: var(--component-button-solid-success-bg-hover); }\n.ods-btn--solid.ods-btn--warning { background: var(--component-button-solid-warning-bg); color: var(--component-button-solid-warning-fg); }\n.ods-btn--solid.ods-btn--warning:hover { background: var(--component-button-solid-warning-bg-hover); }\n.ods-btn--solid.ods-btn--accent { background: var(--component-button-solid-accent-bg); color: var(--component-button-solid-accent-fg); }\n.ods-btn--solid.ods-btn--accent:hover { background: var(--component-button-solid-accent-bg-hover); }\n.ods-btn--solid.ods-btn--info { background: var(--component-button-solid-info-bg); color: var(--component-button-solid-info-fg); }\n.ods-btn--solid.ods-btn--info:hover { background: var(--component-button-solid-info-bg-hover); }\n\n/* variant: subtle */\n.ods-btn--subtle.ods-btn--neutral { background: var(--component-button-subtle-neutral-bg); color: var(--component-button-subtle-neutral-fg); border-color: var(--component-button-subtle-neutral-border); }\n.ods-btn--subtle.ods-btn--neutral:hover { background: var(--component-button-subtle-neutral-bg-hover); }\n.ods-btn--subtle.ods-btn--brand { background: var(--component-button-subtle-brand-bg); color: var(--component-button-subtle-brand-fg); border-color: var(--component-button-subtle-brand-border); }\n.ods-btn--subtle.ods-btn--brand:hover { background: var(--component-button-subtle-brand-bg-hover); }\n.ods-btn--subtle.ods-btn--danger { background: var(--component-button-subtle-danger-bg); color: var(--component-button-subtle-danger-fg); border-color: var(--component-button-subtle-danger-border); }\n.ods-btn--subtle.ods-btn--danger:hover { background: var(--component-button-subtle-danger-bg-hover); }\n.ods-btn--subtle.ods-btn--success { background: var(--component-button-subtle-success-bg); color: var(--component-button-subtle-success-fg); border-color: var(--component-button-subtle-success-border); }\n.ods-btn--subtle.ods-btn--success:hover { background: var(--component-button-subtle-success-bg-hover); }\n.ods-btn--subtle.ods-btn--warning { background: var(--component-button-subtle-warning-bg); color: var(--component-button-subtle-warning-fg); border-color: var(--component-button-subtle-warning-border); }\n.ods-btn--subtle.ods-btn--warning:hover { background: var(--component-button-subtle-warning-bg-hover); }\n.ods-btn--subtle.ods-btn--accent { background: var(--component-button-subtle-accent-bg); color: var(--component-button-subtle-accent-fg); border-color: var(--component-button-subtle-accent-border); }\n.ods-btn--subtle.ods-btn--accent:hover { background: var(--component-button-subtle-accent-bg-hover); }\n.ods-btn--subtle.ods-btn--info { background: var(--component-button-subtle-info-bg); color: var(--component-button-subtle-info-fg); border-color: var(--component-button-subtle-info-border); }\n.ods-btn--subtle.ods-btn--info:hover { background: var(--component-button-subtle-info-bg-hover); }\n\n/* variant: surface */\n.ods-btn--surface.ods-btn--neutral { background: var(--component-button-surface-neutral-bg); color: var(--component-button-surface-neutral-fg); border-color: var(--component-button-surface-neutral-border); }\n.ods-btn--surface.ods-btn--neutral:hover { background: var(--component-button-surface-neutral-bg-hover); }\n.ods-btn--surface.ods-btn--brand { background: var(--component-button-surface-brand-bg); color: var(--component-button-surface-brand-fg); border-color: var(--component-button-surface-brand-border); }\n.ods-btn--surface.ods-btn--brand:hover { background: var(--component-button-surface-brand-bg-hover); }\n.ods-btn--surface.ods-btn--danger { background: var(--component-button-surface-danger-bg); color: var(--component-button-surface-danger-fg); border-color: var(--component-button-surface-danger-border); }\n.ods-btn--surface.ods-btn--danger:hover { background: var(--component-button-surface-danger-bg-hover); }\n.ods-btn--surface.ods-btn--success { background: var(--component-button-surface-success-bg); color: var(--component-button-surface-success-fg); border-color: var(--component-button-surface-success-border); }\n.ods-btn--surface.ods-btn--success:hover { background: var(--component-button-surface-success-bg-hover); }\n.ods-btn--surface.ods-btn--warning { background: var(--component-button-surface-warning-bg); color: var(--component-button-surface-warning-fg); border-color: var(--component-button-surface-warning-border); }\n.ods-btn--surface.ods-btn--warning:hover { background: var(--component-button-surface-warning-bg-hover); }\n.ods-btn--surface.ods-btn--accent { background: var(--component-button-surface-accent-bg); color: var(--component-button-surface-accent-fg); border-color: var(--component-button-surface-accent-border); }\n.ods-btn--surface.ods-btn--accent:hover { background: var(--component-button-surface-accent-bg-hover); }\n.ods-btn--surface.ods-btn--info { background: var(--component-button-surface-info-bg); color: var(--component-button-surface-info-fg); border-color: var(--component-button-surface-info-border); }\n.ods-btn--surface.ods-btn--info:hover { background: var(--component-button-surface-info-bg-hover); }\n\n/* variant: plain */\n.ods-btn--plain { background: transparent; }\n.ods-btn--plain.ods-btn--neutral { color: var(--component-button-plain-neutral-fg); }\n.ods-btn--plain.ods-btn--neutral:hover { background: var(--component-button-plain-neutral-bg-hover); }\n.ods-btn--plain.ods-btn--brand { color: var(--component-button-plain-brand-fg); }\n.ods-btn--plain.ods-btn--brand:hover { background: var(--component-button-plain-brand-bg-hover); }\n.ods-btn--plain.ods-btn--danger { color: var(--component-button-plain-danger-fg); }\n.ods-btn--plain.ods-btn--danger:hover { background: var(--component-button-plain-danger-bg-hover); }\n.ods-btn--plain.ods-btn--success { color: var(--component-button-plain-success-fg); }\n.ods-btn--plain.ods-btn--success:hover { background: var(--component-button-plain-success-bg-hover); }\n.ods-btn--plain.ods-btn--warning { color: var(--component-button-plain-warning-fg); }\n.ods-btn--plain.ods-btn--warning:hover { background: var(--component-button-plain-warning-bg-hover); }\n.ods-btn--plain.ods-btn--accent { color: var(--component-button-plain-accent-fg); }\n.ods-btn--plain.ods-btn--accent:hover { background: var(--component-button-plain-accent-bg-hover); }\n.ods-btn--plain.ods-btn--info { color: var(--component-button-plain-info-fg); }\n.ods-btn--plain.ods-btn--info:hover { background: var(--component-button-plain-info-bg-hover); }\n\n.ods-btn:focus-visible {\n  outline: var(--component-button-focus-ring-width) solid var(--component-button-focus-ring);\n  outline-offset: 0.125rem;\n}\n.ods-btn:disabled, .ods-btn[aria-disabled=\"true\"] {\n  background: var(--component-button-disabled-bg) !important;\n  color: var(--component-button-disabled-fg) !important;\n  /* 테두리 유지. 고대비에서 지우면 버튼이 안 보임 */\n  border-color: var(--component-button-disabled-border) !important;\n  cursor: not-allowed;\n}\n.ods-btn > svg { width: 1em; height: 1em; flex-shrink: 0; stroke: currentColor; fill: none; }\n"
