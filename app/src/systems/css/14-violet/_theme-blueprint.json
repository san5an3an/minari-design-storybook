"/* @interop Blueprint 기반 Violet 테마 지정 */\n:root {\n  --bp-intent-primary-rest       : var(--semantic-bg-brand-default);\n  --bp-intent-primary-hover      : var(--semantic-bg-brand-strong);\n  --bp-intent-primary-active     : var(--base-color-brand-11);\n  --bp-intent-primary-disabled   : var(--base-color-brand-7);\n  --bp-intent-primary-foreground : var(--semantic-fg-on-brand-default);\n  --bp-intent-default-rest       : var(--semantic-bg-neutral-default);\n  --bp-intent-default-hover      : var(--semantic-bg-neutral-strong);\n  --bp-intent-default-active     : var(--base-color-neutral-11);\n  --bp-intent-default-disabled   : var(--base-color-neutral-7);\n  --bp-intent-default-foreground : var(--semantic-fg-on-neutral-default);\n  --bp-intent-success-rest       : var(--semantic-bg-success-default);\n  --bp-intent-success-hover      : var(--semantic-bg-success-strong);\n  --bp-intent-success-active     : var(--base-color-success-11);\n  --bp-intent-success-disabled   : var(--base-color-success-7);\n  --bp-intent-success-foreground : var(--semantic-fg-on-success-default);\n  --bp-intent-warning-rest       : var(--semantic-bg-warning-default);\n  --bp-intent-warning-hover      : var(--semantic-bg-warning-strong);\n  --bp-intent-warning-active     : var(--base-color-warning-11);\n  --bp-intent-warning-disabled   : var(--base-color-warning-7);\n  --bp-intent-warning-foreground : var(--semantic-fg-on-warning-default);\n  --bp-intent-danger-rest        : var(--semantic-bg-danger-default);\n  --bp-intent-danger-hover       : var(--semantic-bg-danger-strong);\n  --bp-intent-danger-active      : var(--base-color-danger-11);\n  --bp-intent-danger-disabled    : var(--base-color-danger-7);\n  --bp-intent-danger-foreground  : var(--semantic-fg-on-danger-default);\n  --bp-emphasis-focus-color      : var(--semantic-border-focus-default);\n  --bp-surface-border-radius     : var(--semantic-radius-control);\n  --bp-surface-border-width      : var(--semantic-border-width-default);\n  --bp-surface-spacing           : calc(var(--semantic-space-md) / 4);\n}\n"
