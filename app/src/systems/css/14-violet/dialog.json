"/* Dialog 확인 버튼 오른쪽 고정, 버튼 그룹은 하단 우측 고정 */\n\n.ods-dialog-scrim {\n  display: flex; align-items: center; justify-content: center;\n  padding: var(--component-dialog-padding);\n  background: var(--component-dialog-scrim);\n}\n.ods-dialog {\n  display: flex; flex-direction: column;\n  gap: var(--component-dialog-gap);\n  width: min(100%, 22rem);\n  padding: var(--component-dialog-padding);\n  background: var(--component-dialog-bg);\n  border: var(--semantic-border-width-default) solid var(--component-dialog-border);\n  border-radius: var(--component-dialog-radius);\n  box-shadow: var(--component-dialog-shadow);\n  font-family: var(--base-font-family-sans);\n}\n/* 아이콘 마커와 2열 배치 제거. AlertDialog 쪽과 중복하면 어긋나는 문제 있음 */\n.ods-dialog-title { margin: 0;\n  color: var(--component-dialog-title-fg);\n  font-size: var(--component-dialog-title-font-size);\n  letter-spacing: var(--component-dialog-title-letter-spacing);\n  /* 제목과 본문 구분은 굵기 대신 색으로 표시 */\n  font-weight: var(--base-font-weight-medium);\n  line-height: var(--base-font-line-height-snug); }\n.ods-dialog-body { margin: 0;\n  color: var(--component-dialog-body-fg);\n  font-size: var(--component-dialog-body-font-size);\n  letter-spacing: var(--component-dialog-body-letter-spacing);\n  line-height: var(--base-font-line-height-normal); }\n\n/* 버튼 그룹은 flex-end 로 하단 우측 고정 정렬 */\n/* 버튼 영역을 가장자리까지 확장해 구분선 적용 */\n.ods-dialog-actions {\n  display: flex; align-items: center;\n  justify-content: flex-end;\n  gap: var(--component-dialog-actions-gap);\n  margin-top: var(--component-dialog-actions-margin-top);\n  margin-inline: calc(-1 * var(--component-dialog-padding));\n  margin-bottom: calc(-1 * var(--component-dialog-padding));\n  padding: var(--component-dialog-padding);\n  background: var(--component-dialog-actions-bg);\n  border-top: var(--semantic-border-width-default) solid\n              var(--component-dialog-actions-border);\n  border-end-start-radius: var(--component-dialog-radius);\n  border-end-end-radius: var(--component-dialog-radius);\n}\n/* 3개 이상이거나 길면 세로 배치, column-reverse 로 확인 위, 취소 아래 배치 */\n.ods-dialog-actions--stacked {\n  flex-direction: column-reverse; align-items: stretch;\n}\n.ods-dialog-actions--stacked > .ods-btn { width: 100%; }\n"
