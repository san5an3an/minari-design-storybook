"/* 핸들 오른쪽이 켜짐 상태, 방향 고정 */\n\n.ods-switch { display: inline-flex; align-items: center;\n  gap: var(--component-switch-gap); cursor: pointer;\n  color: var(--component-switch-label-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-switch-label-font-size);\n  letter-spacing: var(--component-switch-label-letter-spacing); }\n.ods-switch > input { position: absolute; opacity: 0; width: 0; height: 0; }\n.ods-switch > .ods-switch-track {\n  position: relative; flex-shrink: 0; display: block;\n  width: var(--component-switch-track-width);\n  height: var(--component-switch-track-height);\n  background: var(--component-switch-bg-off);\n  border: var(--semantic-border-width-default) solid var(--component-switch-border-off);\n  border-radius: var(--semantic-radius-pill);\n  transition: background-color 140ms ease, border-color 140ms ease;\n}\n.ods-switch > .ods-switch-track::after {\n  content: \"\"; position: absolute; top: 50%;\n  /* 여백은 토큰으로 계산. 상수로 고정하면 하한에서 핸들이 삐져나오는 문제 있음 */\n  left: var(--component-switch-thumb-inset);\n  width: var(--component-switch-thumb-size);\n  height: var(--component-switch-thumb-size);\n  background: var(--component-switch-thumb-off);\n  border: var(--semantic-border-width-default) solid var(--component-switch-thumb-edge);\n  border-radius: var(--semantic-radius-pill);\n  transform: translateY(-50%);\n  transition: transform 140ms ease, background-color 140ms ease;\n}\n/* 켜짐 시 핸들 위치를 오른쪽으로 변경 */\n.ods-switch > input:checked + .ods-switch-track {\n  background: var(--component-switch-bg-on);\n  border-color: var(--component-switch-bg-on);\n}\n.ods-switch > input:checked + .ods-switch-track::after {\n  background: var(--component-switch-thumb-on);\n  transform: translateY(-50%)\n    translateX(calc(var(--component-switch-track-width) - var(--component-switch-track-height)));\n}\n/* 비활성 요소 hover 제외. 빼면 hover 가 우선 적용돼 눌리는 것처럼 보임 */\n/* hover 상태 없음 */\n.ods-switch > input:focus-visible + .ods-switch-track {\n  outline: 0.125rem solid var(--component-switch-border-focus); outline-offset: 0.125rem; }\n.ods-switch > input:disabled + .ods-switch-track {\n  background: var(--component-switch-disabled-bg);\n  border-color: var(--component-switch-disabled-fg);\n}\n.ods-switch > input:disabled + .ods-switch-track::after {\n  background: var(--component-switch-disabled-fg); }\n.ods-switch:has(input:disabled) { color: var(--component-switch-disabled-fg); cursor: not-allowed; }\n\n/* 오류를 테두리, 외곽선, 라벨 색으로 표시 */\n.ods-switch > input[aria-invalid=\"true\"] + .ods-switch-track {\n  border-color: var(--component-switch-border-invalid); }\n.ods-switch:has(input[aria-invalid=\"true\"]) {\n  color: var(--component-switch-label-fg-invalid); }\n\n/* 카드 전체를 클릭 영역으로 지정, 스위치는 오른쪽 끝에 배치. 켜짐은 테두리로 표시 */\n.ods-switch-card {\n  display: flex; align-items: center; justify-content: space-between;\n  gap: var(--component-switch-card-gap);\n  padding: var(--component-switch-card-padding);\n  background: var(--component-switch-card-bg);\n  border: var(--semantic-border-width-default) solid var(--component-switch-card-border);\n  border-radius: var(--component-switch-card-radius);\n  cursor: pointer;\n  transition: background-color 140ms ease, border-color 140ms ease;\n}\n.ods-switch-card:hover:not(:has(input:disabled)) {\n  background: var(--component-switch-card-bg-hover); }\n.ods-switch-card:has(input:checked) {\n  border-color: var(--component-switch-card-border-checked); }\n.ods-switch-card:has(input:disabled) { cursor: not-allowed; }\n/* 카드 내 스위치는 테두리 재적용에서 제외 */\n.ods-switch-card > .ods-switch { display: contents; }\n\n/* 라벨 아래 한 줄에 배치 */\n.ods-switch-description { display: block;\n  color: var(--component-switch-description-fg);\n  font-size: var(--component-switch-description-font-size);\n  letter-spacing: var(--component-switch-description-letter-spacing); }\n\n/* 크기별 트랙, 핸들 크기. 값은 모두 토큰 사용 */\n.ods-switch--sm > .ods-switch-track {\n  height: var(--component-switch-sm-track-height);\n  width: var(--component-switch-sm-track-width); }\n.ods-switch--sm > .ods-switch-track::after {\n  width: var(--component-switch-sm-thumb-size);\n  height: var(--component-switch-sm-thumb-size);\n  left: var(--component-switch-sm-thumb-inset); }\n.ods-switch--sm > input:checked + .ods-switch-track::after {\n  transform: translateY(-50%)\n    translateX(calc(var(--component-switch-sm-track-width) - var(--component-switch-sm-track-height))); }\n.ods-switch--md > .ods-switch-track {\n  height: var(--component-switch-md-track-height);\n  width: var(--component-switch-md-track-width); }\n.ods-switch--md > .ods-switch-track::after {\n  width: var(--component-switch-md-thumb-size);\n  height: var(--component-switch-md-thumb-size);\n  left: var(--component-switch-md-thumb-inset); }\n.ods-switch--md > input:checked + .ods-switch-track::after {\n  transform: translateY(-50%)\n    translateX(calc(var(--component-switch-md-track-width) - var(--component-switch-md-track-height))); }\n"
