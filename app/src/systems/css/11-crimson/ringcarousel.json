"/* 색과 치수 값을 셰이더가 사용 */\n\n.ods-ringcarousel {\n  position: relative; display: block; inline-size: 100%;\n  /* min-block-size 는 작게 유지. 좁은 곳에서 링 넘쳐 라벨 어긋나는 문제 있음 */\n  block-size: 100%; min-block-size: 6rem;\n  background: var(--component-ringcarousel-page);\n  overflow: hidden;\n  touch-action: pan-y;\n}\n/* 캔버스는 CSS 픽셀 크기 지정, 해상도는 devicePixelRatio 로 보정. 생략 시 기본값이 확대돼 흐려 보임 */\n.ods-ringcarousel > canvas {\n  position: absolute; inset: 0;\n  inline-size: 100%; block-size: 100%;\n  display: block;\n}\n.ods-ringcarousel-label, .ods-ringcarousel-index {\n  position: absolute; z-index: 1;\n  font-family: var(--base-font-family-sans);\n  pointer-events: none;\n}\n.ods-ringcarousel-label {\n  inset-block-end: var(--component-ringcarousel-gap);\n  inset-inline-start: var(--component-ringcarousel-gap);\n  color: var(--component-ringcarousel-label-fg);\n  font-size: var(--component-ringcarousel-label-font-size);\n  letter-spacing: var(--component-ringcarousel-label-letter-spacing);\n  font-weight: var(--base-font-weight-medium);\n  line-height: var(--base-font-line-height-tight);\n}\n.ods-ringcarousel-index {\n  inset-block-start: var(--component-ringcarousel-gap);\n  inset-inline-end: var(--component-ringcarousel-gap);\n  color: var(--component-ringcarousel-index-fg);\n  font-size: var(--component-ringcarousel-index-font-size);\n  letter-spacing: var(--component-ringcarousel-index-letter-spacing);\n  font-family: var(--base-font-family-mono);\n  font-variant-numeric: tabular-nums;\n}\n/* WebGL 없거나 모션 축소 시 대체 표시. 없으면 화면이 빈 채로 남음 */\n.ods-ringcarousel-fallback {\n  position: absolute; inset: 0; z-index: 2;\n  display: flex; flex-direction: column; justify-content: center;\n  gap: var(--component-ringcarousel-gap);\n  padding: var(--component-ringcarousel-gap);\n  background: var(--component-ringcarousel-page);\n  color: var(--component-ringcarousel-label-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-ringcarousel-label-font-size);\n  letter-spacing: var(--component-ringcarousel-label-letter-spacing);\n  overflow: auto;\n}\n@media (prefers-reduced-motion: reduce) {\n  .ods-ringcarousel > canvas { display: none; }\n}\n"
