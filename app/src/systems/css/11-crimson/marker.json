"/* 말풍선보다 약한 강조로 텍스트 흐름 안에서 유지 */\n\n.ods-marker {\n  display: flex; align-items: center;\n  gap: var(--component-marker-gap);\n  color: var(--component-marker-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-marker-font-size);\n  letter-spacing: var(--component-marker-letter-spacing);\n  line-height: var(--base-font-line-height-normal);\n}\n.ods-marker--default { justify-content: flex-start; }\n.ods-marker--border {\n  padding-block-end: var(--component-marker-padding-block);\n  border-block-end: var(--semantic-border-width-default) solid var(--component-marker-border);\n}\n.ods-marker--separator { justify-content: center; gap: var(--component-marker-separator-gap); }\n.ods-marker--separator::before,\n.ods-marker--separator::after {\n  content: \"\"; flex: 1 1 0;\n  block-size: var(--semantic-border-width-default);\n  background: var(--component-marker-line);\n}\n.ods-marker-icon { display: inline-flex; flex: 0 0 auto; }\n.ods-marker-icon svg { width: 1em; height: 1em; stroke: currentColor; fill: none;\n  stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }\n.ods-marker-content { min-width: 0; }\n"
