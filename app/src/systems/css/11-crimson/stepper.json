"/* control 축 underline 적용, 값은 mono 서체로 정렬 */\n\n.ods-stepper {\n  display: inline-flex; align-items: stretch;\n  background: var(--component-stepper-bg);\n  font-family: var(--base-font-family-sans);\n  overflow: hidden;\n  border: 0;\n  border-bottom: var(--semantic-border-width-default) solid var(--component-stepper-border);\n  border-radius: 0;\n}\n.ods-stepper:focus-within { border-color: var(--component-stepper-border-focus); }\n.ods-stepper > button {\n  border: 0; background: transparent; cursor: pointer;\n  padding-inline: var(--component-stepper-btn-padding);\n  color: var(--component-stepper-btn-fg);\n  font-size: var(--component-stepper-font-size);\n  letter-spacing: var(--component-stepper-letter-spacing);\n  line-height: 1;\n  transition: background-color 120ms ease, color 120ms ease;\n}\n.ods-stepper > button:hover:not(:disabled) {\n  background: var(--component-stepper-btn-bg-hover);\n  color: var(--component-stepper-btn-fg-hover);\n}\n.ods-stepper > button:disabled { color: var(--component-stepper-disabled-fg); cursor: not-allowed; }\n.ods-stepper > input {\n  width: 3.5em; border: 0; background: transparent; text-align: center;\n  color: var(--component-stepper-fg);\n  font-family: var(--base-font-family-mono);\n  font-size: var(--component-stepper-font-size);\n  letter-spacing: var(--component-stepper-letter-spacing);\n  padding-block: var(--component-stepper-btn-padding);\n}\n.ods-stepper > input:focus { outline: none; }\n.ods-stepper > input::-webkit-outer-spin-button,\n.ods-stepper > input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }\n"
