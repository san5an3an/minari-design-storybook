"/* role 5종 지원, 왼쪽 강조선으로 경계 표시 */\n\n.ods-alert {\n  /* 동작 버튼 절대 위치 기준점 지정 */\n  position: relative;\n  display: flex; align-items: flex-start;\n  gap: var(--component-alert-gap);\n  padding: var(--component-alert-padding);\n  border-radius: var(--component-alert-radius);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-alert-font-size);\n  letter-spacing: var(--component-alert-letter-spacing);\n  line-height: var(--base-font-line-height-normal);\n  border: 0; border-left: 0.1875rem solid var(--component-alert-neutral-border);\n}\n.ods-alert > svg { width: 1.25em; height: 1.25em; flex-shrink: 0; margin-top: .1em;\n  stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n.ods-alert-title { display: block; margin: 0 0 .25em;\n  font-size: var(--component-alert-title-font-size);\n  letter-spacing: var(--component-alert-title-letter-spacing);\n  /* 제목과 본문 구분은 굵기 대신 색으로 표시 */\n  font-weight: var(--base-font-weight-medium); }\n.ods-alert--neutral { background: var(--component-alert-neutral-bg); color: var(--component-alert-neutral-fg); border-left-color: var(--component-alert-neutral-border); }\n.ods-alert--neutral > svg { color: var(--component-alert-neutral-icon); }\n.ods-alert--brand { background: var(--component-alert-brand-bg); color: var(--component-alert-brand-fg); border-left-color: var(--component-alert-brand-border); }\n.ods-alert--brand > svg { color: var(--component-alert-brand-icon); }\n.ods-alert--danger { background: var(--component-alert-danger-bg); color: var(--component-alert-danger-fg); border-left-color: var(--component-alert-danger-border); }\n.ods-alert--danger > svg { color: var(--component-alert-danger-icon); }\n.ods-alert--success { background: var(--component-alert-success-bg); color: var(--component-alert-success-fg); border-left-color: var(--component-alert-success-border); }\n.ods-alert--success > svg { color: var(--component-alert-success-icon); }\n.ods-alert--warning { background: var(--component-alert-warning-bg); color: var(--component-alert-warning-fg); border-left-color: var(--component-alert-warning-border); }\n.ods-alert--warning > svg { color: var(--component-alert-warning-icon); }\n.ods-alert-icon { width: var(--component-alert-icon-size); height: var(--component-alert-icon-size); flex-shrink: 0; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n.ods-alert-description { color: var(--component-alert-description-fg); font-size: var(--component-alert-description-font-size);\n letter-spacing: var(--component-alert-description-letter-spacing); }\n.ods-alert-action { position: absolute; inset-block-start: var(--component-alert-action-inset); inset-inline-end: var(--component-alert-action-inset); margin: 0; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; font-weight: var(--base-font-weight-medium); white-space: nowrap; cursor: pointer; }\n.ods-alert:has(.ods-alert-action) { padding-inline-end: var(--component-alert-action-reserve); }\n.ods-alert-action:focus-visible { outline: 0.125rem solid currentColor; outline-offset: 0.125rem; }\n"
