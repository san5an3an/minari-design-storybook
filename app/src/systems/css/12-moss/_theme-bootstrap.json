mantic-border-width-default);\n  --bs-border-radius-sm        : var(--semantic-radius-selection);\n  --bs-border-radius           : var(--semantic-radius-control);\n  --bs-border-radius-lg        : var(--semantic-radius-container);\n  --bs-border-radius-xl        : var(--semantic-radius-overlay);\n  --bs-border-radius-pill      : var(--semantic-radius-pill);\n  --bs-link-color              : var(--semantic-fg-brand-default);\n  --bs-link-hover-color        : var(--semantic-fg-brand-strong);\n  --bs-code-color              : var(--semantic-fg-danger-default);\n  --bs-highlight-bg            : var(--semantic-bg-warning-subtle);\n  --bs-light                   : var(--base-color-neutral-2);\n  --bs-dark                    : var(--base-color-neutral-12);\n  --bs-light-bg-subtle         : var(--base-color-neutral-1);\n  --bs-dark-bg-subtle          : var(--base-color-neutral-6);\n  --bs-light-border-subtle     : var(--base-color-neutral-4);\n  --bs-dark-border-subtle      : var(--base-color-neutral-8);\n  --bs-border-radius-xxl       : calc(var(--semantic-radius-overlay) * 2);\n  --bs-primary-rgb             : 115, 187, 173;\n  --bs-secondary-rgb           : 171, 175, 167;\n  --bs-success-rgb             : 81, 198, 114;\n  --bs-warning-rgb             : 218, 165, 0;\n  --bs-danger-rgb              : 201, 76, 73;\n  --bs-body-bg-rgb             : 253, 253, 252;\n  --bs-body-color-rgb          : 8, 9, 6;\n  --bs-emphasis-color-rgb      : 8, 9, 6;\n}\n\n.btn-primary {\n  --bs-btn-bg                  : var(--semantic-bg-brand-default);\n  --bs-btn-border-color        : var(--semantic-bg-brand-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-brand-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-brand-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-brand-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-brand-strong);\n}\n\n.btn-outline-primary {\n  --bs-btn-color                 : var(--semantic-bg-brand-default);\n  --bs-btn-border-color          : var(--semantic-border-brand-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-brand-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-brand-default);\n  --bs-btn-active-bg             : var(--semantic-bg-brand-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-brand-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-brand-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-brand-default);\n}\n\n.btn-secondary {\n  --bs-btn-bg                  : var(--semantic-bg-neutral-default);\n  --bs-btn-border-color        : var(--semantic-bg-neutral-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-neutral-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-neutral-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-neutral-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-neutral-strong);\n}\n\n.btn-outline-secondary {\n  --bs-btn-color                 : var(--semantic-bg-neutral-default);\n  --bs-btn-border-color          : var(--semantic-border-neutral-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-neutral-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-neutral-default);\n  --bs-btn-active-bg             : var(--semantic-bg-neutral-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-neutral-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-neutral-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-neutral-default);\n}\n\n.btn-success {\n  --bs-btn-bg                  : var(--semantic-bg-success-default);\n  --bs-btn-border-color        : var(--semantic-bg-success-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-success-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-success-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-success-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-success-strong);\n}\n\n.btn-outline-success {\n  --bs-btn-color                 : var(--semantic-bg-success-default);\n  --bs-btn-border-color          : var(--semantic-border-success-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-success-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-success-default);\n  --bs-btn-active-bg             : var(--semantic-bg-success-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-success-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-success-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-success-default);\n}\n\n.btn-warning {\n  --bs-btn-bg                  : var(--semantic-bg-warning-default);\n  --bs-btn-border-color        : var(--semantic-bg-warning-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-warning-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-warning-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-warning-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-warning-strong);\n}\n\n.btn-outline-warning {\n  --bs-btn-color                 : var(--semantic-bg-warning-default);\n  --bs-btn-border-color          : var(--semantic-border-warning-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-warning-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-warning-default);\n  --bs-btn-active-bg             : var(--semantic-bg-warning-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-warning-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-warning-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-warning-default);\n}\n\n.btn-danger {\n  --bs-btn-bg                  : var(--semantic-bg-danger-default);\n  --bs-btn-border-color        : var(--semantic-bg-danger-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-danger-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-danger-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-danger-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-danger-strong);\n}\n\n.btn-outline-danger {\n  --bs-btn-color                 : var(--semantic-bg-danger-default);\n  --bs-btn-border-color          : var(--semantic-border-danger-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-danger-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-danger-default);\n  --bs-btn-active-bg             : var(--semantic-bg-danger-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-danger-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-danger-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-danger-default);\n}\n\n.btn {\n  --bs-btn-padding-x : var(--component-button-md-padding-inline);\n  --bs-btn-padding-y : var(--component-button-md-padding-block);\n}\n\n.btn-lg, .btn-group-lg > .btn {\n  --bs-btn-padding-x : var(--component-button-lg-padding-inline);\n  --bs-btn-padding-y : var(--component-button-lg-padding-block);\n}\n\n.btn-sm, .btn-group-sm > .btn {\n  --bs-btn-padding-x : var(--component-button-sm-padding-inline);\n  --bs-btn-padding-y : var(--component-button-sm-padding-block);\n}\n\n.card {\n  --bs-card-border-radius       : var(--component-card-radius);\n  --bs-card-spacer-y            : var(--component-card-padding);\n  --bs-card-spacer-x            : var(--component-card-padding);\n  --bs-card-title-spacer-y      : var(--component-card-gap);\n  --bs-card-cap-padding-y       : var(--component-card-gap);\n  --bs-card-cap-padding-x       : var(--component-card-padding);\n  --bs-card-img-overlay-padding : var(--component-card-padding);\n  --bs-card-group-margin        : var(--semantic-space-md);\n  --bs-card-inner-border-radius : calc(var(--component-card-radius) - var(--bs-border-width));\n}\n\n.accordion {\n  --bs-accordion-border-radius       : var(--component-accordion-radius);\n  --bs-accordion-btn-padding-x       : var(--component-accordion-head-padding-inline);\n  --bs-accordion-btn-padding-y       : var(--component-accordion-head-padding-block);\n  --bs-accordion-body-padding-x      : var(--component-accordion-body-padding-inline);\n  --bs-accordion-body-padding-y      : var(--component-accordion-body-padding-block-end);\n  --bs-accordion-inner-border-radius : calc(var(--component-accordion-radius) - var(--bs-border-width));\n}\n\n.alert {\n  --bs-alert-border-radius : var(--component-alert-radius);\n  --bs-alert-padding-x     : var(--component-alert-padding);\n  --bs-alert-padding-y     : var(--component-alert-padding);\n  --bs-alert-margin-bottom : var(--semantic-space-md);\n}\n\n.badge {\n  --bs-badge-padding-x : var(--component-badge-padding-inline);\n  --bs-badge-padding-y : var(--component-badge-padding-block);\n}\n\n.dropdown-menu {\n  --bs-dropdown-border-radius       : var(--component-menu-radius);\n  --bs-dropdown-padding-y           : var(--component-menu-padding);\n  --bs-dropdown-divider-margin-y    : var(--component-menu-padding);\n  --bs-dropdown-item-padding-x      : var(--component-menu-item-padding-inline);\n  --bs-dropdown-item-padding-y      : var(--component-menu-item-padding-block);\n  --bs-dropdown-header-padding-x    : var(--component-menu-item-padding-inline);\n  --bs-dropdown-header-padding-y    : var(--component-menu-padding);\n  --bs-dropdown-inner-border-radius : calc(var(--component-menu-radius) - var(--bs-border-width));\n}\n\n.list-group {\n  --bs-list-group-border-radius  : var(--semantic-radius-container);\n  --bs-list-group-item-padding-x : var(--component-listrow-padding-inline);\n  --bs-list-group-item-padding-y : var(--component-listrow-padding-block);\n}\n\n.nav {\n  --bs-nav-link-padding-x : var(--component-tabs-padding-inline);\n  --bs-nav-link-padding-y : var(--component-tabs-padding-block);\n}\n\n.nav-underline {\n  --bs-nav-underline-gap : var(--component-tabs-gap);\n}\n\n.navbar-nav {\n  --bs-nav-link-padding-y : var(--component-tabs-padding-block);\n}\n\n.navbar {\n  --bs-navbar-padding-y          : var(--semantic-space-sm);\n  --bs-navbar-brand-padding-y    : var(--semantic-space-xs);\n  --bs-navbar-brand-margin-end   : var(--semantic-space-md);\n  --bs-navbar-nav-link-padding-x : var(--semantic-space-sm);\n  --bs-navbar-toggler-padding-y  : var(--semantic-pad-control-sm-block);\n  --bs-navbar-toggler-padding-x  : var(--semantic-pad-control-md-inline);\n}\n\n.pagination {\n  --bs-pagination-padding-x : var(--semantic-pad-control-md-inline);\n  --bs-pagination-padding-y : var(--semantic-pad-control-md-block);\n}\n\n.pagination-lg {\n  --bs-pagination-padding-x : var(--semantic-pad-control-lg-inline);\n  --bs-pagination-padding-y : var(--semantic-pad-control-lg-block);\n}\n\n.pagination-sm {\n  --bs-pagination-padding-x : var(--semantic-pad-control-sm-inline);\n  --bs-pagination-padding-y : var(--semantic-pad-control-sm-block);\n}\n\n.breadcrumb {\n  --bs-breadcrumb-item-padding-x : var(--component-breadcrumb-gap);\n}\n\n.toast {\n  --bs-toast-border-radius : var(--component-toast-radius);\n  --bs-toast-padding-x     : var(--component-toast-padding-inline);\n  --bs-toast-padding-y     : var(--component-toast-padding-block);\n}\n\n.tooltip {\n  --bs-tooltip-border-radius : var(--component-tooltip-radius);\n  --bs-tooltip-padding-x     : var(--component-tooltip-padding-inline);\n  --bs-tooltip-padding-y     : var(--component-tooltip-padding-block);\n}\n\n.popover {\n  --bs-popover-border-radius       : var(--component-popover-radius);\n  --bs-popover-header-padding-x    : var(--component-popover-padding);\n  --bs-popover-header-padding-y    : var(--component-popover-padding);\n  --bs-popover-body-padding-x      : var(--component-popover-padding);\n  --bs-popover-body-padding-y      : var(--component-popover-padding);\n  --bs-popover-inner-border-radius : calc(var(--component-popover-radius) - var(--bs-border-width));\n}\n\n.modal {\n  --bs-modal-border-radius       : var(--component-dialog-radius);\n  --bs-modal-padding             : var(--component-dialog-padding);\n  --bs-modal-header-padding      : var(--component-dialog-padding);\n  --bs-modal-header-padding-x    : var(--component-dialog-padding);\n  --bs-modal-header-padding-y    : var(--component-dialog-padding);\n  --bs-modal-inner-border-radius : calc(var(--component-dialog-radius) - var(--bs-border-width));\n}\n\n.offcanvas, .offcanvas-xxl, .offcanvas-xl, .offcanvas-lg, .offcanvas-md, .offcanvas-sm {\n  --bs-offcanvas-padding-x : var(--component-drawer-padding);\n  --bs-offcanvas-padding-y : var(--component-drawer-padding);\n}\n\n/* 모드마다 값 재지정. 삼중값은 상속되지 않음 */\n:root[data-theme=\"dark\"] {\n  --bs-primary-rgb        : 67, 139, 126;\n  --bs-secondary-rgb      : 124, 128, 120;\n  --bs-success-rgb        : 0, 147, 66;\n  --bs-warning-rgb        : 160, 120, 0;\n  --bs-danger-rgb         : 210, 84, 80;\n  --bs-body-bg-rgb        : 34, 34, 33;\n  --bs-body-color-rgb     : 248, 250, 246;\n  --bs-emphasis-color-rgb : 248, 250, 246;\n}\n\n/* 모드마다 값 재지정. 삼중값은 상속되지 않음 */\n:root[data-theme=\"high-contrast\"] {\n  --bs-primary-rgb        : 150, 214, 201;\n  --bs-secondary-rgb      : 199, 203, 195;\n  --bs-success-rgb        : 121, 222, 145;\n  --bs-warning-rgb        : 245, 194, 75;\n  --bs-danger-rgb         : 255, 184, 177;\n  --bs-body-bg-rgb        : 8, 8, 8;\n  --bs-body-color-rgb     : 239, 241, 237;\n  --bs-emphasis-color-rgb : 239, 241, 237;\n}\n"
