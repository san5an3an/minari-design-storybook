"/* variant solid, subtle × role 5종 */\n\n.ods-badge {\n  display: inline-flex; align-items: center; gap: var(--component-badge-gap);\n  padding-inline: var(--component-badge-padding-inline);\n  padding-block: var(--component-badge-padding-block);\n  border: var(--semantic-border-width-default) solid transparent;\n  border-radius: var(--component-badge-radius);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-badge-font-size);\n  letter-spacing: var(--component-badge-letter-spacing);\n  font-weight: var(--base-font-weight-medium);\n  line-height: var(--base-font-line-height-tight);\n  white-space: nowrap;\n}\n.ods-badge--solid.ods-badge--neutral { background: var(--component-badge-solid-neutral-bg); color: var(--component-badge-solid-neutral-fg); }\n.ods-badge--solid.ods-badge--brand { background: var(--component-badge-solid-brand-bg); color: var(--component-badge-solid-brand-fg); }\n.ods-badge--solid.ods-badge--danger { background: var(--component-badge-solid-danger-bg); color: var(--component-badge-solid-danger-fg); }\n.ods-badge--solid.ods-badge--success { background: var(--component-badge-solid-success-bg); color: var(--component-badge-solid-success-fg); }\n.ods-badge--solid.ods-badge--warning { background: var(--component-badge-solid-warning-bg); color: var(--component-badge-solid-warning-fg); }\n.ods-badge--subtle.ods-badge--neutral { background: var(--component-badge-subtle-neutral-bg); color: var(--component-badge-subtle-neutral-fg); border-color: var(--component-badge-subtle-neutral-border); }\n.ods-badge--subtle.ods-badge--brand { background: var(--component-badge-subtle-brand-bg); color: var(--component-badge-subtle-brand-fg); border-color: var(--component-badge-subtle-brand-border); }\n.ods-badge--subtle.ods-badge--danger { background: var(--component-badge-subtle-danger-bg); color: var(--component-badge-subtle-danger-fg); border-color: var(--component-badge-subtle-danger-border); }\n.ods-badge--subtle.ods-badge--success { background: var(--component-badge-subtle-success-bg); color: var(--component-badge-subtle-success-fg); border-color: var(--component-badge-subtle-success-border); }\n.ods-badge--subtle.ods-badge--warning { background: var(--component-badge-subtle-warning-bg); color: var(--component-badge-subtle-warning-fg); border-color: var(--component-badge-subtle-warning-border); }\n.ods-badge-icon { width: var(--component-badge-icon-size); height: var(--component-badge-icon-size); flex-shrink: 0; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n.ods-badge[data-icon=\"inline-end\"] { flex-direction: row-reverse; }\n"
