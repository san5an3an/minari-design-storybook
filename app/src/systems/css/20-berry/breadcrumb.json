"/* Breadcrumb 구분자 스크린리더에서 숨김 처리 */\n\n.ods-breadcrumb {\n  display: flex; align-items: center;\n  /* 한 행으로만 표시, 넘치면 줄바꿈 대신 가로 스크롤 처리 */\n  flex-wrap: nowrap;\n  overflow-x: auto; scrollbar-width: none;\n  list-style: none; margin: 0; padding: 0;\n  gap: var(--component-breadcrumb-gap);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-breadcrumb-font-size);\n  letter-spacing: var(--component-breadcrumb-letter-spacing);\n  line-height: var(--base-font-line-height-tight);\n}\n.ods-breadcrumb::-webkit-scrollbar { display: none; }\n/* 목록을 nav 로 감싸 현재 위치임을 전달. min-width:0 없으면 경로가 길 때 옆 요소를 밀어내는 문제가 있음 */\n.ods-breadcrumb-nav { min-width: 0; }\n.ods-breadcrumb > li {\n  display: flex; align-items: center; flex-shrink: 0;\n  gap: var(--component-breadcrumb-gap);\n  white-space: nowrap;\n}\n.ods-breadcrumb a {\n  display: inline-flex; align-items: center;\n  /* 클릭 영역을 글자 크기보다 넓게 지정 */\n  padding-block: var(--component-breadcrumb-tap-padding-block);\n  padding-inline: var(--component-breadcrumb-tap-padding-inline);\n  color: var(--component-breadcrumb-fg);\n  text-decoration: none;\n}\n.ods-breadcrumb a:hover { color: var(--component-breadcrumb-fg-hover); text-decoration: underline; }\n.ods-breadcrumb a:focus-visible { outline: 0.125rem solid var(--semantic-border-focus-default);\n  outline-offset: 0.0625rem; border-radius: var(--semantic-radius-control); }\n.ods-breadcrumb [aria-current=\"page\"] {\n  padding-inline: var(--component-breadcrumb-tap-padding-inline);\n  color: var(--component-breadcrumb-fg-current);\n  /* 현재 위치는 굵기 대신 색과 aria-current 로 표시 */\n  font-weight: var(--base-font-weight-regular);\n}\n/* li 앞에 구분자 추가, aria-hidden 으로 스크린리더 제외 */\n.ods-breadcrumb > li + li > .ods-breadcrumb-sep {\n  display: inline-flex; flex-shrink: 0;\n  width: 1em; height: 1em;\n  color: var(--component-breadcrumb-separator);\n  stroke: currentColor; fill: none; stroke-width: 2;\n  stroke-linecap: round; stroke-linejoin: round;\n}\n.ods-breadcrumb-ellipsis { color: var(--component-breadcrumb-fg);\n  padding-inline: var(--component-breadcrumb-tap-padding-inline); }\n.ods-breadcrumb .ods-breadcrumb-home { width: 1em; height: 1em;\n  stroke: currentColor; fill: none; stroke-width: 2;\n  stroke-linecap: round; stroke-linejoin: round; }\n"
