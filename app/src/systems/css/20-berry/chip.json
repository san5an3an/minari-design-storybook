"/* Chip 조작 가능 요소, Badge는 상태 표시 */\n\n.ods-chip {\n  display: inline-flex; align-items: center;\n  gap: var(--component-chip-gap);\n  padding-inline: var(--component-chip-padding-inline);\n  padding-block: var(--component-chip-padding-block);\n  background: var(--component-chip-bg);\n  color: var(--component-chip-fg);\n  border: var(--semantic-border-width-default) solid var(--component-chip-border);\n  border-radius: var(--component-chip-radius);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-chip-font-size);\n  letter-spacing: var(--component-chip-letter-spacing);\n  line-height: var(--base-font-line-height-tight);\n  cursor: pointer;\n  transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease,\n              transform 120ms ease;\n}\n.ods-chip:hover { background: var(--component-chip-bg-hover); }\n.ods-chip:focus-visible { outline: 0.125rem solid var(--component-chip-border-focus); outline-offset: 0.125rem; }\n.ods-chip[aria-pressed=\"true\"] {\n  background: var(--component-chip-bg-selected);\n  color: var(--component-chip-fg-selected);\n  border-color: var(--component-chip-border-selected);\n}\n.ods-chip svg { width: 1em; height: 1em; stroke: currentColor; fill: none; stroke-width: 2;\n  stroke-linecap: round; }\n.ods-chip-remove { display: inline-flex; border: 0; background: transparent; padding: 0;\n  color: inherit; cursor: pointer;\n  transition: transform 140ms ease, color 140ms ease; }\n\n/* 눌림 반응으로 클릭 가능함을 표시. 지우기 칩은 span이라 눌리지 않음 */\nbutton.ods-chip:active { transform: scale(0.97); }\n.ods-chip-remove:hover { transform: scale(1.15); }\n.ods-chip-remove:active { transform: scale(0.92); }\n\n/* transition 속성은 유지하고 움직임만 제거. 지우면 상태 변화를 눈으로 못 좇음 */\n@media (prefers-reduced-motion: reduce) {\n  .ods-chip, .ods-chip-remove { transition-duration: 1ms; }\n  button.ods-chip:active,\n  .ods-chip-remove:hover,\n  .ods-chip-remove:active { transform: none; }\n}\n"
