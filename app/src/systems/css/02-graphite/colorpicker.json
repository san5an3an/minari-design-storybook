"/* 상시 노출 컬러피커, 그라디언트 CSS 렌더링. 캔버스와 의존성 필요 없음 */\n\n/* rounded-2xl p-5 카드 레이아웃 유지. 없으면 배경과 경계 구분이 안 보임 */\n.ods-colorpicker {\n  padding: var(--component-colorpicker-card-pad);\n  border-radius: var(--component-colorpicker-card-radius);\n  border: var(--semantic-border-width-default) solid\n          var(--component-colorpicker-card-border);\n  background: var(--component-colorpicker-card-bg);\n  box-shadow: var(--component-colorpicker-card-shadow);\n  font-family: var(--base-font-family-sans);\n}\n.ods-colorpicker-hue { margin-block-start: var(--component-colorpicker-gap-lg); }\n.ods-colorpicker-alpha,\n.ods-colorpicker-row { margin-block-start: var(--component-colorpicker-gap-sm); }\n.ods-colorpicker-preview,\n.ods-colorpicker-swatches { margin-block-start: var(--component-colorpicker-gap-lg); }\n\n/* 배경의 검정, 흰색, 순색은 토큰이 아닌 수학적 값임 */\n.ods-colorpicker-area {\n  position: relative;\n  block-size: var(--component-colorpicker-area-height);\n  border-radius: max(0rem, calc(var(--component-colorpicker-card-radius) - var(--component-colorpicker-card-pad)));\n  cursor: crosshair; touch-action: none;\n  background:\n    linear-gradient(to top, #000, rgb(0 0 0 / 0)),\n    linear-gradient(to right, #fff, rgb(255 255 255 / 0)),\n    hsl(var(--ods-colorpicker-hue, 0) 100% 50%);\n}\n.ods-colorpicker-area:focus-visible {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n/* 테두리와 링 색은 토큰 대신 고정 색 사용. 임의 배경 위에선 토큰 색이 묻히는 문제 있음 */\n.ods-colorpicker-thumb {\n  position: absolute;\n  inline-size: var(--component-colorpicker-thumb-size);\n  block-size: var(--component-colorpicker-thumb-size);\n  inset-inline-start: var(--ods-colorpicker-x, 50%);\n  inset-block-start: var(--ods-colorpicker-y, 50%);\n  translate: -50% -50%;\n  border-radius: var(--semantic-radius-pill);\n  border: 0.125rem solid var(--component-colorpicker-thumb-border);\n  box-shadow: 0 0 0 0.0625rem var(--component-colorpicker-thumb-ring);\n  background: none; pointer-events: none;\n}\n\n/* 색상 띠 양 끝은 동일한 빨강. 색상값은 순환값이라 끝이 없음 */\n.ods-colorpicker-hue,\n.ods-colorpicker-alpha {\n  -webkit-appearance: none; appearance: none;\n  inline-size: 100%; block-size: var(--component-colorpicker-hue-height);\n  padding: 0; cursor: pointer;\n  border-radius: var(--semantic-radius-pill);\n}\n.ods-colorpicker-hue {\n  background: linear-gradient(to right,\n    hsl(0 100% 50%), hsl(60 100% 50%), hsl(120 100% 50%),\n    hsl(180 100% 50%), hsl(240 100% 50%), hsl(300 100% 50%), hsl(360 100% 50%));\n}\n/* 투명도 확인용 격자 배경 적용. 단색 배경에서는 투명 여부가 안 보임 */\n.ods-colorpicker-alpha {\n  background-image:\n    linear-gradient(to right, transparent, var(--ods-colorpicker-solid, #000)),\n    conic-gradient(var(--component-colorpicker-checker) 0 25%, transparent 0 50%,\n                   var(--component-colorpicker-checker) 0 75%, transparent 0);\n  background-size:\n    auto,\n    var(--component-colorpicker-checker-size) var(--component-colorpicker-checker-size);\n}\n.ods-colorpicker-hue::-webkit-slider-thumb,\n.ods-colorpicker-alpha::-webkit-slider-thumb {\n  -webkit-appearance: none; appearance: none;\n  inline-size: var(--component-colorpicker-slider-thumb-size);\n  block-size: var(--component-colorpicker-hue-height);\n  border-radius: var(--semantic-radius-pill);\n  border: 0.125rem solid var(--component-colorpicker-thumb-border);\n  box-shadow: 0 0 0 0.0625rem var(--component-colorpicker-thumb-ring);\n  background: none;\n}\n.ods-colorpicker-hue::-moz-range-thumb,\n.ods-colorpicker-alpha::-moz-range-thumb {\n  inline-size: var(--component-colorpicker-slider-thumb-size);\n  block-size: var(--component-colorpicker-hue-height);\n  border-radius: var(--semantic-radius-pill);\n  border: 0.125rem solid var(--component-colorpicker-thumb-border);\n  box-shadow: 0 0 0 0.0625rem var(--component-colorpicker-thumb-ring);\n  background: none;\n}\n/* 포커스 링은 슬라이더 핸들에 적용. 트랙이 받으면 띠 전체가 이중으로 보임 */\n.ods-colorpicker-hue:focus-visible,\n.ods-colorpicker-alpha:focus-visible { outline: none; }\n.ods-colorpicker-hue:focus-visible::-webkit-slider-thumb,\n.ods-colorpicker-alpha:focus-visible::-webkit-slider-thumb {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n.ods-colorpicker-hue:focus-visible::-moz-range-thumb,\n.ods-colorpicker-alpha:focus-visible::-moz-range-thumb {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n\n/* 현재 색상 원과 추가 버튼 통합, 스포이드는 반대쪽 끝에 고정 */\n.ods-colorpicker-preview {\n  display: flex; align-items: center;\n  gap: var(--component-colorpicker-row-gap);\n}\n.ods-colorpicker-current,\n.ods-colorpicker-pipette {\n  position: relative; flex: 0 0 auto;\n  inline-size: var(--component-colorpicker-preview-size);\n  block-size: var(--component-colorpicker-preview-size);\n  padding: 0; cursor: pointer;\n  border-radius: var(--semantic-radius-pill);\n  border: var(--semantic-border-width-default) solid\n          var(--component-colorpicker-preview-border);\n}\n/* 채움색은 호출 측에서 지정. 뒤 격자 배경으로 투명도 표시 */\n.ods-colorpicker-current {\n  background-image:\n    linear-gradient(var(--ods-colorpicker-swatch, transparent),\n                    var(--ods-colorpicker-swatch, transparent)),\n    conic-gradient(var(--component-colorpicker-checker) 0 25%, transparent 0 50%,\n                   var(--component-colorpicker-checker) 0 75%, transparent 0);\n  background-size:\n    auto,\n    var(--component-colorpicker-checker-size) var(--component-colorpicker-checker-size);\n}\n/* 한도 도달 버튼 aria-disabled 처리. disabled는 Tab 건너뛰어 못 읽음 */\n.ods-colorpicker-current[aria-disabled=\"true\"] { cursor: default; }\n/* 표시는 평소 숨김 처리. opacity 로 숨겨 공간은 유지, 클릭은 부모 버튼이 전달받기 */\n.ods-colorpicker-current-mark {\n  position: absolute; inset: 0;\n  display: grid; place-items: center;\n  border-radius: var(--semantic-radius-pill);\n  background: var(--component-colorpicker-scrim);\n  color: var(--component-colorpicker-mark-fg);\n  opacity: 0; pointer-events: none;\n}\n.ods-colorpicker-current:hover:not([aria-disabled=\"true\"]) .ods-colorpicker-current-mark,\n.ods-colorpicker-current:focus-visible .ods-colorpicker-current-mark { opacity: 1; }\n/* 값을 텍스트로도 표시. 색은 말로 전달 안 돼 스크린리더 사용자에게 유일한 정보임 */\n.ods-colorpicker-hex {\n  font-family: var(--base-font-family-mono);\n  font-size: var(--component-colorpicker-hex-font-size);\n  letter-spacing: var(--component-colorpicker-hex-letter-spacing);\n  color: var(--component-colorpicker-hex-fg);\n}\n/* 스포이드 아이콘 오른쪽 끝 정렬 */\n.ods-colorpicker-pipette {\n  margin-inline-start: auto;\n  display: grid; place-items: center;\n  background: none;\n  color: var(--component-colorpicker-field-fg);\n}\n.ods-colorpicker-icon {\n  inline-size: var(--component-colorpicker-icon-size);\n  block-size: var(--component-colorpicker-icon-size);\n  stroke: currentColor; fill: none; stroke-width: 2;\n  stroke-linecap: round; stroke-linejoin: round;\n}\n\n/* 형식, 값, 투명도를 한 행에 배치, 폭 넘으면 줄바꿈 처리 */\n.ods-colorpicker-row {\n  display: flex; align-items: center; flex-wrap: wrap;\n  gap: var(--component-colorpicker-row-gap);\n}\n.ods-colorpicker-format,\n.ods-colorpicker-field {\n  display: flex; align-items: center;\n  block-size: var(--component-colorpicker-field-height);\n  padding-inline: var(--component-colorpicker-field-pad-inline);\n  border-radius: max(0rem, calc(max(0rem, calc(var(--component-colorpicker-card-radius) - var(--component-colorpicker-card-pad))) - 0.25rem));\n  border: var(--semantic-border-width-default) solid\n          var(--component-colorpicker-field-border);\n  background: var(--component-colorpicker-field-bg);\n  color: var(--component-colorpicker-field-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-colorpicker-field-font-size);\n  letter-spacing: var(--component-colorpicker-field-letter-spacing);\n}\n/* 형식 버튼과 hex 필드만 한 단 넓음. 숫자 필드는 좁아야 셋이 한 행에 맞는 폭임 */\n.ods-colorpicker-format,\n.ods-colorpicker-field:not(.ods-colorpicker-field--num) {\n  padding-inline: var(--component-colorpicker-field-pad-wide);\n}\n.ods-colorpicker-format:hover,\n.ods-colorpicker-field:hover { border-color: var(--component-colorpicker-field-border-hover); }\n.ods-colorpicker-format:focus-visible,\n.ods-colorpicker-field:focus-within {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n\n/* 래퍼가 위치 기준 지정. button 중첩이 불가해 목록이 형제 요소여야 하기 때문임 */\n.ods-colorpicker-format-slot {\n  position: relative;\n  flex: 0 0 var(--component-colorpicker-format-width);\n}\n/* 형식 버튼 폭 고정. 위치 안 맞추면 옆 필드가 흔들리는 문제 있음 */\n.ods-colorpicker-format {\n  inline-size: 100%;\n  justify-content: space-between;\n  gap: var(--component-colorpicker-row-gap);\n  cursor: pointer;\n}\n/* 목록은 흐름 위에 표시. 차지하면 열 때마다 아래가 밀리는 문제 있음 */\n.ods-colorpicker-format-menu {\n  position: absolute; z-index: 1;\n  inset-inline-start: 0;\n  inset-block-start: calc(100% + var(--component-colorpicker-menu-offset));\n  min-inline-size: max(100%, var(--component-colorpicker-menu-min-width));\n  padding-block: var(--component-colorpicker-menu-pad-block);\n  border-radius: max(0rem, calc(max(0rem, calc(var(--component-colorpicker-card-radius) - var(--component-colorpicker-card-pad))) - 0.25rem));\n  border: var(--semantic-border-width-default) solid\n          var(--component-colorpicker-menu-border);\n  background: var(--component-colorpicker-menu-bg);\n  box-shadow: var(--component-colorpicker-menu-shadow);\n}\n.ods-colorpicker-format-option {\n  display: block; inline-size: 100%;\n  padding-inline: var(--component-colorpicker-field-pad-inline);\n  padding-block: var(--component-colorpicker-option-pad-block);\n  border: none; background: none; cursor: pointer;\n  text-align: start;\n  font-family: inherit;\n  font-size: var(--component-colorpicker-field-font-size);\n  letter-spacing: var(--component-colorpicker-field-letter-spacing);\n  color: var(--component-colorpicker-option-fg);\n}\n.ods-colorpicker-format-option:hover {\n  background: var(--component-colorpicker-option-bg-hover);\n}\n/* 선택 표시에 aria-selected 추가. 색만으론 인식 안 되는 문제 있음 */\n.ods-colorpicker-format-option[aria-selected=\"true\"] {\n  color: var(--component-colorpicker-option-fg-selected);\n}\n.ods-colorpicker-format-option:focus-visible {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n\n.ods-colorpicker-fields {\n  display: flex; align-items: center;\n  flex: 1 1 auto; min-inline-size: 0;\n  gap: var(--component-colorpicker-fields-gap);\n}\n.ods-colorpicker-field { gap: var(--component-colorpicker-label-gap); }\n/* 숫자 필드 세 개는 폭을 동일하게 증감. 다르면 한 행이 들쭉날쭉해 보임 */\n.ods-colorpicker-field--num { flex: 1 1 0; min-inline-size: 0; }\n/* 투명도 필드 폭 고정. 줄이면 100% 표기가 90%와 구별 안 되는 문제 있음 */\n.ods-colorpicker-field--alpha {\n  flex: 0 0 var(--component-colorpicker-alpha-width);\n  justify-content: end;\n}\n.ods-colorpicker-field-label {\n  flex: 0 0 auto;\n  font-size: var(--component-colorpicker-label-font-size);\n  letter-spacing: var(--component-colorpicker-label-letter-spacing);\n  color: var(--component-colorpicker-label-fg);\n  user-select: none;\n}\n/* 단위 기호는 입력값이 아닌 고정 표시. 값에 섞으면 지워질 수 있음 */\n.ods-colorpicker-field-affix {\n  flex: 0 0 auto;\n  color: var(--component-colorpicker-label-fg);\n  user-select: none;\n}\n/* 포커스 링은 :focus-within으로 상자에 적용. 입력에 적용하면 영역이 쪼개져 보임 */\n.ods-colorpicker-field-input {\n  inline-size: 100%; min-inline-size: 0;\n  padding: 0; border: none; background: none; outline: none;\n  color: inherit; font: inherit;\n}\n.ods-colorpicker-field--num .ods-colorpicker-field-input,\n.ods-colorpicker-field--alpha .ods-colorpicker-field-input { text-align: end; }\n\n/* 저장된 색 목록은 맨 아래에 배치 */\n.ods-colorpicker-swatches {\n  display: flex; flex-direction: column;\n  gap: var(--component-colorpicker-head-gap);\n  padding-block-start: var(--component-colorpicker-gap-lg);\n  border-block-start: var(--semantic-border-width-default) solid\n                      var(--component-colorpicker-divider);\n}\n/* 상한을 3/10 텍스트로 표시. 흐름 배치는 폭따라 줄 수 달라져 안 보이는 문제 있음 */\n.ods-colorpicker-swatches-head {\n  display: flex; align-items: baseline; justify-content: space-between;\n  font-size: var(--component-colorpicker-count-font-size);\n  letter-spacing: var(--component-colorpicker-count-letter-spacing);\n  color: var(--component-colorpicker-label-fg);\n}\n.ods-colorpicker-swatches-count { color: var(--component-colorpicker-count-fg); }\n.ods-colorpicker-swatch-grid {\n  display: flex; flex-wrap: wrap;\n  gap: var(--component-colorpicker-swatch-gap);\n}\n/* 래퍼가 위치 기준 지정. button 중첩 불가로 스와치와 목록이 형제여야 하기 때문임 */\n.ods-colorpicker-swatch-slot {\n  position: relative;\n  inline-size: var(--component-colorpicker-swatch-size);\n  block-size: var(--component-colorpicker-swatch-size);\n}\n/* 클릭 불가능한 스와치 표시 */\n.ods-colorpicker-swatch {\n  inline-size: var(--component-colorpicker-swatch-size);\n  block-size: var(--component-colorpicker-swatch-size);\n  border-radius: var(--semantic-radius-pill);\n  border: var(--semantic-border-width-default) solid\n          var(--component-colorpicker-swatch-border);\n  background-image:\n    linear-gradient(var(--ods-colorpicker-swatch, transparent),\n                    var(--ods-colorpicker-swatch, transparent)),\n    conic-gradient(var(--component-colorpicker-checker) 0 25%, transparent 0 50%,\n                   var(--component-colorpicker-checker) 0 75%, transparent 0);\n  background-size:\n    auto,\n    var(--component-colorpicker-checker-size) var(--component-colorpicker-checker-size);\n}\n/* 삭제 버튼이 스와치 전체를 덮도록 지정. opacity 0 이어도 클릭은 받음 */\n.ods-colorpicker-swatch-remove {\n  position: absolute; inset: 0;\n  display: grid; place-items: center;\n  padding: 0; cursor: pointer;\n  border: none; border-radius: var(--semantic-radius-pill);\n  background: var(--component-colorpicker-scrim);\n  color: var(--component-colorpicker-mark-fg);\n  opacity: 0;\n}\n/* hover 또는 focus-visible 시 표시. 표시와 링은 속성이 달라 규칙이 별도임 */\n.ods-colorpicker-swatch-slot:hover .ods-colorpicker-swatch-remove,\n.ods-colorpicker-swatch-remove:focus-visible { opacity: 1; }\n.ods-colorpicker-swatch-remove:focus-visible {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}"
