"/* subtle, subtlest 두 색 사이 애니메이션, 고대비 모드 대비 유지 */\n\n.ods-skeleton {\n  display: block;\n  background: var(--component-skeleton-bg);\n  /* 고대비에서 배경이 구분 안 돼 안쪽 outline 으로 경계 표시. 높이가 값을 뜻해 두꺼워지면 안 되기 때문임 */\n  outline: var(--semantic-border-width-default) solid var(--component-skeleton-border);\n  outline-offset: var(--semantic-border-inset-default);\n  border-radius: var(--component-skeleton-radius);\n  animation: ods-skeleton-pulse 1.6s ease-in-out infinite;\n}\n.ods-skeleton--text { height: var(--component-skeleton-bar-height); }\n.ods-skeleton--block { height: 8rem; border-radius: var(--component-skeleton-radius-block); }\n.ods-skeleton--circle { border-radius: var(--semantic-radius-pill); }\n.ods-skeleton-group { display: flex; flex-direction: column;\n  gap: var(--component-skeleton-gap); }\n@keyframes ods-skeleton-pulse {\n  0%, 100% { background: var(--component-skeleton-bg); }\n  50% { background: var(--component-skeleton-bg-highlight); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .ods-skeleton { animation: none; }\n}\n"
