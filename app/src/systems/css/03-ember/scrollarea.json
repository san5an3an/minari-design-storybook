"/* 넘치는 내용은 자체 스크롤 처리, 얇은 스크롤바 유지 */\n\n.ods-scrollarea {\n  position: relative; overflow: auto;\n  /* 막대 굵기는 px 고정값 사용. 밀도 스케일 시 compact 얇아지는 문제 있음 */\n  scrollbar-width: thin;\n  scrollbar-color: var(--component-scrollarea-thumb) var(--component-scrollarea-track);\n}\n.ods-scrollarea--vertical { overflow-x: hidden; overflow-y: auto; }\n.ods-scrollarea--horizontal { overflow-x: auto; overflow-y: hidden; }\n.ods-scrollarea::-webkit-scrollbar { width: 0.5rem; height: 0.5rem; }\n.ods-scrollarea::-webkit-scrollbar-track {\n  background: var(--component-scrollarea-track); }\n.ods-scrollarea::-webkit-scrollbar-thumb {\n  background: var(--component-scrollarea-thumb);\n  border-radius: var(--component-scrollarea-radius); }\n/* 커스텀 스크롤바 공간 지정, 네이티브는 유지. 오류 시 스크롤 수단 없음 */\n.ods-scrollarea-bar {\n  background: var(--component-scrollarea-track);\n  border-radius: var(--component-scrollarea-radius); }\n\n"
