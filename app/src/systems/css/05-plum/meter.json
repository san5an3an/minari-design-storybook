"/* Meter 구간 색 팔레트 구성에 종속, success 없으면 brand로 변경 */\n\n.ods-meter { display: flex; flex-direction: column;\n  gap: var(--component-meter-gap);\n  font-family: var(--base-font-family-sans); }\n.ods-meter-head { display: flex; justify-content: space-between; align-items: baseline; }\n.ods-meter-label { color: var(--component-meter-label-fg);\n  font-size: var(--component-meter-label-font-size);\n  letter-spacing: var(--component-meter-label-letter-spacing); }\n.ods-meter-value { color: var(--component-meter-value-fg);\n  font-family: var(--base-font-family-mono);\n  font-size: var(--component-meter-value-font-size);\n  letter-spacing: var(--component-meter-value-letter-spacing);\n  font-variant-numeric: tabular-nums; }\n.ods-meter-track { position: relative; display: flex; overflow: hidden;\n  height: var(--component-meter-height);\n  background: var(--component-meter-track-bg);\n  /* 고대비에서 배경이 구분 안 돼 안쪽 outline 으로 경계 표시. 높이가 값을 뜻해 두꺼워지면 안 되기 때문임 */\n  outline: var(--semantic-border-width-default) solid var(--component-meter-track-border);\n  outline-offset: var(--semantic-border-inset-default);\n  border-radius: var(--component-meter-radius); }\n.ods-meter-band { height: 100%; transform-origin: left center;\n  animation: ods-meter-band-in 420ms cubic-bezier(.22,.61,.36,1) backwards; }\n.ods-meter-band--low { background: var(--component-meter-band-low); }\n.ods-meter-band--mid { background: var(--component-meter-band-mid); }\n.ods-meter-band--high { background: var(--component-meter-band-high); }\n.ods-meter-marker { position: absolute; top: 0; bottom: 0; width: 0.125rem;\n  background: var(--component-meter-marker);\n  transform: translateX(-50%);\n  transition: left 320ms cubic-bezier(.22,.61,.36,1);\n  animation: ods-meter-marker-in 520ms cubic-bezier(.22,.61,.36,1) backwards; }\n\n/* 진행바는 좌에서 우로 채워지고 표시는 이동. to 생략으로 인라인 left 값이 남음 */\n@keyframes ods-meter-band-in { from { transform: scaleX(0); } to { transform: scaleX(1); } }\n@keyframes ods-meter-marker-in { from { left: 0; opacity: 0; } }\n\n/* 표시 마커는 animation 유지. 지우면 등장 효과가 사라져 원래 있던 것처럼 보임 */\n@media (prefers-reduced-motion: reduce) {\n  .ods-meter-band { animation: none; }\n  .ods-meter-marker { transition: none;\n    animation: ods-meter-marker-fade 200ms linear backwards; }\n}\n@keyframes ods-meter-marker-fade { from { opacity: 0; } }\n"
