"/* Toggle 눌림 상태 유지 버튼, 배경색과 글자색으로 눌림 표시 */\n\n.ods-toggle {\n  display: inline-flex; align-items: center; justify-content: center;\n  gap: var(--component-toggle-gap);\n  padding-inline: var(--component-toggle-padding-inline);\n  /* plain 배경 미적용. 고대비 모드에서 배경만 있으면 안 보이는 문제 있음 */\n  background: transparent;\n  color: var(--component-toggle-fg);\n  border: var(--semantic-border-width-default) solid transparent;\n  border-radius: var(--component-toggle-radius);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-toggle-font-size);\n  letter-spacing: var(--component-toggle-letter-spacing);\n  line-height: var(--base-font-line-height-tight);\n  cursor: pointer;\n  transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;\n}\n/* plain 기본값 명시적으로 지정. 값 없으면 효과 없는 클래스만 남음 */\n.ods-toggle--plain { background: transparent; border-color: transparent; }\n.ods-toggle--outline {\n  background: var(--component-toggle-bg);\n  border-color: var(--component-toggle-border); }\n.ods-toggle:hover:not(:disabled) { background: var(--component-toggle-bg-hover); }\n/* 눌림 시 글자색도 함께 변경. 배경만으로는 hover 와 구별 안 되는 문제 있음 */\n.ods-toggle[aria-pressed=\"true\"] {\n  background: var(--component-toggle-bg-pressed);\n  color: var(--component-toggle-fg-pressed);\n  font-weight: var(--base-font-weight-medium);\n}\n.ods-toggle:focus-visible {\n  outline: 0.125rem solid var(--component-toggle-border-focus); outline-offset: 0.125rem; }\n.ods-toggle:disabled {\n  color: var(--component-toggle-disabled-fg); cursor: not-allowed; }\n.ods-toggle--sm { min-height: var(--component-toggle-size-sm); min-width: var(--component-toggle-size-sm); }\n.ods-toggle--md { min-height: var(--component-toggle-size-md); min-width: var(--component-toggle-size-md); }\n.ods-toggle--lg { min-height: var(--component-toggle-size-lg); min-width: var(--component-toggle-size-lg); }\n"
