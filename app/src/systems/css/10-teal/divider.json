"/* Divider 기본 선 진하게 표시 */\n\n.ods-divider {\n  border: 0;\n  border-top: var(--semantic-border-width-default) solid var(--component-divider-color-strong);\n  margin-block: var(--component-divider-space);\n  margin-inline: 0;\n}\n.ods-divider--strong { border-top-color: var(--component-divider-color-strong); }\n.ods-divider--inset { margin-inline-start: var(--component-divider-inset); }\n.ods-divider--vertical {\n  border-top: 0;\n  border-left: var(--semantic-border-width-default) solid var(--component-divider-color-strong);\n  margin-block: 0; margin-inline: var(--component-divider-space);\n  align-self: stretch; min-height: 1em;\n}\n/* 라벨 붙은 구분선을 div로 구성. hr은 자식 요소를 가질 수 없음 */\n.ods-divider-labeled {\n  display: flex; align-items: center;\n  gap: var(--component-divider-label-gap);\n  margin-block: var(--component-divider-space);\n  color: var(--component-divider-label-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-divider-label-font-size);\n  letter-spacing: var(--component-divider-label-letter-spacing);\n}\n.ods-divider-labeled::before, .ods-divider-labeled::after {\n  content: \"\"; flex: 1;\n  border-top: var(--semantic-border-width-default) solid var(--component-divider-color-strong);\n}\n"
