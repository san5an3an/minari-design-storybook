"/* Kbd 키 글자 mono 서체로 고정 */\n\n.ods-kbd {\n  display: inline-flex; align-items: center; justify-content: center;\n  min-width: 1.6em;\n  padding-inline: var(--component-kbd-padding-inline);\n  background: var(--component-kbd-bg);\n  color: var(--component-kbd-fg);\n  border: var(--semantic-border-width-default) solid var(--component-kbd-border);\n  border-radius: var(--component-kbd-radius);\n  /* mono 글꼴 고정. 서체별로 l, 1, I 구별이 안 되는 경우 있음 */\n  font-family: var(--base-font-family-mono);\n  font-size: var(--component-kbd-font-size);\n  letter-spacing: var(--component-kbd-letter-spacing);\n  line-height: var(--base-font-line-height-tight);\n}\n.ods-kbd-group { display: inline-flex; align-items: center;\n  gap: var(--component-kbd-gap); }\n"
