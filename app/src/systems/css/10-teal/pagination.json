"/* Pagination 페이지 번호는 링크, 최소 탭 영역 크기 유지 */\n\n.ods-pagination {\n  /* 목록을 nav 로 감싸기. 빼면 스크린리더가 여러 링크 그룹 중 하나로만 읽음 */\n  display: flex; justify-content: center;\n}\n.ods-pagination-list {\n  display: flex; align-items: center;\n  gap: var(--component-pagination-gap);\n  list-style: none; margin: 0; padding: 0;\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-pagination-font-size);\n  letter-spacing: var(--component-pagination-letter-spacing);\n}\n/* 숫자 자릿수와 무관하게 클릭 영역 동일하게 고정 */\n.ods-pagination-item {\n  display: inline-flex; align-items: center; justify-content: center;\n  min-width: var(--component-pagination-size);\n  height: var(--component-pagination-size);\n  padding-inline: var(--component-pagination-gap);\n  border-radius: var(--component-pagination-radius);\n  color: var(--component-pagination-fg);\n  text-decoration: none;\n  font-variant-numeric: tabular-nums;\n}\n.ods-pagination-item:hover {\n  background: var(--component-pagination-bg-hover);\n  color: var(--component-pagination-fg-hover);\n}\n.ods-pagination-item:focus-visible {\n  outline: 0.125rem solid var(--component-pagination-border-focus); outline-offset: 0.0625rem;\n}\n.ods-pagination-item[aria-current=\"page\"] {\n  background: var(--component-pagination-current-bg);\n  color: var(--component-pagination-current-fg);\n  /* 공식 buttonVariants 재사용, 버튼과 동일한 스타일 단 적용 */\n  font-weight: var(--base-font-weight-medium);\n}\n.ods-pagination-item[aria-disabled=\"true\"] {\n  color: var(--component-pagination-disabled-fg);\n  pointer-events: none;\n}\n.ods-pagination-item svg { width: 1em; height: 1em; stroke: currentColor; fill: none;\n  stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }\n.ods-pagination-gap {\n  display: inline-flex; align-items: center; justify-content: center;\n  min-width: var(--component-pagination-size);\n  color: var(--component-pagination-disabled-fg);\n}\n"
