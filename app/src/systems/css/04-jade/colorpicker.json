"/* ColorPicker 스와치 기본 노출, 자유색은 접어서 표시 */\n\n.ods-colorpicker {\n  display: flex; flex-direction: column;\n  gap: var(--component-colorpicker-gap);\n  font-family: var(--base-font-family-sans);\n}\n/* 고정 열 grid 사용. flex-wrap 이면 폭에 따라 열 수 달라져 상한이 안 보임 */\n/* 열 수는 고정, 셀 너비는 minmax 적용. 고정폭이면 좁은 공간에서 넘치는 문제 있음 */\n.ods-colorpicker-swatches {\n  display: grid;\n  grid-template-columns: repeat(8, minmax(0, var(--component-colorpicker-swatch-size)));\n  justify-content: start;\n  gap: var(--component-colorpicker-swatch-gap);\n}\n/* 채움색은 사용하는 쪽이 지정. 토큰으로 고정하면 고를 색이 없음 */\n/* 스와치는 폭이 줄어도 정사각형 유지. 모양 바뀌면 같은 색도 다르게 보임 */\n.ods-colorpicker-swatch {\n  inline-size: 100%;\n  max-inline-size: var(--component-colorpicker-swatch-size);\n  aspect-ratio: 1;\n  padding: 0; cursor: pointer;\n  border-radius: var(--component-colorpicker-swatch-radius);\n  background: var(--ods-colorpicker-swatch, transparent);\n  border: var(--semantic-border-width-default) solid var(--component-colorpicker-swatch-border);\n}\n/* 선택 표시는 테두리 사용. 포커스 링과 명시도 같아 사라지는 문제 있음 */\n.ods-colorpicker-swatch[aria-checked=\"true\"] {\n  border-color: var(--component-colorpicker-swatch-border-selected);\n  border-width: 0.125rem;\n  box-shadow: 0 0 0 var(--semantic-border-width-default)\n              var(--component-colorpicker-swatch-border-selected);\n}\n.ods-colorpicker-swatch:focus-visible {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n.ods-colorpicker-more {\n  padding: 0; cursor: pointer; background: none; border: none;\n  color: var(--component-colorpicker-more-fg);\n  font-family: inherit;\n  font-size: var(--component-colorpicker-more-font-size);\n  letter-spacing: var(--component-colorpicker-more-letter-spacing);\n  text-decoration: underline; text-underline-offset: 0.2em;\n}\n.ods-colorpicker-more:focus-visible {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n/* 접힘은 hidden 속성 사용. display:none 은 덮어쓸 수 있어 상태가 두 곳에 남음 */\n.ods-colorpicker-custom {\n  display: flex; flex-direction: column;\n  gap: var(--component-colorpicker-gap);\n}\n.ods-colorpicker-custom[hidden] { display: none; }\n\n/* 채도, 명도 선택 영역을 겹친 그라디언트 2개로 생성 */\n.ods-colorpicker-area {\n  position: relative;\n  block-size: var(--component-colorpicker-area-height);\n  border-radius: var(--component-colorpicker-area-radius);\n  cursor: crosshair; touch-action: none;\n  background:\n    linear-gradient(to top, #000, rgb(0 0 0 / 0)),\n    linear-gradient(to right, #fff, rgb(255 255 255 / 0)),\n    hsl(var(--ods-colorpicker-hue, 0) 100% 50%);\n}\n.ods-colorpicker-area:focus-visible {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n/* 핸들 안쪽을 비우기. 채우면 선택한 색이 가려지는 문제 있음 */\n.ods-colorpicker-thumb {\n  position: absolute;\n  inline-size: var(--component-colorpicker-thumb-size);\n  block-size: var(--component-colorpicker-thumb-size);\n  inset-inline-start: var(--ods-colorpicker-x, 50%);\n  inset-block-start: var(--ods-colorpicker-y, 50%);\n  translate: -50% -50%;\n  border-radius: var(--semantic-radius-pill);\n  border: 0.125rem solid var(--component-colorpicker-thumb-border);\n  background: none; pointer-events: none;\n}\n\n/* 색상 띠 양 끝은 동일한 빨강. 색상값은 순환값이라 끝이 없음 */\n.ods-colorpicker-hue {\n  -webkit-appearance: none; appearance: none;\n  inline-size: 100%; block-size: var(--component-colorpicker-hue-height);\n  padding: 0; cursor: pointer;\n  border-radius: var(--component-colorpicker-hue-radius);\n  background: linear-gradient(to right,\n    hsl(0 100% 50%), hsl(60 100% 50%), hsl(120 100% 50%),\n    hsl(180 100% 50%), hsl(240 100% 50%), hsl(300 100% 50%), hsl(360 100% 50%));\n}\n.ods-colorpicker-hue::-webkit-slider-thumb {\n  -webkit-appearance: none; appearance: none;\n  inline-size: var(--component-colorpicker-thumb-size);\n  block-size: var(--component-colorpicker-hue-height);\n  border-radius: var(--component-colorpicker-hue-radius);\n  border: 0.125rem solid var(--component-colorpicker-thumb-border);\n  background: none;\n}\n.ods-colorpicker-hue::-moz-range-thumb {\n  inline-size: var(--component-colorpicker-thumb-size);\n  block-size: var(--component-colorpicker-hue-height);\n  border-radius: var(--component-colorpicker-hue-radius);\n  border: 0.125rem solid var(--component-colorpicker-thumb-border);\n  background: none;\n}\n.ods-colorpicker-hue:focus-visible { outline: none; }\n.ods-colorpicker-hue:focus-visible::-webkit-slider-thumb {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n.ods-colorpicker-hue:focus-visible::-moz-range-thumb {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n\n/* 투명도 슬라이더는 격자 위에 색 레이어. 단색 배경이면 반투명이 흐린 색으로만 보임 */\n.ods-colorpicker-alpha {\n  -webkit-appearance: none; appearance: none;\n  inline-size: 100%; block-size: var(--component-colorpicker-hue-height);\n  padding: 0; cursor: pointer;\n  border-radius: var(--component-colorpicker-hue-radius);\n  background-image:\n    linear-gradient(to right, transparent, var(--ods-colorpicker-solid, #000)),\n    conic-gradient(var(--component-colorpicker-checker) 0 25%, transparent 0 50%,\n                   var(--component-colorpicker-checker) 0 75%, transparent 0);\n  background-size:\n    auto,\n    var(--component-colorpicker-checker-size) var(--component-colorpicker-checker-size);\n}\n.ods-colorpicker-alpha::-webkit-slider-thumb {\n  -webkit-appearance: none; appearance: none;\n  inline-size: var(--component-colorpicker-thumb-size);\n  block-size: var(--component-colorpicker-hue-height);\n  border-radius: var(--component-colorpicker-hue-radius);\n  border: 0.125rem solid var(--component-colorpicker-thumb-border);\n  background: none;\n}\n.ods-colorpicker-alpha::-moz-range-thumb {\n  inline-size: var(--component-colorpicker-thumb-size);\n  block-size: var(--component-colorpicker-hue-height);\n  border-radius: var(--component-colorpicker-hue-radius);\n  border: 0.125rem solid var(--component-colorpicker-thumb-border);\n  background: none;\n}\n.ods-colorpicker-alpha:focus-visible { outline: none; }\n.ods-colorpicker-alpha:focus-visible::-webkit-slider-thumb {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n.ods-colorpicker-alpha:focus-visible::-moz-range-thumb {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n\n/* 형식, 값, 투명도를 한 행에 배치, 넘치면 줄바꿈 처리 */\n.ods-colorpicker-row {\n  display: flex; align-items: center; flex-wrap: wrap;\n  gap: var(--component-colorpicker-row-gap);\n}\n.ods-colorpicker-pipette,\n.ods-colorpicker-format,\n.ods-colorpicker-field {\n  block-size: var(--component-colorpicker-field-height);\n  padding-inline: var(--component-colorpicker-field-pad-inline);\n  padding-block: var(--component-colorpicker-field-pad-block);\n  border-radius: var(--component-colorpicker-field-radius);\n  border: var(--semantic-border-width-default) solid\n          var(--component-colorpicker-field-border);\n  background: var(--component-colorpicker-field-bg);\n  color: var(--component-colorpicker-value-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-colorpicker-value-font-size);\n  letter-spacing: var(--component-colorpicker-value-letter-spacing);\n}\n/* 현재 색상 스와치로 추가와 삭제 겸용. 삭제 표시는 평소 숨김 처리 */\n.ods-colorpicker-current {\n  position: relative;\n  flex: 0 0 auto;\n  inline-size: var(--component-colorpicker-field-height);\n  block-size: var(--component-colorpicker-field-height);\n  padding: 0; cursor: pointer;\n  border-radius: var(--component-colorpicker-field-radius);\n  border: var(--semantic-border-width-default) solid\n          var(--component-colorpicker-swatch-border);\n  background: var(--ods-colorpicker-swatch, transparent);\n}\n/* 한도 도달 버튼 aria-disabled 처리. disabled는 Tab 건너뛰어 못 읽음 */\n.ods-colorpicker-current[aria-disabled=\"true\"] { cursor: default; }\n.ods-colorpicker-current-mark {\n  position: absolute; inset: 0;\n  display: grid; place-items: center;\n  border-radius: inherit;\n  background: var(--component-colorpicker-current-scrim);\n  color: var(--component-colorpicker-current-mark-fg);\n  opacity: 0;\n}\n/* hover 또는 focus-visible 시 표시. 터치는 hover가 없기 때문임 */\n.ods-colorpicker-current:hover:not([aria-disabled=\"true\"]) .ods-colorpicker-current-mark,\n.ods-colorpicker-current:focus-visible .ods-colorpicker-current-mark { opacity: 1; }\n.ods-colorpicker-current:focus-visible {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n/* 아이콘은 Lucide 선 스타일만 사용. 면으로 채우면 스포이드 안쪽이 가려 안 보임 */\n.ods-colorpicker-icon {\n  inline-size: var(--component-colorpicker-icon-size);\n  block-size: var(--component-colorpicker-icon-size);\n  stroke: currentColor; fill: none; stroke-width: 2;\n  stroke-linecap: round; stroke-linejoin: round;\n}\n\n/* 스포이드와 포맷은 flex-shrink 0 으로 고정. 값 필드가 대신 줄어드는 구조임 */\n.ods-colorpicker-pipette {\n  display: inline-grid; place-items: center;\n  flex: 0 0 auto;\n  inline-size: var(--component-colorpicker-field-height);\n  padding-inline: 0; cursor: pointer;\n}\n.ods-colorpicker-format { flex: 0 0 auto; cursor: pointer; }\n/* 값 필드는 남는 폭을 모두 사용, 넷은 한 덩어리로 유지 */\n.ods-colorpicker-fields {\n  display: flex; align-items: center;\n  flex: 1 1 auto; min-inline-size: 0;\n  gap: var(--component-colorpicker-row-gap);\n}\n/* 단위 기호는 입력값과 분리해 고정 표시. 값에 섞이면 지워질 수 있음 */\n.ods-colorpicker-field {\n  display: inline-flex; align-items: center;\n  flex: 1 1 auto; min-inline-size: 0;\n  font-family: var(--base-font-family-mono);\n  font-variant-numeric: tabular-nums;\n}\n/* 숫자 필드는 같은 기준폭으로 함께 조정. 고정폭이면 좁을 때 넘치는 문제 있음 */\n.ods-colorpicker-field--num {\n  flex: 1 1 var(--component-colorpicker-field-num-width);\n  justify-content: end;\n}\n/* 투명도 필드 폭 고정. 줄이면 100% 표기가 90%와 구별 안 되는 문제 있음 */\n.ods-colorpicker-field--alpha {\n  flex: 0 0 var(--component-colorpicker-field-num-width);\n}\n.ods-colorpicker-field-input {\n  inline-size: 100%; min-inline-size: 0;\n  padding: 0; border: none; background: none;\n  color: inherit; font: inherit;\n}\n.ods-colorpicker-field--num .ods-colorpicker-field-input { text-align: end; }\n.ods-colorpicker-field-input:focus-visible { outline: none; }\n.ods-colorpicker-field-affix { color: var(--component-colorpicker-more-fg); }\n/* 접두 문자 #과 접미 문자 % 는 여백 방향이 서로 반대로 적용 */\n.ods-colorpicker-field-affix:first-child { padding-inline-end: 0.125rem; }\n.ods-colorpicker-field-affix:last-child { padding-inline-start: 0.125rem; }\n\n.ods-colorpicker-pipette:focus-visible,\n.ods-colorpicker-format:focus-visible {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n/* 포커스 링은 바깥 상자에 적용. 안쪽 입력이 받으면 요소가 링 밖으로 벗어나 보임 */\n.ods-colorpicker-field:focus-within {\n  outline: 0.125rem solid var(--component-colorpicker-border-focus);\n  outline-offset: var(--semantic-border-inset-default);\n}\n\n/* 값을 텍스트로 표시. 색은 음성 전달이 안 돼 스크린리더에 필요한 정보임 */\n.ods-colorpicker-value {\n  color: var(--component-colorpicker-value-fg);\n  font-family: var(--base-font-family-mono);\n  font-size: var(--component-colorpicker-value-font-size);\n  letter-spacing: var(--component-colorpicker-value-letter-spacing);\n  font-variant-numeric: tabular-nums;\n}\n"
