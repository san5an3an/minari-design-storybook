"/* Checkbox 다중 선택, 밀도 축 regular, 상자형 고정 */\n\n.ods-checkbox { display: inline-flex; align-items: center;\n  gap: var(--component-checkbox-gap); cursor: pointer;\n  color: var(--component-checkbox-label-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-checkbox-label-font-size);\n  letter-spacing: var(--component-checkbox-label-letter-spacing); }\n.ods-checkbox > input { position: absolute; opacity: 0; width: 0; height: 0; }\n/* data-indeterminate 와 :indeterminate 둘 다 지정 */\n.ods-checkbox > .ods-checkbox-box {\n  display: inline-flex; align-items: center; justify-content: center;\n  flex-shrink: 0;\n  width: var(--component-checkbox-size);\n  height: var(--component-checkbox-size);\n  background: var(--component-checkbox-bg);\n  border: var(--semantic-border-width-default) solid var(--component-checkbox-border);\n  /* 모서리 반경은 상자의 35%. 50% 는 원이 되어 radio 버튼과 구분되지 않음 */\n  border-radius: min(var(--component-checkbox-radius), 35%);\n  color: var(--component-checkbox-mark);\n  transition: background-color 120ms ease, border-color 120ms ease;\n}\n.ods-checkbox-box > svg { width: 72%; height: 72%; stroke: currentColor;\n  fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; display: none; }\n.ods-checkbox > input:checked + .ods-checkbox-box,\n.ods-checkbox > input:indeterminate + .ods-checkbox-box,\n.ods-checkbox > input[data-indeterminate=\"true\"] + .ods-checkbox-box {\n  background: var(--component-checkbox-bg-checked);\n  border-color: var(--component-checkbox-border-checked);\n}\n.ods-checkbox > input:checked + .ods-checkbox-box > .ods-checkbox-check { display: block; }\n.ods-checkbox > input:indeterminate + .ods-checkbox-box > .ods-checkbox-check,\n.ods-checkbox > input[data-indeterminate=\"true\"] + .ods-checkbox-box > .ods-checkbox-check { display: none; }\n.ods-checkbox > input:indeterminate + .ods-checkbox-box > .ods-checkbox-dash,\n.ods-checkbox > input[data-indeterminate=\"true\"] + .ods-checkbox-box > .ods-checkbox-dash { display: block; }\n/* hover 상태 없음 */\n.ods-checkbox > input:focus-visible + .ods-checkbox-box {\n  outline: 0.125rem solid var(--component-checkbox-border-focus); outline-offset: 0.125rem; }\n.ods-checkbox > input:disabled + .ods-checkbox-box {\n  background: var(--component-checkbox-disabled-bg);\n  border-color: var(--component-checkbox-disabled-fg);\n  color: var(--component-checkbox-disabled-fg);\n}\n.ods-checkbox:has(input:disabled) { color: var(--component-checkbox-disabled-fg); cursor: not-allowed; }\n.ods-checkbox-group { display: flex; flex-direction: column;\n  gap: var(--component-checkbox-gap); }\n.ods-checkbox > input[aria-invalid=\"true\"] + .ods-checkbox-box {\n  border-color: var(--component-checkbox-border-invalid); }\n.ods-checkbox:has(input[aria-invalid=\"true\"]) {\n  color: var(--component-checkbox-label-fg-invalid); }\n.ods-checkbox-description { display: block; color: var(--component-checkbox-description-fg); font-size: var(--component-checkbox-description-font-size);\n letter-spacing: var(--component-checkbox-description-letter-spacing); }\n"
