"/* 형태 축 sharp, 선택 항목 테두리로 표시 */\n\n.ods-segmented {\n  display: inline-flex;\n  padding: var(--component-segmented-padding);\n  background: transparent;\n  border: var(--semantic-border-width-default) solid var(--component-segmented-border);\n  border-radius: var(--component-segmented-radius);\n  font-family: var(--base-font-family-sans);\n}\n.ods-segmented-item {\n  padding-inline: var(--component-segmented-item-padding-inline);\n  padding-block: var(--component-segmented-item-padding-block);\n  border: 0; background: transparent;\n  border-radius: 0;\n  color: var(--component-segmented-item-fg);\n  font: inherit;\n  font-size: var(--component-segmented-item-font-size);\n  letter-spacing: var(--component-segmented-item-letter-spacing);\n  white-space: nowrap; cursor: pointer;\n  transition: background-color 120ms ease, color 120ms ease;\n}\n.ods-segmented-item + .ods-segmented-item {\n  border-left: var(--semantic-border-width-default) solid var(--component-segmented-border);\n}\n.ods-segmented-item:hover { color: var(--component-segmented-item-fg-selected); }\n.ods-segmented-item:focus-visible { outline: 0.125rem solid var(--semantic-border-focus-default);\n  outline-offset: -2px; }\n.ods-segmented-item[aria-checked=\"true\"] {\n  background: var(--component-segmented-item-bg-selected);\n  color: var(--component-segmented-item-fg-selected);\n}\n.ods-segmented-item[aria-checked=\"true\"] {\n  box-shadow: inset 0 -2px 0 0 var(--component-segmented-item-border-selected);\n}\n"
