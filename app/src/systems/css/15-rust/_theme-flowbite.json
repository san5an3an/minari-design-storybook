"/* @interop Flowbite React 기반 Rust 테마 정의 */\n:root {\n  --primary-50  : var(--base-color-brand-1);\n  --primary-100 : var(--base-color-brand-3);\n  --primary-200 : var(--base-color-brand-5);\n  --primary-300 : var(--base-color-brand-6);\n  --primary-400 : var(--base-color-brand-8);\n  --primary-500 : var(--base-color-brand-9);\n  --primary-600 : var(--base-color-brand-10);\n  --primary-700 : var(--base-color-brand-11);\n  --primary-800 : var(--base-color-brand-11);\n  --primary-900 : var(--base-color-brand-12);\n  --gray-50     : var(--base-color-neutral-1);\n  --gray-100    : var(--base-color-neutral-3);\n  --gray-200    : var(--base-color-neutral-5);\n  --gray-300    : var(--base-color-neutral-6);\n  --gray-400    : var(--base-color-neutral-8);\n  --gray-500    : var(--base-color-neutral-9);\n  --gray-600    : var(--base-color-neutral-10);\n  --gray-700    : var(--base-color-neutral-11);\n  --gray-800    : var(--base-color-neutral-11);\n  --gray-900    : var(--base-color-neutral-12);\n  --red-50      : var(--base-color-danger-1);\n  --red-100     : var(--base-color-danger-3);\n  --red-200     : var(--base-color-danger-5);\n  --red-300     : var(--base-color-danger-6);\n  --red-400     : var(--base-color-danger-8);\n  --red-500     : var(--base-color-danger-9);\n  --red-600     : var(--base-color-danger-10);\n  --red-700     : var(--base-color-danger-11);\n  --red-800     : var(--base-color-danger-11);\n  --red-900     : var(--base-color-danger-12);\n  --green-50    : var(--base-color-success-1);\n  --green-100   : var(--base-color-success-3);\n  --green-200   : var(--base-color-success-5);\n  --green-300   : var(--base-color-success-6);\n  --green-400   : var(--base-color-success-8);\n  --green-500   : var(--base-color-success-9);\n  --green-600   : var(--base-color-success-10);\n  --green-700   : var(--base-color-success-11);\n  --green-800   : var(--base-color-success-11);\n  --green-900   : var(--base-color-success-12);\n  --yellow-50   : var(--base-color-warning-1);\n  --yellow-100  : var(--base-color-warning-3);\n  --yellow-200  : var(--base-color-warning-5);\n  --yellow-300  : var(--base-color-warning-6);\n  --yellow-400  : var(--base-color-warning-8);\n  --yellow-500  : var(--base-color-warning-9);\n  --yellow-600  : var(--base-color-warning-10);\n  --yellow-700  : var(--base-color-warning-11);\n  --yellow-800  : var(--base-color-warning-11);\n  --yellow-900  : var(--base-color-warning-12);\n  --radius-xs   : calc(var(--semantic-radius-selection) / 2);\n  --radius-sm   : var(--semantic-radius-selection);\n  --radius-md   : calc(var(--semantic-radius-selection) * 1.5);\n  --radius-lg   : var(--semantic-radius-control);\n  --radius-xl   : var(--semantic-radius-container);\n  --radius-2xl  : var(--semantic-radius-overlay);\n  --radius-3xl  : calc(var(--semantic-radius-overlay) * 1.5);\n  --radius-4xl  : calc(var(--semantic-radius-overlay) * 2);\n  --spacing     : calc(var(--semantic-space-md) / 4);\n}\n"
