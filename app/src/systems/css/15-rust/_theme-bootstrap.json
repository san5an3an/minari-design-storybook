"/* @interop React Bootstrap 기반 Rust 테마 정의 */\n:root {\n  --bs-primary                 : var(--semantic-bg-brand-default);\n  --bs-primary-text-emphasis   : var(--semantic-fg-brand-strong);\n  --bs-primary-bg-subtle       : var(--semantic-bg-brand-subtlest);\n  --bs-primary-border-subtle   : var(--semantic-border-brand-default);\n  --bs-secondary               : var(--semantic-bg-neutral-default);\n  --bs-secondary-bg-subtle     : var(--semantic-bg-neutral-subtlest);\n  --bs-secondary-border-subtle : var(--semantic-border-neutral-default);\n  --bs-success                 : var(--semantic-bg-success-default);\n  --bs-success-text-emphasis   : var(--semantic-fg-success-strong);\n  --bs-success-bg-subtle       : var(--semantic-bg-success-subtlest);\n  --bs-success-border-subtle   : var(--semantic-border-success-default);\n  --bs-warning                 : var(--semantic-bg-warning-default);\n  --bs-warning-text-emphasis   : var(--semantic-fg-warning-strong);\n  --bs-warning-bg-subtle       : var(--semantic-bg-warning-subtlest);\n  --bs-warning-border-subtle   : var(--semantic-border-warning-default);\n  --bs-danger                  : var(--semantic-bg-danger-default);\n  --bs-danger-text-emphasis    : var(--semantic-fg-danger-strong);\n  --bs-danger-bg-subtle        : var(--semantic-bg-danger-subtlest);\n  --bs-danger-border-subtle    : var(--semantic-border-danger-default);\n  --bs-body-bg                 : var(--semantic-bg-neutral-surface);\n  --bs-body-color              : var(--semantic-fg-neutral-default);\n  --bs-emphasis-color          : var(--semantic-fg-neutral-default);\n  --bs-secondary-color         : var(--semantic-fg-neutral-subtle);\n  --bs-tertiary-color          : var(--semantic-fg-neutral-subtlest);\n  --bs-secondary-bg            : var(--semantic-bg-neutral-subtle);\n  --bs-tertiary-bg             : var(--semantic-bg-neutral-subtlest);\n  --bs-border-color            : var(--semantic-border-neutral-default);\n  --bs-border-radius           : var(--semantic-radius-control);\n  --bs-border-width            : var(--semantic-border-width-default);\n  --bs-link-color              : var(--semantic-fg-brand-default);\n  --bs-link-hover-color        : var(--semantic-fg-brand-strong);\n  --bs-code-color              : var(--semantic-fg-danger-default);\n  --bs-highlight-bg            : var(--semantic-bg-warning-subtle);\n  --bs-light                   : var(--base-color-neutral-2);\n  --bs-dark                    : var(--base-color-neutral-12);\n  --bs-light-bg-subtle         : var(--base-color-neutral-1);\n  --bs-dark-bg-subtle          : var(--base-color-neutral-6);\n  --bs-light-border-subtle     : var(--base-color-neutral-4);\n  --bs-dark-border-subtle      : var(--base-color-neutral-8);\n  --bs-primary-rgb             : 158, 105, 84;\n  --bs-secondary-rgb           : 129, 115, 109;\n  --bs-success-rgb             : 81, 198, 114;\n  --bs-warning-rgb             : 218, 165, 0;\n  --bs-danger-rgb              : 235, 0, 54;\n  --bs-body-bg-rgb             : 253, 252, 252;\n  --bs-body-color-rgb          : 12, 7, 6;\n  --bs-emphasis-color-rgb      : 12, 7, 6;\n}\n\n.btn-primary {\n  --bs-btn-bg                  : var(--semantic-bg-brand-default);\n  --bs-btn-border-color        : var(--semantic-bg-brand-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-brand-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-brand-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-brand-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-brand-strong);\n}\n\n.btn-outline-primary {\n  --bs-btn-color                 : var(--semantic-bg-brand-default);\n  --bs-btn-border-color          : var(--semantic-border-brand-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-brand-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-brand-default);\n  --bs-btn-active-bg             : var(--semantic-bg-brand-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-brand-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-brand-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-brand-default);\n}\n\n.btn-secondary {\n  --bs-btn-bg                  : var(--semantic-bg-neutral-default);\n  --bs-btn-border-color        : var(--semantic-bg-neutral-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-neutral-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-neutral-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-neutral-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-neutral-strong);\n}\n\n.btn-outline-secondary {\n  --bs-btn-color                 : var(--semantic-bg-neutral-default);\n  --bs-btn-border-color          : var(--semantic-border-neutral-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-neutral-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-neutral-default);\n  --bs-btn-active-bg             : var(--semantic-bg-neutral-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-neutral-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-neutral-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-neutral-default);\n}\n\n.btn-success {\n  --bs-btn-bg                  : var(--semantic-bg-success-default);\n  --bs-btn-border-color        : var(--semantic-bg-success-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-success-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-success-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-success-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-success-strong);\n}\n\n.btn-outline-success {\n  --bs-btn-color                 : var(--semantic-bg-success-default);\n  --bs-btn-border-color          : var(--semantic-border-success-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-success-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-success-default);\n  --bs-btn-active-bg             : var(--semantic-bg-success-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-success-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-success-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-success-default);\n}\n\n.btn-warning {\n  --bs-btn-bg                  : var(--semantic-bg-warning-default);\n  --bs-btn-border-color        : var(--semantic-bg-warning-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-warning-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-warning-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-warning-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-warning-strong);\n}\n\n.btn-outline-warning {\n  --bs-btn-color                 : var(--semantic-bg-warning-default);\n  --bs-btn-border-color          : var(--semantic-border-warning-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-warning-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-warning-default);\n  --bs-btn-active-bg             : var(--semantic-bg-warning-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-warning-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-warning-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-warning-default);\n}\n\n.btn-danger {\n  --bs-btn-bg                  : var(--semantic-bg-danger-default);\n  --bs-btn-border-color        : var(--semantic-bg-danger-default);\n  --bs-btn-hover-bg            : var(--semantic-bg-danger-strong);\n  --bs-btn-hover-border-color  : var(--semantic-bg-danger-strong);\n  --bs-btn-active-bg           : var(--semantic-bg-danger-strong);\n  --bs-btn-active-border-color : var(--semantic-bg-danger-strong);\n}\n\n.btn-outline-danger {\n  --bs-btn-color                 : var(--semantic-bg-danger-default);\n  --bs-btn-border-color          : var(--semantic-border-danger-default);\n  --bs-btn-hover-bg              : var(--semantic-bg-danger-default);\n  --bs-btn-hover-border-color    : var(--semantic-bg-danger-default);\n  --bs-btn-active-bg             : var(--semantic-bg-danger-default);\n  --bs-btn-active-border-color   : var(--semantic-bg-danger-default);\n  --bs-btn-disabled-color        : var(--semantic-bg-danger-default);\n  --bs-btn-disabled-border-color : var(--semantic-border-danger-default);\n}\n\n/* 모드마다 값 재지정. 삼중값은 상속되지 않음 */\n:root[data-theme=\"dark\"] {\n  --bs-primary-rgb        : 167, 113, 92;\n  --bs-secondary-rgb      : 138, 124, 117;\n  --bs-success-rgb        : 0, 147, 66;\n  --bs-warning-rgb        : 160, 120, 0;\n  --bs-body-bg-rgb        : 35, 34, 33;\n  --bs-body-color-rgb     : 255, 248, 245;\n  --bs-emphasis-color-rgb : 255, 248, 245;\n}\n\n/* 모드마다 값 재지정. 삼중값은 상속되지 않음 */\n:root[data-theme=\"high-contrast\"] {\n  --bs-primary-rgb        : 242, 190, 168;\n  --bs-secondary-rgb      : 213, 199, 192;\n  --bs-success-rgb        : 121, 222, 145;\n  --bs-warning-rgb        : 245, 194, 75;\n  --bs-danger-rgb         : 255, 184, 180;\n  --bs-body-bg-rgb        : 9, 8, 7;\n  --bs-body-color-rgb     : 247, 239, 236;\n  --bs-emphasis-color-rgb : 247, 239, 236;\n}\n"
