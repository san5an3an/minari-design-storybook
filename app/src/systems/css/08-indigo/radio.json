"/* Radio는 단일 선택, 밀도 regular, 항상 원형 유지 */\n\n.ods-radio { display: inline-flex; align-items: center;\n  gap: var(--component-radio-gap); cursor: pointer;\n  color: var(--component-radio-label-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-radio-label-font-size);\n  letter-spacing: var(--component-radio-label-letter-spacing); }\n.ods-radio > input { position: absolute; opacity: 0; width: 0; height: 0; }\n.ods-radio > .ods-radio-mark {\n  display: inline-flex; align-items: center; justify-content: center;\n  flex-shrink: 0;\n  width: var(--component-radio-size);\n  height: var(--component-radio-size);\n  background: var(--component-radio-bg);\n  border: var(--semantic-border-width-default) solid var(--component-radio-border);\n  /* 모양 테마와 무관하게 원형 유지. 단일 선택을 나타내는 신호임 */\n  border-radius: 50%;\n  transition: background-color 120ms ease, border-color 120ms ease;\n}\n.ods-radio > .ods-radio-mark::after {\n  content: \"\"; width: 38%; height: 38%; border-radius: 50%;\n  background: var(--component-radio-dot);\n  transform: scale(0); transition: transform 120ms ease;\n}\n.ods-radio > input:checked + .ods-radio-mark {\n  background: var(--component-radio-bg-checked);\n  border-color: var(--component-radio-border-checked);\n}\n.ods-radio > input:checked + .ods-radio-mark::after { transform: scale(1); }\n/* 비활성 요소 hover 제외. 빼면 hover 가 우선 적용돼 눌리는 것처럼 보임 */\n/* hover 상태 없음 */\n.ods-radio > input:focus-visible + .ods-radio-mark {\n  outline: 0.125rem solid var(--component-radio-border-focus); outline-offset: 0.125rem; }\n.ods-radio > input:disabled + .ods-radio-mark {\n  background: var(--component-radio-disabled-bg);\n  border-color: var(--component-radio-disabled-fg);\n}\n.ods-radio > input:disabled:checked + .ods-radio-mark::after {\n  background: var(--component-radio-disabled-fg); }\n.ods-radio:has(input:disabled) { color: var(--component-radio-disabled-fg); cursor: not-allowed; }\n.ods-radio-group { display: flex; flex-direction: column;\n  gap: var(--component-radio-group-gap); border: 0; margin: 0; padding: 0; }\n.ods-radio-group > legend { padding: 0; margin-bottom: var(--component-radio-group-gap);\n  color: var(--component-radio-label-fg);\n  font-size: var(--component-radio-label-font-size);\n  letter-spacing: var(--component-radio-label-letter-spacing);\n  font-weight: var(--base-font-weight-medium); }\n.ods-radio > input[aria-invalid=\"true\"] + .ods-radio-mark {\n  border-color: var(--component-radio-border-invalid); }\n.ods-radio:has(input[aria-invalid=\"true\"]) {\n  color: var(--component-radio-label-fg-invalid); }\n.ods-radio-description { display: block; color: var(--component-radio-description-fg); font-size: var(--component-radio-description-font-size);\n letter-spacing: var(--component-radio-description-letter-spacing); }\n"
