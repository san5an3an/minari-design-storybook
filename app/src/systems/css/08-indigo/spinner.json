"/* Spinner 밀도축 regular라 링 굵기 0.15625rem */\n\n.ods-spinner {\n  display: inline-block; flex-shrink: 0;\n  border: 0.15625rem solid var(--component-spinner-track);\n  border-top-color: var(--component-spinner-indicator);\n  border-radius: var(--semantic-radius-pill);\n  animation: ods-spin 700ms linear infinite;\n}\n.ods-spinner { width: var(--component-spinner-size);\n  height: var(--component-spinner-size); }\n.ods-spinner--on-fill { border-top-color: var(--component-spinner-indicator-on-fill); }\n@keyframes ods-spin { to { transform: rotate(360deg); } }\n/* 모션 줄임 설정 시 회전 대신 명암 변화로 상태 표시 */\n@media (prefers-reduced-motion: reduce) {\n  .ods-spinner { animation: ods-spin-fade 1.4s ease-in-out infinite; }\n  @keyframes ods-spin-fade { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }\n}\n.ods-spinner-block {\n  display: inline-flex; align-items: center;\n  gap: var(--component-spinner-gap);\n  color: var(--component-spinner-label-fg);\n  font-family: var(--base-font-family-sans);\n  font-size: var(--component-spinner-label-font-size);\n  letter-spacing: var(--component-spinner-label-letter-spacing);\n}\n"
