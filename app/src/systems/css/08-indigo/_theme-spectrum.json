"/* @interop Spectrum 기반 Indigo 테마 */\n:root {\n  --spectrum-accent-background-color-default             : var(--semantic-bg-brand-default);\n  --spectrum-accent-background-color-hover               : var(--semantic-bg-brand-strong);\n  --spectrum-accent-background-color-down                : var(--base-color-brand-11);\n  --spectrum-accent-background-color-key-focus           : var(--semantic-bg-brand-strong);\n  --spectrum-accent-content-color-default                : var(--semantic-fg-brand-default);\n  --spectrum-accent-content-color-hover                  : var(--semantic-fg-brand-strong);\n  --spectrum-accent-content-color-down                   : var(--semantic-fg-brand-strong);\n  --spectrum-accent-content-color-key-focus              : var(--semantic-fg-brand-default);\n  --spectrum-accent-content-color-selected               : var(--semantic-fg-brand-strong);\n  --spectrum-accent-subtle-background-color-default      : var(--semantic-bg-brand-subtle);\n  --spectrum-accent-visual-color                         : var(--semantic-bg-brand-default);\n  --spectrum-negative-background-color-default           : var(--semantic-bg-danger-default);\n  --spectrum-negative-background-color-hover             : var(--semantic-bg-danger-strong);\n  --spectrum-negative-background-color-down              : var(--base-color-danger-11);\n  --spectrum-negative-background-color-key-focus         : var(--semantic-bg-danger-strong);\n  --spectrum-negative-content-color-default              : var(--semantic-fg-danger-default);\n  --spectrum-negative-content-color-hover                : var(--semantic-fg-danger-strong);\n  --spectrum-negative-content-color-down                 : var(--semantic-fg-danger-strong);\n  --spectrum-negative-content-color-key-focus            : var(--semantic-fg-danger-default);\n  --spectrum-negative-subdued-background-color-default   : var(--semantic-bg-danger-subtle);\n  --spectrum-negative-subdued-background-color-hover     : var(--semantic-bg-danger-subtlest);\n  --spectrum-negative-subdued-background-color-down      : var(--semantic-bg-danger-subtlest);\n  --spectrum-negative-subdued-background-color-key-focus : var(--semantic-bg-danger-subtle);\n  --spectrum-negative-border-color-default               : var(--semantic-border-danger-default);\n  --spectrum-negative-border-color-hover                 : var(--semantic-border-danger-strong);\n  --spectrum-negative-border-color-down                  : var(--semantic-border-danger-strong);\n  --spectrum-negative-border-color-key-focus             : var(--semantic-border-danger-strong);\n  --spectrum-negative-border-color-focus                 : var(--semantic-border-focus-default);\n  --spectrum-negative-border-color-focus-hover           : var(--semantic-border-focus-default);\n  --spectrum-negative-subtle-background-color-default    : var(--semantic-bg-danger-subtle);\n  --spectrum-negative-visual-color                       : var(--semantic-bg-danger-default);\n  --spectrum-positive-background-color-default           : var(--semantic-bg-success-default);\n  --spectrum-positive-background-color-hover             : var(--semantic-bg-success-strong);\n  --spectrum-positive-background-color-down              : var(--base-color-success-11);\n  --spectrum-positive-background-color-key-focus         : var(--semantic-bg-success-strong);\n  --spectrum-positive-subtle-background-color-default    : var(--semantic-bg-success-subtle);\n  --spectrum-positive-visual-color                       : var(--semantic-bg-success-default);\n  --spectrum-notice-background-color-default             : var(--semantic-bg-warning-default);\n  --spectrum-notice-subtle-background-color-default      : var(--semantic-bg-warning-subtle);\n  --spectrum-notice-visual-color                         : var(--semantic-bg-warning-default);\n  --spectrum-neutral-background-color-default            : var(--semantic-bg-neutral-default);\n  --spectrum-neutral-background-color-hover              : var(--semantic-bg-neutral-strong);\n  --spectrum-neutral-background-color-down               : var(--base-color-neutral-11);\n  --spectrum-neutral-background-color-key-focus          : var(--semantic-bg-neutral-strong);\n  --spectrum-neutral-content-color-default               : var(--semantic-fg-neutral-default);\n  --spectrum-neutral-content-color-key-focus             : var(--semantic-fg-neutral-default);\n  --spectrum-neutral-subdued-background-color-default    : var(--semantic-bg-neutral-subtle);\n  --spectrum-neutral-subdued-background-color-hover      : var(--semantic-bg-neutral-subtlest);\n  --spectrum-neutral-subdued-background-color-down       : var(--semantic-bg-neutral-subtlest);\n  --spectrum-neutral-subdued-background-color-key-focus  : var(--semantic-bg-neutral-subtle);\n  --spectrum-neutral-background-color-selected-default   : var(--semantic-bg-neutral-strong);\n  --spectrum-neutral-background-color-selected-hover     : var(--base-color-neutral-11);\n  --spectrum-neutral-background-color-selected-down      : var(--base-color-neutral-11);\n  --spectrum-neutral-background-color-selected-key-focus : var(--semantic-bg-neutral-strong);\n  --spectrum-neutral-content-color-focus                 : var(--semantic-fg-neutral-default);\n  --spectrum-neutral-subdued-content-color-default       : var(--semantic-fg-neutral-default);\n  --spectrum-neutral-subdued-content-color-key-focus     : var(--semantic-fg-neutral-default);\n  --spectrum-neutral-subtle-background-color-default     : var(--semantic-bg-neutral-subtle);\n  --spectrum-neutral-visual-color                        : var(--semantic-bg-neutral-default);\n  --spectrum-background-base-color                       : var(--semantic-bg-neutral-subtlest);\n  --spectrum-background-layer-1-color                    : var(--semantic-bg-neutral-surface);\n  --spectrum-background-layer-2-color                    : var(--semantic-bg-neutral-subtle);\n  --spectrum-background-elevated-color                   : var(--semantic-bg-neutral-surface);\n  --spectrum-background-pasteboard-color                 : var(--semantic-bg-neutral-subtle);\n  --spectrum-body-color                                  : var(--semantic-fg-neutral-default);\n  --spectrum-heading-color                               : var(--semantic-fg-neutral-default);\n  --spectrum-detail-color                                : var(--semantic-fg-neutral-subtle);\n  --spectrum-code-color                                  : var(--semantic-fg-neutral-default);\n  --spectrum-disabled-content-color                      : var(--semantic-fg-neutral-subtlest);\n  --spectrum-disabled-background-color                   : var(--semantic-bg-neutral-subtle);\n  --spectrum-disabled-border-color                       : var(--semantic-border-neutral-subtle);\n  --spectrum-global-font-family-base                     : var(--base-font-family-sans);\n  --spectrum-alias-body-text-font-family                 : var(--base-font-family-sans);\n  --spectrum-alias-article-text-font-family              : var(--base-font-family-sans);\n  --spectrum-global-font-family-code                     : var(--base-font-family-mono);\n  --spectrum-alias-code-text-font-family                 : var(--base-font-family-mono);\n  --spectrum-global-font-size-75                         : var(--semantic-text-caption);\n  --spectrum-global-font-size-100                        : var(--semantic-text-body-sm);\n  --spectrum-global-font-size-200                        : var(--semantic-text-body);\n  --spectrum-global-font-size-300                        : var(--semantic-text-body-lg);\n  --spectrum-global-font-size-400                        : var(--semantic-text-heading-sm);\n  --spectrum-global-font-size-500                        : var(--semantic-text-heading);\n  --spectrum-global-font-size-600                        : var(--semantic-text-heading-lg);\n  --spectrum-global-font-size-700                        : var(--semantic-text-display);\n  --spectrum-global-font-line-height-small               : var(--semantic-line-height-snug);\n  --spectrum-global-font-line-height-medium              : var(--semantic-line-height-normal);\n  --spectrum-global-font-line-height-large               : var(--semantic-line-height-relaxed);\n}\n\n/* 모서리, 여백은 공급자 루트 기준. radius 5단계 조정 시 하위 컴포넌트에 자동 적용 */\nhtml [class*=\"_spectrum--\"] {\n  --spectrum-alias-border-radius-xsmall  : calc(var(--semantic-radius-selection) / 2);\n  --spectrum-alias-border-radius-small   : var(--semantic-radius-selection);\n  --spectrum-alias-border-radius-regular : var(--semantic-radius-control);\n  --spectrum-alias-border-radius-medium  : var(--semantic-radius-container);\n  --spectrum-alias-border-radius-large   : var(--semantic-radius-overlay);\n  --spectrum-global-dimension-size-0     : 0px;\n  --spectrum-global-dimension-size-10    : 1px;\n  --spectrum-global-dimension-size-25    : 2px;\n  --spectrum-global-dimension-size-40    : 3px;\n  --spectrum-global-dimension-size-50    : 4px;\n  --spectrum-global-dimension-size-65    : 5px;\n  --spectrum-global-dimension-size-75    : 6px;\n  --spectrum-global-dimension-size-85    : 7px;\n  --spectrum-global-dimension-size-100   : 8px;\n  --spectrum-global-dimension-size-115   : 9px;\n  --spectrum-global-dimension-size-125   : 10px;\n  --spectrum-global-dimension-size-130   : 11px;\n  --spectrum-global-dimension-size-150   : 12px;\n  --spectrum-global-dimension-size-160   : 13px;\n  --spectrum-global-dimension-size-175   : 14px;\n  --spectrum-global-dimension-size-200   : 16px;\n  --spectrum-global-dimension-size-225   : 18px;\n  --spectrum-global-dimension-size-250   : 20px;\n  --spectrum-global-dimension-size-275   : 22px;\n  --spectrum-global-dimension-size-300   : 24px;\n  --spectrum-global-dimension-size-325   : 26px;\n  --spectrum-global-dimension-size-350   : 28px;\n  --spectrum-global-dimension-size-400   : 32px;\n  --spectrum-global-dimension-size-450   : 36px;\n  --spectrum-global-dimension-size-500   : 40px;\n  --spectrum-global-dimension-size-550   : 44px;\n  --spectrum-global-dimension-size-600   : 48px;\n  --spectrum-global-dimension-size-675   : 54px;\n  --spectrum-global-dimension-size-700   : 56px;\n  --spectrum-global-dimension-size-800   : 64px;\n  --spectrum-global-dimension-size-900   : 72px;\n  --spectrum-global-dimension-size-1000  : 80px;\n  --spectrum-global-dimension-size-1200  : 96px;\n  --spectrum-global-dimension-size-1250  : 100px;\n  --spectrum-global-dimension-size-1600  : 128px;\n  --spectrum-global-dimension-size-1700  : 136px;\n  --spectrum-global-dimension-size-2000  : 160px;\n  --spectrum-global-dimension-size-2400  : 192px;\n  --spectrum-global-dimension-size-3000  : 240px;\n  --spectrum-global-dimension-size-3400  : 272px;\n  --spectrum-global-dimension-size-3600  : 288px;\n  --spectrum-global-dimension-size-4600  : 368px;\n  --spectrum-global-dimension-size-5000  : 400px;\n  --spectrum-global-dimension-size-6000  : 480px;\n}\n\n\n/* html 접두사로 특이도를 올려 폰트 토큰 적용. 라이브러리가 스택을 리터럴로 고정해 안 먹히기 때문임 */\nhtml [class*=\"i18nFontFamily\"],\nhtml [class*=\"i18nFontFamily\"] *:not(code):not(pre):not(kbd):not(samp):not(code *):not(pre *) {\n  font-family: var(--base-font-family-sans);\n}\nhtml [class*=\"i18nFontFamily\"] code,\nhtml [class*=\"i18nFontFamily\"] pre,\nhtml [class*=\"i18nFontFamily\"] kbd,\nhtml [class*=\"i18nFontFamily\"] samp {\n  font-family: var(--base-font-family-mono);\n}\n\n"
